    from gi.repository import PangoCairo

    PANGOCAIRO_OK = True
except Exception as error:  # pragma: no cover
    log(f"PangoCairo import failed, stickers will have no speech bubble: {error}")
    PANGOCAIRO_OK = False


def hex_to_rgb(value: str) -> tuple[float, float, float]:
    value = value.lstrip("#")
    return tuple(int(value[i : i + 2], 16) / 255.0 for i in (0, 2, 4))  # type: ignore[return-value]


def classify(status: str) -> str:
    """Map a Polish status string to a state kind used for colour and animation."""
    return classify_status_text(status)


class StatusDot(Gtk.DrawingArea):
    """A glowing status dot. Falls back to a flat disc when cairo is missing."""

    def __init__(self) -> None:
        super().__init__()
        self.set_size_request(14, 20)
        self.rgb = hex_to_rgb(STATE_COLORS["neutral"])
        self.waiting = False
        self.phase = 0.0
        if CAIRO_OK:
            self.connect("draw", self.on_draw)

    def configure_dot(self, color: str, waiting: bool) -> None:
        self.rgb = hex_to_rgb(color)
        self.waiting = waiting
        self.queue_draw()

    def on_draw(self, _area: Gtk.DrawingArea, cr: "cairo.Context") -> bool:
        width = self.get_allocated_width()
        height = self.get_allocated_height()
        cx, cy = width / 2.0, height / 2.0
        r, g, b = self.rgb
        if self.waiting:
            radius = 3.4 + self.phase * 7.0
            cr.set_source_rgba(r, g, b, max(0.0, (1.0 - self.phase) * 0.55))
            cr.set_line_width(1.6)
            cr.arc(cx, cy, radius, 0, 2 * math.pi)
            cr.stroke()
        else:
            glow = cairo.RadialGradient(cx, cy, 1.0, cx, cy, 8.5)
            glow.add_color_stop_rgba(0.0, r, g, b, 0.42)
            glow.add_color_stop_rgba(1.0, r, g, b, 0.0)
            cr.set_source(glow)
            cr.arc(cx, cy, 8.5, 0, 2 * math.pi)
            cr.fill()
        cr.set_source_rgb(r, g, b)
        cr.arc(cx, cy, 3.4, 0, 2 * math.pi)
        cr.fill()
        return False


class LogoMark(Gtk.DrawingArea):
    """The AI Status Monitor radar logo, drawn in a 0-100 viewBox scaled to any size.

    Variants: 'full' (teal rings + rotating sweep wedge + colored blips + core) used in the
    horizontal lockup, and 'mono' (single-colour rings + wedge + core) used in the header.
    Optional rounded tile background and rotating sweep.
    """

    BLIPS = (((65, 32), "#4ADE80"), ((22, 70), "#FBBF24"), ((59, 58), "#FF8A65"))

    def __init__(self, size: int, variant: str = "full", sweep: bool = False,
                 tile: bool = False, mono_color: str = "#E6EDF3") -> None:
        super().__init__()
        self.set_size_request(size, size)
        self.variant = variant
        self.sweep = sweep
        self.tile = tile
        self.mono_rgb = hex_to_rgb(mono_color)
        self.angle = 0.0
        if CAIRO_OK:
            self.connect("draw", self.on_draw)

    def on_draw(self, _area: Gtk.DrawingArea, cr: "cairo.Context") -> bool:
        size = min(self.get_allocated_width(), self.get_allocated_height())
        if size <= 0:
            return False
        cr.translate((self.get_allocated_width() - size) / 2.0,
                     (self.get_allocated_height() - size) / 2.0)
        cr.scale(size / 100.0, size / 100.0)
        if self.tile:
            self._draw_tile(cr)
        if self.variant == "mono":
            self._draw_mono(cr)
        else:
            self._draw_full(cr)
        return False

    def _rounded_rect(self, cr: "cairo.Context", x: float, y: float, w: float, h: float, r: float) -> None:
        cr.new_sub_path()
        cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
        cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
        cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
        cr.arc(x + r, y + r, r, math.pi, 1.5 * math.pi)
        cr.close_path()

    def _draw_tile(self, cr: "cairo.Context") -> None:
        self._rounded_rect(cr, 1, 1, 98, 98, 22)
        grad = cairo.LinearGradient(0, 0, 100, 100)
        grad.add_color_stop_rgb(0.0, *hex_to_rgb("#17242f"))
        grad.add_color_stop_rgb(1.0, *hex_to_rgb("#0b121a"))
        cr.set_source(grad)
        cr.fill_preserve()
        cr.set_source_rgba(1, 1, 1, 0.08)
        cr.set_line_width(1.0)
        cr.stroke()

    def _draw_full(self, cr: "cairo.Context") -> None:
        teal = hex_to_rgb("#2DD4BF")
        core = hex_to_rgb("#5EEAD4")
        cr.set_line_width(1.2)
        for radius, alpha in ((34, 0.20), (23, 0.24), (12, 0.32)):
            cr.set_source_rgba(*teal, alpha)
            cr.arc(50, 50, radius, 0, 2 * math.pi)
            cr.stroke()
        cr.save()
        cr.translate(50, 50)
        cr.rotate(self.angle)
        cr.set_source_rgba(*teal, 0.32)
        cr.move_to(0, 0)
        cr.arc(0, 0, 34, -math.pi / 2, math.radians(-50))
        cr.close_path()
        cr.fill()
        cr.set_source_rgba(*core, 0.85)
        cr.set_line_width(1.4)
        cr.move_to(0, 0)
        cr.line_to(0, -34)
        cr.stroke()
        cr.restore()
        for (bx, by), color in self.BLIPS:
            cr.set_source_rgba(*hex_to_rgb(color), 0.22)
            cr.arc(bx, by, 5.2, 0, 2 * math.pi)
            cr.fill()
            cr.set_source_rgb(*hex_to_rgb(color))
            cr.arc(bx, by, 2.6, 0, 2 * math.pi)
            cr.fill()
        cr.set_source_rgba(*core, 0.25)
        cr.arc(50, 50, 6, 0, 2 * math.pi)
        cr.fill()
        cr.set_source_rgb(*core)
        cr.arc(50, 50, 3.4, 0, 2 * math.pi)
        cr.fill()

    def _draw_mono(self, cr: "cairo.Context") -> None:
        r, g, b = self.mono_rgb
        cr.set_line_width(3.0)
        cr.set_source_rgba(r, g, b, 0.35)
        cr.arc(50, 50, 34, 0, 2 * math.pi)
        cr.stroke()
        cr.set_source_rgba(r, g, b, 0.55)
        cr.arc(50, 50, 20, 0, 2 * math.pi)
        cr.stroke()
        cr.set_source_rgba(r, g, b, 0.5)
        cr.move_to(50, 50)
        cr.arc(50, 50, 38, -math.pi / 2, math.radians(-45))
        cr.close_path()
        cr.fill()
        cr.set_source_rgb(r, g, b)
        cr.arc(50, 50, 6, 0, 2 * math.pi)
        cr.fill()


class RotatingProviderLogo(Gtk.DrawingArea):
    """Draw a provider pixbuf around its center at a mutable angle."""

    def __init__(self, pixbuf: GdkPixbuf.Pixbuf, size: int = 30) -> None:
        super().__init__()
        self.pixbuf = pixbuf
        self.angle = 0.0
        self.set_size_request(size, size)
        self.connect("draw", self.on_draw)

    def on_draw(self, _area: Gtk.DrawingArea, cr: "cairo.Context") -> bool:
        width = self.get_allocated_width()
        height = self.get_allocated_height()
        cr.save()
        cr.translate(width / 2.0, height / 2.0)
        cr.rotate(self.angle)
        Gdk.cairo_set_source_pixbuf(
            cr,
            self.pixbuf,
            -self.pixbuf.get_width() / 2.0,
            -self.pixbuf.get_height() / 2.0,
        )
        cr.paint()
        cr.restore()
        return False


# ---- GIF sticker geometry (design spec "C · Naklejka wyskakuje", card-relative) ----
STICKER_WIDTH = 150
STICKER_HEIGHT = 104
STICKER_PADDING = 5
STICKER_ROTATION_DEG = 6.0
STICKER_OFFSET_RIGHT = -18   # sticker's right edge sits 18 px outside the card's right edge
STICKER_OFFSET_TOP = -78     # and 78 px above the card's top edge
BUBBLE_MAX_WIDTH = 150
BUBBLE_GAP = 8
# The overlay window leaves room for the bubble on the left and the tuck-away slide below.
OVERLAY_LEFT_ROOM = 190
OVERLAY_TOP_ROOM = 22
OVERLAY_BOTTOM_ROOM = 56
OVERLAY_RIGHT_ROOM = 22
POP_IN_MS = 260
BUBBLE_DELAY_MS = 80
TUCK_AWAY_MS = 200
STICKER_HOLD_MS = 4000
STICKER_DEBOUNCE_MS = 500
STICKER_FRAME_MS = 16


def ease_out_back(progress: float) -> float:
    """Close match for the spec's cubic-bezier(.34, 1.56, .64, 1) overshoot."""
    c1 = 1.70158
    c3 = c1 + 1
    t = max(0.0, min(1.0, progress)) - 1
    return 1 + c3 * t * t * t + c1 * t * t


def rounded_rect(cr: "cairo.Context", x: float, y: float, w: float, h: float, radii: tuple[float, float, float, float]) -> None:
    """Rounded rectangle path; radii are (top-left, top-right, bottom-right, bottom-left)."""
    tl, tr, br, bl = radii
    cr.new_sub_path()
    cr.arc(x + w - tr, y + tr, tr, -math.pi / 2, 0)
    cr.arc(x + w - br, y + h - br, br, 0, math.pi / 2)
    cr.arc(x + bl, y + h - bl, bl, math.pi / 2, math.pi)
    cr.arc(x + tl, y + tl, tl, math.pi, 3 * math.pi / 2)
    cr.close_path()


class StickerOverlay(Gtk.Window):
    """Transparent, click-through popup that shows a tilted GIF sticker plus a speech bubble.

    It lives in its own window so the widget card never changes size or shifts. Only GTK's
    built-in GdkPixbuf GIF animation is used; nothing here touches the network.
    """

    WIDTH = OVERLAY_LEFT_ROOM + STICKER_WIDTH + OVERLAY_RIGHT_ROOM
    HEIGHT = OVERLAY_TOP_ROOM + STICKER_HEIGHT + OVERLAY_BOTTOM_ROOM

    def __init__(self) -> None:
        super().__init__(type=Gtk.WindowType.POPUP)
        self.set_name("stickerOverlay")
        self.set_app_paintable(True)
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_accept_focus(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_default_size(self.WIDTH, self.HEIGHT)
        self.set_size_request(self.WIDTH, self.HEIGHT)
        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        self.transparent = visual is not None and screen.is_composited()
        if visual is not None:
            self.set_visual(visual)
        self.area = Gtk.DrawingArea()
        self.area.connect("draw", self.on_draw)
        self.add(self.area)
        if CAIRO_OK:
            # Click-through: an empty input shape lets the pointer and clicks reach the widget
            # below. Set through GTK (not GdkWindow) so GtkWindow does not reset it on resize.
            self.input_shape_combine_region(cairo.Region())
            self.area.input_shape_combine_region(cairo.Region())

        self.choice: stickers.StickerChoice | None = None
        self.color = "#8B93A1"
        self.pixbuf: GdkPixbuf.Pixbuf | None = None
        self.animation_iter: GdkPixbuf.PixbufAnimationIter | None = None
        self.phase = "hidden"  # hidden → in → shown → out → hidden
        self.phase_started = 0
        self.sticky = False
        self.reduced_motion = False
        self.tick_source: int | None = None
        self.frame_source: int | None = None
        self.hold_source: int | None = None

    @property
    def visible(self) -> bool:
        return self.phase != "hidden"

    def place_for_card(self, card_right: int, card_top: int) -> None:
        sticker_left = card_right - STICKER_OFFSET_RIGHT - STICKER_WIDTH
        sticker_top = card_top + STICKER_OFFSET_TOP
        self.move(sticker_left - OVERLAY_LEFT_ROOM, sticker_top - OVERLAY_TOP_ROOM)

    def load_image(self, choice: stickers.StickerChoice) -> None:
        """Load a local file, or KLIPY media straight from memory (it is never written to disk)."""
        self.stop_source("frame_source")
        self.pixbuf = None
        self.animation_iter = None
        if choice.image is None and choice.data is None:
            return
        try:
            if choice.data is not None:
                loader = GdkPixbuf.PixbufLoader()
                loader.write(choice.data)
                loader.close()
                animation = loader.get_animation()
            else:
                animation = GdkPixbuf.PixbufAnimation.new_from_file(str(choice.image))
        except Exception as error:
            log(f"sticker: cannot load {choice.label}: {error}")
            return
        if animation is None:
            return
        if animation.is_static_image():
            self.pixbuf = animation.get_static_image()
            log(f"sticker: {choice.label} is a still image (no animation frames)")
            return
        self.animation_iter = animation.get_iter(None)
        self.pixbuf = self.animation_iter.get_pixbuf()
        self.schedule_frame()

    def schedule_frame(self) -> None:
        if self.animation_iter is None:
            return
        delay = self.animation_iter.get_delay_time()
        if delay < 0:
            return  # last frame of a non-looping GIF
        self.frame_source = GLib.timeout_add(max(20, delay), self.on_frame)

    def on_frame(self) -> bool:
        self.frame_source = None
        if self.animation_iter is None or not self.visible:
            return False
        self.animation_iter.advance(None)
        self.pixbuf = self.animation_iter.get_pixbuf()
        self.area.queue_draw()
        self.schedule_frame()
        return False

    def stop_source(self, name: str) -> None:
        source = getattr(self, name)
        if source is not None:
            GLib.source_remove(source)
            setattr(self, name, None)

    def present_sticker(self, choice: stickers.StickerChoice, sticky: bool, hold_ms: int | None = STICKER_HOLD_MS) -> None:
        """Pop a sticker in. `hold_ms=None` keeps it until `tuck()` (hover, sticky states)."""
        settings = Gtk.Settings.get_default()
        self.reduced_motion = settings is not None and not settings.get_property("gtk-enable-animations")
        self.stop_source("hold_source")
        self.choice = choice
        self.color = stickers.STICKER_COLORS.get(choice.key, "#8B93A1")
        self.sticky = sticky
        self.load_image(choice)
        self.phase = "in"
        self.phase_started = GLib.get_monotonic_time()
        self.show_all()
        self.area.queue_draw()
        self.start_tick()
        if not sticky and hold_ms is not None:
            self.hold_source = GLib.timeout_add(hold_ms, self.on_hold_done)

    def set_key(self, key: str) -> None:
        """Recolour the bubble for a new status without changing the GIF."""
        color = stickers.STICKER_COLORS.get(key, self.color)
        if self.choice is not None and color != self.color:
            self.color = color
            self.choice = dataclasses.replace(self.choice, key=key)
            self.area.queue_draw()

    def set_bubble(self, text: str) -> None:
        """Swap the speech-bubble text in place (no pop animation, same GIF)."""
        if self.choice is not None and text and text != self.choice.bubble:
            self.choice = dataclasses.replace(self.choice, bubble=text)
            self.area.queue_draw()

    def on_hold_done(self) -> bool:
        self.hold_source = None
        self.tuck()
        return False

    def tuck(self) -> None:
        if self.phase in ("hidden", "out"):
            return
        self.stop_source("hold_source")
        self.phase = "out"
        self.phase_started = GLib.get_monotonic_time()
        self.start_tick()

    def hide_now(self) -> None:
        for name in ("hold_source", "tick_source", "frame_source"):
            self.stop_source(name)
        self.phase = "hidden"
        self.choice = None
        self.pixbuf = None
        self.animation_iter = None
        self.hide()

    def start_tick(self) -> None:
        if self.tick_source is None:
            self.tick_source = GLib.timeout_add(STICKER_FRAME_MS, self.on_tick)

    def elapsed_ms(self) -> float:
        return (GLib.get_monotonic_time() - self.phase_started) / 1000.0

    def on_tick(self) -> bool:
        elapsed = self.elapsed_ms()
        if self.phase == "in" and elapsed >= POP_IN_MS + BUBBLE_DELAY_MS:
            self.phase = "shown"
        elif self.phase == "out" and elapsed >= TUCK_AWAY_MS:
            self.tick_source = None
            self.hide_now()
            return False
        self.area.queue_draw()
        if self.phase == "shown":
            self.tick_source = None
            return False
        return True

    def transform(self, delay_ms: float = 0.0) -> tuple[float, float, float, float]:
        """(scale, rotation factor 0..1, opacity, y offset) for the current animation phase."""
        elapsed = self.elapsed_ms()
        if self.phase == "in":
            progress = max(0.0, elapsed - delay_ms) / POP_IN_MS
            if self.reduced_motion:
                return 1.0, 1.0, min(1.0, progress), 0.0
            eased = ease_out_back(progress)
            return 0.6 + 0.4 * eased, eased, max(0.0, min(1.0, progress * 1.4)), 0.0
        if self.phase == "out":
            progress = min(1.0, elapsed / TUCK_AWAY_MS)
            if self.reduced_motion:
                return 1.0, 1.0, 1.0 - progress, 0.0
            eased = progress * progress
            return 1.0 - 0.1 * eased, 1.0, 1.0 - eased, 40.0 * eased
        return 1.0, 1.0, 1.0, 0.0

    def on_draw(self, _area: Gtk.Widget, cr: "cairo.Context") -> bool:
        if not CAIRO_OK:
            return False
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        if self.choice is None or not self.visible:
            return False
        self.draw_sticker(cr)
        if self.choice.bubble and PANGOCAIRO_OK:
            self.draw_bubble(cr)
        return False

    def draw_sticker(self, cr: "cairo.Context") -> None:
        scale, turn, opacity, dy = self.transform()
        if opacity <= 0:
            return
        cx = OVERLAY_LEFT_ROOM + STICKER_WIDTH / 2
        cy = OVERLAY_TOP_ROOM + STICKER_HEIGHT / 2 + dy
        cr.save()
        cr.translate(cx, cy)
        cr.rotate(math.radians(STICKER_ROTATION_DEG * turn))
        cr.scale(scale, scale)
        cr.push_group()
        half_w, half_h = STICKER_WIDTH / 2, STICKER_HEIGHT / 2

        # Soft drop shadow: a few stacked translucent layers approximate a 24 px blur.
        for spread, alpha in ((10, 0.06), (6, 0.10), (3, 0.16), (0, 0.22)):
            rounded_rect(cr, -half_w - spread, -half_h + 10 - spread, STICKER_WIDTH + 2 * spread,
                         STICKER_HEIGHT + 2 * spread, (10 + spread,) * 4)
            cr.set_source_rgba(0, 0, 0, alpha)
            cr.fill()

        rounded_rect(cr, -half_w, -half_h, STICKER_WIDTH, STICKER_HEIGHT, (10, 10, 10, 10))
        cr.set_source_rgb(*hex_to_rgb("#F4F1EA"))
        cr.fill()

        inner_w = STICKER_WIDTH - 2 * STICKER_PADDING
        inner_h = STICKER_HEIGHT - 2 * STICKER_PADDING
        rounded_rect(cr, -inner_w / 2, -inner_h / 2, inner_w, inner_h, (6, 6, 6, 6))
        cr.clip()
        if self.pixbuf is not None:
            width, height = self.pixbuf.get_width(), self.pixbuf.get_height()
            cover = max(inner_w / width, inner_h / height)
            cr.save()
            cr.scale(cover, cover)
            Gdk.cairo_set_source_pixbuf(cr, self.pixbuf, -width / 2, -height / 2)
            cr.paint()
            cr.restore()
        else:
            self.draw_placeholder(cr, inner_w, inner_h)
        if self.choice is not None and self.choice.source == "klipy" and PANGOCAIRO_OK:
            self.draw_klipy_mark(cr, inner_w, inner_h)
        cr.pop_group_to_source()
        cr.paint_with_alpha(opacity)
        cr.restore()

    def draw_klipy_mark(self, cr: "cairo.Context", width: float, height: float) -> None:
        """Small "KLIPY" attribution mark in the image's bottom-right corner."""
        layout = PangoCairo.create_layout(cr)
        layout.set_font_description(Pango.FontDescription.from_string("IBM Plex Sans, Cantarell, sans-serif Bold 6"))
        layout.set_text("KLIPY", -1)
        text_w, text_h = layout.get_pixel_size()
        x = width / 2 - text_w - 8
        y = height / 2 - text_h - 5
        rounded_rect(cr, x - 4, y - 1, text_w + 8, text_h + 2, (4, 4, 4, 4))
        cr.set_source_rgba(0, 0, 0, 0.45)
        cr.fill()
        cr.move_to(x, y)
        cr.set_source_rgba(1, 1, 1, 0.9)
        PangoCairo.show_layout(cr, layout)

    def draw_placeholder(self, cr: "cairo.Context", width: float, height: float) -> None:
        """Diagonal stripes in the status colour (the spec's "no GIF in the pool" look)."""
        red, green, blue = hex_to_rgb(self.color)
        cr.set_source_rgb(red * 0.35, green * 0.35, blue * 0.35)
        cr.paint()
        cr.set_source_rgba(red, green, blue, 0.55)
        cr.set_line_width(8)
        for offset in range(-int(height) - int(width), int(width) + int(height), 22):
            cr.move_to(-width / 2 + offset, height / 2)
            cr.line_to(-width / 2 + offset + height, -height / 2)
        cr.stroke()

    def draw_bubble(self, cr: "cairo.Context") -> None:
        scale, turn, opacity, dy = self.transform(delay_ms=BUBBLE_DELAY_MS if self.phase == "in" else 0.0)
        if opacity <= 0 or self.choice is None:
            return
        layout = PangoCairo.create_layout(cr)
        layout.set_font_description(Pango.FontDescription.from_string("JetBrains Mono, IBM Plex Mono, monospace Semi-Bold 9"))
        layout.set_width((BUBBLE_MAX_WIDTH - 20) * Pango.SCALE)
        layout.set_wrap(Pango.WrapMode.WORD_CHAR)
        layout.set_text(self.choice.bubble, -1)
        text_w, text_h = layout.get_pixel_size()
        bubble_w, bubble_h = text_w + 20, text_h + 12
        right = OVERLAY_LEFT_ROOM - BUBBLE_GAP
        top = OVERLAY_TOP_ROOM + 14 + dy
        cr.save()
        cr.translate(right - bubble_w / 2, top + bubble_h / 2)
        cr.rotate(math.radians(-3.0 * turn))
        cr.scale(scale, scale)
        cr.push_group()
        rounded_rect(cr, -bubble_w / 2, -bubble_h / 2 + 3, bubble_w, bubble_h, (12, 12, 2, 12))
        cr.set_source_rgba(0, 0, 0, 0.30)
        cr.fill()
        rounded_rect(cr, -bubble_w / 2, -bubble_h / 2, bubble_w, bubble_h, (12, 12, 2, 12))
        cr.set_source_rgb(*hex_to_rgb(self.color))
        cr.fill()
        cr.move_to(-text_w / 2, -text_h / 2)
        cr.set_source_rgb(*hex_to_rgb("#0E1218"))
        PangoCairo.show_layout(cr, layout)
        cr.pop_group_to_source()
        cr.paint_with_alpha(opacity)
        cr.restore()


# Docked session windows stack under the widget with this much room between cards, so each
# card's sticker (which sticks out 78 px above its card) does not cover the card above.
SESSION_CARD_GAP = 88
SESSION_CARD_TITLE = "AI agent session"
# A new task is shown in the bubble this long, then a funny line takes over.
ACTIVITY_BUBBLE_SECONDS = 5
# A session window swaps its GIF for a new topic (edit → tests → git push…) at most this often.
SESSION_GIF_MIN_SECONDS = 15


class SessionCard(Gtk.Window):
    """A separate, draggable window for one agent session (run), with its own GIF sticker.

    Docked cards stack under the main widget and follow it; dragging a card makes it
    floating, and its position is remembered per session. The sticker stays up while the
    session works or waits and tucks away when it is done or idle.
    """

    def __init__(self, owner: "StatusWidget", session_id: str) -> None:
        super().__init__(title=SESSION_CARD_TITLE)
        self.owner = owner
        self.session_id = session_id
        self.set_name("window")
        self.set_app_paintable(True)
        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual is not None and screen.is_composited():
            self.set_visual(visual)
        self.set_resizable(False)
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_accept_focus(False)
        self.stick()
        self.set_type_hint(Gdk.WindowTypeHint.UTILITY)

        event_box = Gtk.EventBox()
        event_box.connect("button-press-event", self.on_button_press)
        self.add(event_box)
        self.card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.card.set_name("card")
        self.card.set_size_request(CARD_WIDTH, -1)
        for setter in (self.card.set_margin_top, self.card.set_margin_bottom,
                       self.card.set_margin_start, self.card.set_margin_end):
            setter(8)
        event_box.add(self.card)
        self.content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        for setter in (self.content.set_margin_top, self.content.set_margin_bottom,
                       self.content.set_margin_start, self.content.set_margin_end):
            setter(6)
        self.card.pack_start(self.content, True, True, 0)

        self.waiting_dots: list[StatusDot] = []
        self.dot_labels: list[Gtk.Label] = []
        self.signature: str | None = None
        self.session: dict[str, object] | None = None
        self.floating = False
        self.closed = False
        self.sticker_key: str | None = None
        self.sticker_topic: str | None = None
        self.last_pick_at = 0.0
        self.activity_signature = "null"
        self.activity_text: str | None = None
        self.activity_until = 0.0
        self.bubble_source: int | None = None
        self.sticker_request = 0
        self.sticker_debounce: int | None = None
        self.rotate_source: int | None = None
        self.save_source: int | None = None
        self.overlay = StickerOverlay() if CAIRO_OK else None
        self.connect("configure-event", self.on_configure)

    # ---- content ----
    def update(self, session: dict[str, object]) -> None:
        self.session = session
        signature = json.dumps(
            [session["name"], session["status"], session["project"], session["time"], session["kind"]],
            ensure_ascii=False,
        )
        if signature != self.signature:
            self.signature = signature
            for child in self.content.get_children():
                self.content.remove(child)
            self.waiting_dots = []
            self.dot_labels = []
            row = self.owner.build_row(session, self.waiting_dots, self.dot_labels)
            self.content.pack_start(row, False, False, 0)
            context = self.card.get_style_context()
            if session["kind"] == "waiting":
                context.add_class("waiting")
            else:
                context.remove_class("waiting")
                context.remove_class("waitingPulse")
            self.content.show_all()
            self.resize(1, 1)  # shrink-wrap to the new row
        self.update_sticker()

    def update_sticker(self) -> None:
        """Keep the sticker in step with the session.

        - The GIF follows the *topic* of what the agent is doing (editing → hackers typing,
          tests → fingers crossed…). It changes on a new topic at most every
          SESSION_GIF_MIN_SECONDS, so the per-tool coding ↔ analyzing flip-flop does not
          reshuffle GIFs; waiting/error switch at once.
        - The bubble shows a new task for ACTIVITY_BUBBLE_SECONDS, then a funny line.
        - Done/idle (or Serious mode) tucks the sticker away.
        """
        session = self.session
        key = stickers.sticker_for_kind(session["kind"]) if session is not None else None
        if self.owner.serious_mode or key in (None, "done", "idle"):
            self.clear_sticker()
            return
        activity = session.get("activity") if session is not None else None
        activity_signature = json.dumps([activity.get("type"), activity.get("target")]) if activity else "null"
        if activity_signature != self.activity_signature:
            self.activity_signature = activity_signature
            if activity:
                self.show_activity_bubble(activity)

        topic = stickers.sticker_topic(key, activity)
        previous_key = self.sticker_key
        now = time.monotonic()
        attention_change = previous_key != key and (key in stickers.STICKY_KEYS or previous_key in stickers.STICKY_KEYS)
        topic_change = topic != self.sticker_topic and now - self.last_pick_at >= SESSION_GIF_MIN_SECONDS
        self.sticker_key = key
        if self.overlay is not None and self.overlay.visible:
            self.overlay.set_key(key)  # bubble colour follows the live status
        if previous_key is None or attention_change or topic_change:
            self.sticker_topic = topic
            self.request_sticker(key)

    def show_activity_bubble(self, activity: dict[str, str]) -> None:
        """Say what the agent is doing for a few seconds, then go back to a funny line."""
        text = self.owner.sticker_source.activity_bubble(activity)
        if not text:
            return
        self.activity_text = text
        self.activity_until = time.monotonic() + ACTIVITY_BUBBLE_SECONDS
        if self.overlay is not None and self.overlay.visible:
            self.overlay.set_bubble(text)
        if self.bubble_source is not None:
            GLib.source_remove(self.bubble_source)
        self.bubble_source = GLib.timeout_add_seconds(ACTIVITY_BUBBLE_SECONDS, self.on_activity_bubble_done)

    def on_activity_bubble_done(self) -> bool:
        self.bubble_source = None
        self.activity_text = None
        if self.overlay is not None and self.overlay.visible and self.sticker_key is not None:
            self.overlay.set_bubble(self.owner.sticker_source.bubble(self.sticker_key))
        return False

    def current_bubble(self, fallback: str) -> str:
        if self.activity_text and time.monotonic() < self.activity_until:
            return self.activity_text
        return fallback

    def request_sticker(self, key: str) -> None:
        if self.overlay is None:
            return
        if self.sticker_debounce is not None:
            GLib.source_remove(self.sticker_debounce)
        self.sticker_request += 1
        self.last_pick_at = time.monotonic()
        request = self.sticker_request
        source = self.owner.sticker_source
        topic = self.sticker_topic or key

        def pick_in_background() -> bool:
            self.sticker_debounce = None

            def worker() -> None:
                try:
                    choice = source.pick(key, topic=topic)
                except Exception as error:  # never let a sticker take the widget down
                    log(f"sticker: pick failed: {error}")
                    choice = stickers.StickerChoice(key, None, "", "placeholder")
                GLib.idle_add(self.apply_sticker, request, choice)

            threading.Thread(target=worker, daemon=True).start()
            return False

        self.sticker_debounce = GLib.timeout_add(STICKER_DEBOUNCE_MS, pick_in_background)

    def apply_sticker(self, request: int, choice: stickers.StickerChoice) -> bool:
        if self.closed or self.overlay is None or request != self.sticker_request or self.owner.serious_mode:
            return False
        log(f"sticker: {self.session_id} {choice.key} [{self.sticker_topic}] from {choice.source}"
            + f" ({choice.label})")
        key = self.sticker_key or choice.key
        choice = dataclasses.replace(choice, key=key, bubble=self.current_bubble(choice.bubble))
        self.place_overlay()
        self.overlay.present_sticker(choice, sticky=True)
        self.schedule_rotation()
        return False

    def schedule_rotation(self) -> None:
        """While the session keeps working, swap to a fresh GIF every N seconds."""
        self.stop_rotation()
        seconds = self.owner.sticker_rotate_seconds
        if seconds > 0 and self.sticker_key is not None:
            self.rotate_source = GLib.timeout_add_seconds(seconds, self.on_rotate)

    def stop_rotation(self) -> None:
        if self.rotate_source is not None:
            GLib.source_remove(self.rotate_source)
            self.rotate_source = None

    def on_rotate(self) -> bool:
        self.rotate_source = None
        self.show_another_gif()
        return False

    def show_another_gif(self) -> None:
        if not self.closed and self.sticker_key is not None and not self.owner.serious_mode:
            self.request_sticker(self.sticker_key)

    def clear_sticker(self) -> None:
        self.stop_rotation()
        self.sticker_key = None
        self.sticker_topic = None
        self.sticker_request += 1
        if self.sticker_debounce is not None:
            GLib.source_remove(self.sticker_debounce)
            self.sticker_debounce = None
        if self.overlay is not None and self.overlay.visible:
            self.overlay.tuck()

    def refresh_sticker(self) -> None:
        """Re-pick after Serious mode was turned off or the GIF source changed."""
        self.sticker_key = None
        self.sticker_topic = None
        self.update_sticker()

    def place_overlay(self) -> None:
        if self.overlay is None:
            return
        x, y = self.get_position()
        width, _height = self.get_size()
        self.overlay.place_for_card(x + width - 8, y + 8)

    # ---- placement ----
    def dock_at(self, x: int, y: int) -> None:
        if self.floating:
            return
        if tuple(self.get_position()) != (x, y):
            self.move(x, y)

    def on_configure(self, _widget: Gtk.Widget, _event: Gdk.EventConfigure) -> bool:
        if self.overlay is not None and self.overlay.visible:
            self.place_overlay()
        if self.floating:
            # A drag fires many configure events; persist once it settles.
            if self.save_source is not None:
                GLib.source_remove(self.save_source)
            self.save_source = GLib.timeout_add(400, self.save_position)
        return False

    def save_position(self) -> bool:
        self.save_source = None
        if not self.closed and self.floating:
            x, y = self.get_position()
            self.owner.save_card_position(self.session_id, x, y)
        return False

    def on_button_press(self, _widget: Gtk.Widget, event: Gdk.EventButton) -> bool:
        if event.type == Gdk.EventType.BUTTON_PRESS and event.button == 1:
            self.floating = True
            self.begin_move_drag(event.button, int(event.x_root), int(event.y_root), event.time)
            return True
        if event.type == Gdk.EventType.BUTTON_PRESS and event.button == 3:
            menu = Gtk.Menu()
            another = Gtk.MenuItem(label="Show another GIF")
            another.set_sensitive(self.sticker_key is not None and not self.owner.serious_mode)
            another.connect("activate", lambda _item: self.show_another_gif())
            dock = Gtk.MenuItem(label="Dock under the widget")
            dock.set_sensitive(self.floating)
            dock.connect("activate", lambda _item: self.owner.dock_card(self.session_id))
            dock_all = Gtk.MenuItem(label="Dock all session windows")
            dock_all.connect("activate", lambda _item: self.owner.dock_all_cards())
            settings = Gtk.MenuItem(label="Settings…")
            settings.connect("activate", lambda _item: self.owner.open_settings())
            for item in (another, dock, dock_all, settings):
                menu.append(item)
            menu.show_all()
            menu.popup_at_pointer(event)
            return True
        return False

    def close(self) -> None:
        if self.closed:
            return
        self.closed = True
        for name in ("sticker_debounce", "save_source", "rotate_source", "bubble_source"):
            source = getattr(self, name)
            if source is not None:
                GLib.source_remove(source)
                setattr(self, name, None)
        if self.overlay is not None:
            self.overlay.hide_now()
            self.overlay.destroy()
        self.destroy()


# Timing settings shown in the Settings window: (env key, widget config key, label, hint).
TIMING_SETTINGS = (
    ("AI_STATUS_STALE_AFTER_SECONDS", "stale_after_seconds",
     "No new events after", "row turns grey"),
    ("AI_STATUS_HIDE_DONE_AFTER_SECONDS", "hide_done_after_seconds",
     "Hide finished after", "done rows disappear"),
    ("AI_STATUS_IDLE_AFTER_SECONDS", "idle_after_seconds",
     "Show as idle after", "silent session"),
    ("AI_STATUS_HIDE_STALE_AFTER_SECONDS", "hide_stale_after_seconds",
     "Hide inactive after", "silent row disappears"),
)
MAX_ROWS_LIMIT = 12
MAX_MINUTES = 24 * 60


class SettingsWindow(Gtk.Window):
    """Small instant-apply settings dialog; every change is saved to the runtime .env."""

    def __init__(self, owner: "StatusWidget") -> None:
        super().__init__(title="AI Status Monitor — Settings")
        self.owner = owner
        self.set_name("settingsWindow")
        self.set_transient_for(owner)
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self.set_position(Gtk.WindowPosition.CENTER_ON_PARENT)
        self.set_keep_above(True)
        self.set_resizable(False)
        self.set_border_width(0)
        self.agent_checks: dict[str, Gtk.CheckButton] = {}
        self.connect("key-press-event", self.on_key_press)
        self.connect("delete-event", lambda *_args: self.close_window() or True)
        # Native controls (switch, spin buttons, checkboxes) follow the widget's dark look.
        gtk_settings = Gtk.Settings.get_default()
        if gtk_settings is not None:
            gtk_settings.set_property("gtk-application-prefer-dark-theme", True)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        outer.set_name("settingsBody")
        self.add(outer)

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        header.set_name("settingsHeader")
        mark = LogoMark(17, variant="mono", mono_color="#E6EDF3")
        mark.set_valign(Gtk.Align.CENTER)
        header.pack_start(mark, False, False, 0)
        heading = Gtk.Label(label="Settings")
        heading.set_name("settingsHeading")
        heading.set_xalign(0)
        header.pack_start(heading, True, True, 0)
        outer.pack_start(header, False, False, 0)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        content.set_name("settingsContent")
        outer.pack_start(content, True, True, 0)

        # ---- agents ----
        content.pack_start(self.section_label("Agents"), False, False, 0)
        agents_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        for agent, label in (("claude", "Claude Code"), ("codex", "Codex")):
            check = Gtk.CheckButton()
            check.set_name("settingsCheck")
            inner = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            pixbuf = owner.logo_pixbufs.get(agent)
            if pixbuf is not None:
                inner.pack_start(Gtk.Image.new_from_pixbuf(pixbuf), False, False, 0)
            text = Gtk.Label()
            text.set_markup(owner.markup(label, AGENT_NAME_COLORS[agent]))
            text.set_name("settingsAgentName")
            inner.pack_start(text, False, False, 0)
            check.add(inner)
            check.set_active(agent in owner.agents)
            check.connect("toggled", self.on_agent_toggled)
            self.agent_checks[agent] = check
            agents_box.pack_start(check, False, False, 0)
        content.pack_start(agents_box, False, False, 0)
        content.pack_start(self.hint_label("Hidden agents get no rows, usage bars, sounds or usage requests."), False, False, 0)

        # ---- display ----
        content.pack_start(self.section_label("Display"), False, False, 0)
        grid = self.new_grid()
        self.sound_switch = Gtk.Switch()
        self.sound_switch.set_halign(Gtk.Align.END)
        self.sound_switch.set_valign(Gtk.Align.CENTER)
        self.sound_switch.set_active(owner.config.get("sound_enabled") is True)
        self.sound_switch.connect("notify::active", self.on_sound_changed)
        self.attach_row(grid, 0, "Notification sound", "on waiting and when done", self.sound_switch)

        self.rows_spin = Gtk.SpinButton.new_with_range(1, MAX_ROWS_LIMIT, 1)
        self.rows_spin.set_value(owner.max_rows)
        self.rows_spin.connect("value-changed", self.on_rows_changed)
        self.attach_row(grid, 1, "Visible rows", "sessions shown at once", self.rows_spin)

        self.windows_switch = Gtk.Switch()
        self.windows_switch.set_halign(Gtk.Align.END)
        self.windows_switch.set_active(owner.session_windows)
        self.windows_switch.connect("notify::active", self.on_windows_changed)
        self.attach_row(grid, 2, "Session windows", "each run in its own draggable window", self.windows_switch)
        content.pack_start(grid, False, False, 0)

        # ---- stickers ----
        content.pack_start(self.section_label("Stickers"), False, False, 0)
        grid = self.new_grid()
        self.serious_switch = Gtk.Switch()
        self.serious_switch.set_halign(Gtk.Align.END)
        self.serious_switch.set_active(owner.serious_mode)
        self.serious_switch.connect("notify::active", self.on_serious_changed)
        self.attach_row(grid, 0, "Serious mode", "no GIF stickers, good for meetings", self.serious_switch)

        self.klipy_entry = Gtk.Entry()
        self.klipy_entry.set_name("settingsEntry")
        self.klipy_entry.set_visibility(False)
        self.klipy_entry.set_width_chars(10)
        self.klipy_entry.set_placeholder_text("optional")
        self.klipy_entry.set_text(owner.klipy_api_key)
        self.klipy_entry.connect("changed", self.on_klipy_changed)
        self.klipy_save_source: int | None = None
        key_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        key_box.pack_start(self.klipy_entry, True, True, 0)
        guide_button = Gtk.Button(label="Get a free key…")
        guide_button.set_name("settingsClose")
        guide_button.connect("clicked", lambda _button: owner.open_klipy_guide(self))
        key_box.pack_start(guide_button, False, False, 0)
        self.attach_row(grid, 1, "KLIPY API key", "random GIFs · Powered by KLIPY", key_box)

        self.rotate_spin = Gtk.SpinButton.new_with_range(0, 30, 0.5)
        self.rotate_spin.set_digits(1)
        self.rotate_spin.set_value(owner.sticker_rotate_seconds / 60)
        self.rotate_spin.connect("value-changed", self.on_rotate_changed)
        self.attach_row(grid, 2, "New GIF every (min)", "while an agent works · 0 = never", self.rotate_spin)

        test = Gtk.Button(label="Show test sticker")
        test.set_name("settingsClose")
        test.connect("clicked", lambda _button: owner.show_test_sticker())
        self.attach_row(grid, 3, "Preview", "cycles through every status", test)
        content.pack_start(grid, False, False, 0)
        gifs_hint = self.hint_label(f"Local GIFs: {display_path(GIFS_DIR)}/<status>/")
        gifs_hint.set_line_wrap(True)
        gifs_hint.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
        gifs_hint.set_max_width_chars(48)
        content.pack_start(gifs_hint, False, False, 0)

        # ---- timing ----
        content.pack_start(self.section_label("Timing (minutes)"), False, False, 0)
        grid = self.new_grid()
        for index, (env_key, config_key, label, hint) in enumerate(TIMING_SETTINGS):
            spin = Gtk.SpinButton.new_with_range(0, MAX_MINUTES, 0.5)
            spin.set_digits(1)
            spin.set_value(owner.config_seconds(config_key) / 60)
            spin.connect("value-changed", self.on_timing_changed, env_key, config_key)
            self.attach_row(grid, index, label, hint, spin)
        content.pack_start(grid, False, False, 0)

        # ---- footer ----
        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        footer.set_name("settingsFooter")
        saved = self.hint_label(f"Saved automatically to {display_path(SETTINGS.env_file)}")
        saved.set_line_wrap(True)
        saved.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
        saved.set_max_width_chars(34)
        footer.pack_start(saved, True, True, 0)
        close = Gtk.Button(label="Close")
        close.set_name("settingsClose")
        close.set_valign(Gtk.Align.CENTER)
        close.connect("clicked", lambda _button: self.close_window())
        footer.pack_end(close, False, False, 0)
        outer.pack_start(footer, False, False, 0)

    @staticmethod
    def section_label(text: str) -> Gtk.Label:
        label = Gtk.Label(label=text.upper())
        label.set_name("settingsSection")
        label.set_xalign(0)
        return label

    @staticmethod
    def hint_label(text: str) -> Gtk.Label:
        label = Gtk.Label(label=text)
        label.set_name("settingsHint")
        label.set_xalign(0)
        return label

    @staticmethod
    def new_grid() -> Gtk.Grid:
        grid = Gtk.Grid()
        grid.set_row_spacing(8)
        grid.set_column_spacing(18)
        return grid

    def attach_row(self, grid: Gtk.Grid, row: int, title: str, hint: str, control: Gtk.Widget) -> None:
        labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        name = Gtk.Label(label=title)
        name.set_name("settingsLabel")
        name.set_xalign(0)
        labels.pack_start(name, False, False, 0)
        labels.pack_start(self.hint_label(hint), False, False, 0)
        labels.set_hexpand(True)
        grid.attach(labels, 0, row, 1, 1)
        control.set_valign(Gtk.Align.CENTER)
        grid.attach(control, 1, row, 1, 1)

    def close_window(self) -> None:
        if self.klipy_save_source is not None:
            GLib.source_remove(self.klipy_save_source)
            self.save_klipy_key()
        self.destroy()

    def on_key_press(self, _widget: Gtk.Widget, event: Gdk.EventKey) -> bool:
        if event.keyval == Gdk.KEY_Escape:
            self.close_window()
            return True
        return False

    def on_agent_toggled(self, check: Gtk.CheckButton) -> None:
        agents = tuple(agent for agent in SUPPORTED_AGENTS if self.agent_checks[agent].get_active())
        if not agents:
            # At least one agent must stay visible; undo the last uncheck.
            check.set_active(True)
            return
        self.owner.set_agents(agents)

    def on_sound_changed(self, switch: Gtk.Switch, _param: object) -> None:
        self.owner.update_setting("AI_STATUS_SOUND_ENABLED", "true" if switch.get_active() else "false")

    def on_serious_changed(self, switch: Gtk.Switch, _param: object) -> None:
        if switch.get_active() != self.owner.serious_mode:
            self.owner.set_serious_mode(switch.get_active())

    def on_rotate_changed(self, spin: Gtk.SpinButton) -> None:
        self.owner.update_setting("AI_STATUS_STICKER_ROTATE_SECONDS", str(round(spin.get_value() * 60)))

    def on_klipy_changed(self, _entry: Gtk.Entry) -> None:
        # Save once typing/pasting settles instead of on every keystroke.
        if self.klipy_save_source is not None:
            GLib.source_remove(self.klipy_save_source)
        self.klipy_save_source = GLib.timeout_add(700, self.save_klipy_key)

    def save_klipy_key(self) -> bool:
        self.klipy_save_source = None
        value = self.klipy_entry.get_text().strip()
        if value != self.owner.klipy_api_key:
            self.owner.update_setting("AI_STATUS_KLIPY_API_KEY", value)
        return False

    def on_windows_changed(self, switch: Gtk.Switch, _param: object) -> None:
        self.owner.update_setting("AI_STATUS_SESSION_WINDOWS", "true" if switch.get_active() else "false")

    def on_rows_changed(self, spin: Gtk.SpinButton) -> None:
        self.owner.update_setting("AI_STATUS_MAX_ROWS", str(spin.get_value_as_int()))

    def on_timing_changed(self, spin: Gtk.SpinButton, env_key: str, _config_key: str) -> None:
        self.owner.update_setting(env_key, str(round(spin.get_value() * 60)))


class KlipyKeyGuide(Gtk.Window):
    """Step-by-step "get a free KLIPY key" guide with copy buttons and a key test."""

    def __init__(self, owner: "StatusWidget", parent: Gtk.Window | None = None) -> None:
        super().__init__(title="Get a free KLIPY key")
        self.owner = owner
        self.set_name("settingsWindow")
        if parent is not None:
            self.set_transient_for(parent)
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self.set_position(Gtk.WindowPosition.CENTER_ON_PARENT)
        self.set_keep_above(True)
        self.set_resizable(False)
        self.connect("key-press-event", self.on_key_press)
        self.checking = False

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        outer.set_name("settingsBody")
        self.add(outer)

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        header.set_name("settingsHeader")
        mark = LogoMark(17, variant="mono", mono_color="#E6EDF3")
        mark.set_valign(Gtk.Align.CENTER)
        header.pack_start(mark, False, False, 0)
        heading = Gtk.Label(label="Get a free KLIPY key")
        heading.set_name("settingsHeading")
        heading.set_xalign(0)
        header.pack_start(heading, True, True, 0)
        outer.pack_start(header, False, False, 0)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        content.set_name("settingsContent")
        outer.pack_start(content, True, True, 0)
        intro = SettingsWindow.hint_label(
            "Stickers can show random GIFs from KLIPY. It takes about two minutes and is free; "
            "without a key the widget uses local GIFs only."
        )
        intro.set_line_wrap(True)
        intro.set_max_width_chars(52)
        content.pack_start(intro, False, False, 4)

        # 1. account
        content.pack_start(SettingsWindow.section_label("1 · Sign up"), False, False, 0)
        open_button = Gtk.Button(label="Open the KLIPY Partner Panel ↗")
        open_button.set_name("settingsClose")
        open_button.set_halign(Gtk.Align.START)
        open_button.connect("clicked", lambda _button: self.open_partner_panel())
        content.pack_start(open_button, False, False, 0)
        content.pack_start(self.hint(f"{stickers.KLIPY_PARTNER_URL} — sign up, it is free."), False, False, 0)

        # 2. platform details
        content.pack_start(SettingsWindow.section_label("2 · Add your platform"), False, False, 0)
        grid = SettingsWindow.new_grid()
        grid.set_row_spacing(6)
        for row, (label, value) in enumerate((
            ("Platform name", stickers.KLIPY_GUIDE_PLATFORM_NAME),
            ("Platform website", stickers.KLIPY_GUIDE_WEBSITE),
            ("About / integration", "a ready-made description"),
        )):
            text = stickers.KLIPY_GUIDE_DESCRIPTION if row == 2 else value
            self.attach_copy_row(grid, row, label, value, text)
        content.pack_start(grid, False, False, 0)
        content.pack_start(self.hint("Then tick the KLIPY API Terms checkbox (read them first) and press Add Platform."),
                           False, False, 0)

        # 3. key
        content.pack_start(SettingsWindow.section_label("3 · Create an API key"), False, False, 0)
        grid = SettingsWindow.new_grid()
        grid.set_row_spacing(6)
        self.attach_copy_row(grid, 0, "Key name", stickers.KLIPY_GUIDE_KEY_NAME, stickers.KLIPY_GUIDE_KEY_NAME)
        self.attach_copy_row(grid, 1, "URL", stickers.KLIPY_GUIDE_WEBSITE, stickers.KLIPY_GUIDE_WEBSITE)
        content.pack_start(grid, False, False, 0)
        content.pack_start(self.hint("Leave “Enable the Ads API” OFF, then press Create and copy the key."),
                           False, False, 0)

        # 4. paste + test
        content.pack_start(SettingsWindow.section_label("4 · Paste and test"), False, False, 0)
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.key_entry = Gtk.Entry()
        self.key_entry.set_name("settingsEntry")
        self.key_entry.set_visibility(False)
        self.key_entry.set_placeholder_text("paste your KLIPY key")
        self.key_entry.set_text(owner.klipy_api_key)
        self.key_entry.connect("activate", lambda _entry: self.test_and_save())
        row.pack_start(self.key_entry, True, True, 0)
        self.test_button = Gtk.Button(label="Test & save")
        self.test_button.set_name("settingsClose")
        self.test_button.connect("clicked", lambda _button: self.test_and_save())
        row.pack_start(self.test_button, False, False, 0)
        content.pack_start(row, False, False, 0)
        self.status = self.hint("")
        self.status.set_line_wrap(True)
        self.status.set_max_width_chars(52)
        content.pack_start(self.status, False, False, 0)

        note = self.hint(
            "Free test keys allow 100 requests per hour; the widget stays under 60. The key is saved "
            f"in {display_path(SETTINGS.env_file)} (mode 0600) and never written to logs. Powered by KLIPY."
        )
        note.set_line_wrap(True)
        note.set_max_width_chars(52)

        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        footer.set_name("settingsFooter")
        footer.pack_start(note, True, True, 0)
        close = Gtk.Button(label="Close")
        close.set_name("settingsClose")
        close.set_valign(Gtk.Align.CENTER)
        close.connect("clicked", lambda _button: self.destroy())
        footer.pack_end(close, False, False, 0)
        outer.pack_start(footer, False, False, 0)

    @staticmethod
    def hint(text: str) -> Gtk.Label:
        label = SettingsWindow.hint_label(text)
        label.set_line_wrap(True)
        label.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
        label.set_max_width_chars(52)
        return label

    def attach_copy_row(self, grid: Gtk.Grid, row: int, label: str, shown: str, copied: str) -> None:
        texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        name = Gtk.Label(label=label)
        name.set_name("settingsLabel")
        name.set_xalign(0)
        texts.pack_start(name, False, False, 0)
        value = SettingsWindow.hint_label(shown)
        value.set_ellipsize(Pango.EllipsizeMode.END)
        value.set_max_width_chars(38)
        texts.pack_start(value, False, False, 0)
        texts.set_hexpand(True)
        grid.attach(texts, 0, row, 1, 1)
        button = Gtk.Button(label="Copy")
        button.set_name("settingsClose")
        button.set_valign(Gtk.Align.CENTER)
        button.connect("clicked", self.on_copy, copied)
        grid.attach(button, 1, row, 1, 1)

    def on_copy(self, button: Gtk.Button, text: str) -> None:
        Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(text, -1)
        button.set_label("Copied ✓")
        GLib.timeout_add(1500, lambda: button.set_label("Copy") or False)

    def open_partner_panel(self) -> None:
        try:
            Gtk.show_uri_on_window(self, stickers.KLIPY_PARTNER_URL, Gdk.CURRENT_TIME)
        except Exception:
            opener = shutil.which("xdg-open")
            if opener:
                subprocess.Popen([opener, stickers.KLIPY_PARTNER_URL],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def test_and_save(self) -> None:
        if self.checking:
            return
        key = self.key_entry.get_text().strip()
        if not key:
            self.show_status("Paste the key from the KLIPY Partner Panel first.", ok=False)
            return
        self.checking = True
        self.test_button.set_sensitive(False)
        self.show_status("Checking the key with KLIPY…", ok=None)

        def worker() -> None:
            result = stickers.verify_klipy_key(key, stickers.load_customer_id(KLIPY_CUSTOMER_ID_FILE))
            GLib.idle_add(self.on_verified, key, result)

        threading.Thread(target=worker, daemon=True).start()

    def on_verified(self, key: str, result: str) -> bool:
        self.checking = False
        self.test_button.set_sensitive(True)
        if result in ("ok", "rate_limited"):
            self.owner.update_setting("AI_STATUS_KLIPY_API_KEY", key)
            window = self.owner.settings_window
            if window is not None and window.klipy_entry.get_text().strip() != key:
                window.klipy_entry.set_text(key)
        log(f"KLIPY key check: {result}")
        self.show_status(stickers.KLIPY_KEY_STATUS_MESSAGES.get(result, result), ok=result in ("ok", "rate_limited"))
        return False

    def show_status(self, text: str, ok: bool | None) -> None:
        color = {True: "#4ADE80", False: "#FB7060", None: "#8A95A3"}[ok]
        self.status.set_markup(f'<span foreground="{color}">{html.escape(text)}</span>')

    def on_key_press(self, _widget: Gtk.Widget, event: Gdk.EventKey) -> bool:
        if event.keyval == Gdk.KEY_Escape:
            self.destroy()
            return True
        return False


def display_path(path: Path) -> str:
    try:
        return "~/" + str(path.relative_to(Path.home()))
    except ValueError:
        return str(path)


class StatusWidget(Gtk.Window):
    def __init__(self, demo: bool = False) -> None:
        super().__init__(title=TITLE)
        self.set_name("window")
        self.demo = demo
        self.demo_index = 0
        self.config = self.load_config()
        self.agents: tuple[str, ...] = SETTINGS.agents
        self.max_rows = MAX_ROWS
        self.settings_window: SettingsWindow | None = None
        self.klipy_guide: KlipyKeyGuide | None = None
        self.serious_mode = SETTINGS.serious_mode
        self.klipy_api_key = SETTINGS.klipy_api_key
        self.sticker_overlay = StickerOverlay() if CAIRO_OK else None
        self.sticker_source = self.build_sticker_source()
        self.sticker_kinds: dict[str, str] = {}
        self.sticker_primed = False
        self.sticker_request = 0
        self.sticker_debounce: int | None = None
        self.sticker_owner: str | None = None
        self.sticker_hovered: str | None = None
        self.row_hover_boxes: dict[str, Gtk.Widget] = {}
        self.last_stickers: dict[str, stickers.StickerChoice] = {}
        self.limits_seen: set[tuple[str, str, str]] = set()
        self.test_sticker_index = 0
        self.session_windows = SETTINGS.session_windows
        self.sticker_rotate_seconds = SETTINGS.sticker_rotate_seconds
        self.session_cards: dict[str, SessionCard] = {}
        self.card_order: list[str] = []
        self.card_positions = self.load_card_positions()
        self.was_waiting_for_interaction = False
        self.was_done = False
        self.anim_frame = 0
        self.signature = None
        self.anim_dot_labels: list[Gtk.Label] = []
        self.waiting_dots: list[StatusDot] = []
        self.spinning: list[LogoMark] = []
        self.intro = True
        self.update_available: str | None = None
        self.updating = False
        self.usage_refreshing = False
        self.usage_refreshing_providers: set[str] = set()
        self.usage_animation_source_id: int | None = None
        self.usage_animation_angle = 0.0
        self.usage_logo_widgets: dict[str, RotatingProviderLogo] = {}
        self.usage_logo_buttons: dict[str, Gtk.Button] = {}
        self.usage_snapshot: usage_limits.UsageSnapshot = {
            "providers": usage_limits.load_usage_cache(USAGE_CACHE_FILE),
            "errors": {},
        }
        self.note_usage_limits(self.usage_snapshot, trigger=False)
        self.demo_usage_scenarios = usage_limits.demo_usage_states()
        if demo:
            self.usage_snapshot = self.demo_usage_scenarios[0]["snapshot"]
        self.logo_pixbufs = self.load_logos()
        self.usage_logo_pixbufs = self.load_logos(size=20)
        self.demo_scenarios = [
            [("claude", "reading code", "unitbox-front", "22:16"),
             ("codex", "analyzing", "ai-cli-status-monitor", "22:16")],
            [("claude", "coding", "backend-api", "22:17"),
             ("codex", "waiting for approval", "ai-cli-status-monitor", "22:17")],
            [("claude", "thinking", "backend-api", "22:14"),
             ("codex", "running command", "infra-scripts", "22:15"),
             ("claude", "reading code", "unitbox-front", "22:16"),
             ("codex", "done", "docs-site", "22:11")],
            [],
        ]

        self.set_app_paintable(True)
        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual is not None and screen.is_composited():
            self.set_visual(visual)
        self.set_resizable(False)
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.stick()
        self.set_type_hint(Gdk.WindowTypeHint.UTILITY)
        self.set_position(Gtk.WindowPosition.NONE)
        self.restore_position()

        self._build_ui()
        self.connect("delete-event", self.on_delete)
        self.connect("button-press-event", self.on_button_press)
        self.connect("key-press-event", self.on_key_press)
        self.connect("configure-event", self.on_configure)

        if self.session_windows:
            # The widget is just the usage panel; agents appear as their own windows.
            # No intro splash and no idle lockup animation.
            self.intro = False
            self.signature = json.dumps(["session-windows"])
            self.rebuild_body([], 0, show_lockup=False)
        else:
            self.build_intro()
            GLib.timeout_add_seconds(3, self.end_intro)
        GLib.timeout_add_seconds(1, self.refresh_status)
        GLib.timeout_add(200, self.tick_animation)
        GLib.timeout_add_seconds(4, self.apply_wmctrl_hints)
        if not demo:
            # Check GitHub for a newer release once, a few seconds after startup so
            # it never competes with the intro or first paint.
            GLib.timeout_add_seconds(4, self.start_update_check)
            GLib.timeout_add_seconds(4, self.start_usage_refresh)
            GLib.timeout_add_seconds(120, self.usage_refresh_tick)

