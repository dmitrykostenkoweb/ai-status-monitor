    # ----------------------------- config -----------------------------
    def load_config(self) -> dict[str, object]:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        return dict(DEFAULT_CONFIG)

    def write_config(self, values: dict[str, object]) -> None:
        try:
            current = {}
            if WIDGET_CONFIG.exists():
                loaded = json.loads(WIDGET_CONFIG.read_text(encoding="utf-8"))
                if isinstance(loaded, dict):
                    current = loaded
            current.update(values)
            WIDGET_CONFIG.write_text(json.dumps(current, indent=2) + "\n", encoding="utf-8")
        except (json.JSONDecodeError, OSError) as error:
            log(f"failed to write widget config: {error}")

    def load_logos(self, size: int = 14) -> dict[str, QPixmap]:
        logos: dict[str, QPixmap] = {}
        for agent, path in (("claude", ANTHROPIC_LOGO), ("codex", OPENAI_LOGO)):
            if not path.exists():
                log(f"logo missing for {agent}: {path}")
                continue
            pixmap = load_scaled_pixmap(path, size)
            if pixmap is None:
                log(f"failed to load logo for {agent}: {path}")
                continue
            logos[agent] = pixmap
        return logos

    def config_seconds(self, key: str) -> int:
        value = self.config.get(key, DEFAULT_CONFIG[key])
        return value if isinstance(value, int) else int(DEFAULT_CONFIG[key])

    def config_timedelta(self, key: str) -> timedelta:
        return timedelta(seconds=self.config_seconds(key))

    # ----------------------------- data -----------------------------
    def collect_sessions(self) -> list[dict[str, object]]:
        if self.demo:
            # Rotate every 4 s so session windows' stickers have time to show.
            scenario = self.demo_scenarios[(self.demo_index // 4) % len(self.demo_scenarios)]
            sessions = []
            for agent, status, project, hhmm in scenario:
                session = self.make_session(agent, status, project, hhmm)
                session["id"] = f"{agent}:{project}"
                sessions.append(session)
        else:
            structured = self.read_structured_sessions()
            sessions = structured if structured is not None else self.read_combined_sessions()
        return [session for session in sessions if self.agent_enabled(str(session["agent"]))]

    def agent_enabled(self, agent: str) -> bool:
        """Sessions of an unrecognised agent stay visible only while every agent is shown."""
        if agent in SUPPORTED_AGENTS:
            return agent in self.agents
        return self.agents == SUPPORTED_AGENTS

    def make_session(
        self,
        agent: str,
        status: str,
        project: str,
        hhmm: str,
        cwd: str = "",
        client_pids: list[int] | None = None,
        kind: StatusKind | str | None = None,
        source_kind: StatusKind | str | None = None,
        console_window: int = 0,
    ) -> dict[str, object]:
        normalized_kind = normalize_kind(kind, status)
        original_kind = normalize_kind(source_kind if source_kind is not None else normalized_kind, status)
        return {
            "agent": agent if agent in AGENT_NAME_COLORS else "",
            "name": agent.capitalize() if agent else "AI",
            "status": status,
            "kind": normalized_kind,
            "source_kind": original_kind,
            "project": project,
            "time": hhmm,
            "cwd": cwd,
            "client_pids": client_pids or [],
            "console_window": console_window,
            "id": f"{agent}:{project}",
            "color": STATE_COLORS.get(normalized_kind, STATE_COLORS["neutral"]),
        }

    def read_structured_sessions(self) -> list[dict[str, object]] | None:
        paths = self.status_file_paths()
        if not paths:
            return None
        sessions: list[dict[str, object]] = []
        for path in paths:
            if not path.exists():
                continue
            try:
                data = json.loads(path.read_text(encoding="utf-8"))
            except (json.JSONDecodeError, OSError) as error:
                log(f"failed to read status json {path}: {error}")
                continue
            if not isinstance(data, dict):
                continue
            status = str(data.get("status") or "")
            project = str(data.get("project") or "")
            hhmm = str(data.get("timestamp_hhmm") or "")
            agent = str(data.get("agent") or path.stem).lower()
            cwd = str(data.get("cwd") or "")
            source_kind = normalize_kind(data.get("kind"), status)
            display_kind: StatusKind = source_kind
            raw_pids = data.get("client_pids")
            client_pids = [p for p in raw_pids if isinstance(p, int)] if isinstance(raw_pids, list) else []
            console = data.get("console_window")
            console_window = console if isinstance(console, int) and not isinstance(console, bool) else 0
            age = self.status_age(str(data.get("timestamp_iso") or ""))
            if age is not None:
                if self.should_hide_status(source_kind, status, age):
                    continue
                if age >= self.config_timedelta("hide_stale_after_seconds"):
                    continue
                if age >= self.config_timedelta("idle_after_seconds"):
                    status, project, display_kind = f"{agent.capitalize()}: idle", "", "idle"
                elif age >= self.config_timedelta("stale_after_seconds"):
                    status = f"{agent.capitalize()}: no new events"
                    display_kind = "stale"
            if not status:
                continue
            name, clean = self.split_agent_status(status, agent)
            session = self.make_session(agent, clean, project, hhmm, cwd, client_pids, display_kind, source_kind,
                                        console_window)
            session["name"] = name
            session["id"] = path.stem
            sessions.append(session)
        return sessions

    def read_combined_sessions(self) -> list[dict[str, object]]:
        try:
            raw = STATUS_FILE.read_text(encoding="utf-8").strip()
        except OSError:
            return []
        sessions: list[dict[str, object]] = []
        for line in raw.splitlines():
            line = line.strip()
            if not line:
                continue
            project, hhmm = "", ""
            text = line
            if "[" in text and "]" in text:
                before, _, rest = text.partition("[")
                project, _, after = rest.partition("]")
                text = before.strip()
                hhmm = after.strip()
            agent = "claude" if "claude" in line.lower() else ("codex" if "codex" in line.lower() else "")
            name, clean = self.split_agent_status(text, agent)
            session = self.make_session(agent, clean, project.strip(), hhmm)
            session["name"] = name
            session["id"] = f"{agent}:{project.strip()}"
            sessions.append(session)
        return sessions

    def split_agent_status(self, status: str, agent: str) -> tuple[str, str]:
        name = agent.capitalize() if agent in AGENT_NAME_COLORS else "AI"
        clean = status
        for prefix in ("Claude:", "Codex subagent:", "Codex:"):
            if clean.startswith(prefix):
                if prefix == "Codex subagent:":
                    name = "Codex subagent"
                clean = clean[len(prefix):]
                break
        return name, " ".join(clean.split())

    def status_file_paths(self) -> list[Path]:
        paths = list(STATUS_DIR.glob("*.json")) if STATUS_DIR.exists() else []
        if paths:
            paths.sort(key=self.status_file_timestamp, reverse=True)
            return paths
        return [path for path in AGENT_STATUS_FILES if path.exists()]

    def status_file_timestamp(self, path: Path) -> str:
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError):
            return ""
        if not isinstance(data, dict):
            return ""
        value = data.get("timestamp_iso")
        return value if isinstance(value, str) else ""

    def status_age(self, timestamp_iso: str) -> timedelta | None:
        if not timestamp_iso:
            return None
        try:
            timestamp = datetime.fromisoformat(timestamp_iso)
        except ValueError:
            return None
        return datetime.now() - timestamp

    def should_hide_status(self, kind: StatusKind, _status: str, age: timedelta) -> bool:
        # Legacy text has already been normalized into `kind` by the loader.
        return kind == "done" and age >= self.config_timedelta("hide_done_after_seconds")

    # ----------------------------- render -----------------------------
    def order_sessions(self, sessions: list[dict[str, object]]) -> list[dict[str, object]]:
        priority = {"waiting": 0, "error": 1}

        def rank(session: dict[str, object]) -> tuple[int, int]:
            kind = str(session["kind"])
            if kind in priority:
                return (priority[kind], 0)
            if kind in IN_PROGRESS:
                return (2, 0)
            return (3, 0)  # done / idle / stale last

        return sorted(sessions, key=rank)

    def refresh_status(self) -> bool:
        if self.closing:
            return False
        if self.intro:
            return True  # the startup lockup owns the body until end_intro()
        if self.demo:
            self.apply_demo_usage_state(self.demo_index)
        sessions = self.order_sessions(self.collect_sessions())
        if not self.demo and not self.session_windows:
            # In the classic list one sticker pops on change; session windows own theirs.
            self.update_stickers(sessions)
        visible = sessions[:self.max_rows]
        hidden_done = sum(1 for s in sessions[self.max_rows:] if s["kind"] in INACTIVE)

        waiting = any(s["kind"] == "waiting" for s in visible)
        waiting_count = sum(1 for s in visible if s["kind"] == "waiting")
        done = bool(visible) and all(s["kind"] in INACTIVE for s in visible)

        self.set_waiting_style(waiting)
        self.set_badge(bool(visible), waiting_count)

        if self.session_windows:
            self.sync_session_cards(visible)
            # Rows live in their own windows; the card is only header + usage, even when idle.
            signature = json.dumps(["session-windows"])
            if signature != self.signature:
                self.signature = signature
                self.rebuild_body([], 0, show_lockup=False)
        else:
            signature = json.dumps(
                [[s["name"], s["status"], s["project"], s["time"], s["kind"]] for s in visible] + [hidden_done],
                ensure_ascii=False,
            )
            if signature != self.signature:
                self.signature = signature
                self.rebuild_body(visible, hidden_done)

        if waiting and not self.was_waiting_for_interaction and self.config.get("sound_enabled") is True:
            self.play_notification_sound()
        elif done and not self.was_done and self.config.get("sound_enabled") is True:
            self.play_notification_sound()
        self.was_waiting_for_interaction = waiting
        self.was_done = done

        if self.demo:
            self.demo_index += 1
        return True

    def reset_body(self) -> None:
        self.row_hover_boxes = {}
        # Hiding the old rows sends them synthetic Leave events; let verify_hover() decide
        # after the rebuild instead of tucking the hovered row's sticker right away.
        self.rebuilding = True
        try:
            clear_layout(self.body_layout)
        finally:
            self.rebuilding = False
        self.anim_dot_labels = []
        self.waiting_dots = []
        self.spinning = []

    def rebuild_body(self, sessions: list[dict[str, object]], hidden_done: int, show_lockup: bool = True) -> None:
        self.reset_body()
        if not sessions and not show_lockup:
            # Session windows are showing the rows: collapse the body to nothing.
            self.body.hide()
            self.resize_to_content()
            return
        self.body.show()
        if not sessions:
            self.build_empty_state()
        else:
            for session in sessions:
                session_id = str(session["id"])
                hover = HoverBox(
                    lambda _box, sid=session_id: self.on_row_enter(sid),
                    lambda box, sid=session_id: self.on_row_leave(box, sid),
                )
                hover_layout = QVBoxLayout(hover)
                hover_layout.setContentsMargins(0, 0, 0, 0)
                hover_layout.addWidget(self.build_row(session))
                self.body_layout.addWidget(hover)
                self.row_hover_boxes[session_id] = hover
            if hidden_done > 0:
                footer = QLabel(f"+{hidden_done} finished, hidden automatically")
                footer.setObjectName("footer")
                self.body_layout.addWidget(footer)

        self.resize_to_content()
        if self.sticker_hovered is not None:
            # The hovered row was rebuilt, so its leave event will never come: re-check once
            # the new rows are laid out and tuck the sticker only if the pointer really left.
            QTimer.singleShot(0, self.verify_hover)

    def build_row(
        self,
        session: dict[str, object],
        waiting_dots: list[StatusDot] | None = None,
        dot_labels: list[QLabel] | None = None,
    ) -> QWidget:
        """One session row. Animated parts register in the given lists (a session window's own),
        defaulting to the main widget's lists that `tick_animation` drives."""
        waiting_dots = self.waiting_dots if waiting_dots is None else waiting_dots
        dot_labels = self.anim_dot_labels if dot_labels is None else dot_labels
        kind = str(session["kind"])
        color = str(session["color"])
        agent = str(session["agent"])
        waiting = kind == "waiting"
        dim = kind in INACTIVE

        row = QFrame()
        row.setObjectName("row")
        set_flag(row, "alert", waiting)
        layout = QHBoxLayout(row)
        layout.setContentsMargins(8, 4, 8, 4)
        layout.setSpacing(11)

        # The status dot itself is the `→` window-switch button: drawn as an arrow in the state
        # colour (glow / waiting ring kept), on the left edge where the sticker overlay never
        # reaches.
        dot = StatusDot(arrow=True)
        dot.configure_dot(color, waiting)
        if waiting:
            waiting_dots.append(dot)
        switch = DotSwitch(dot)
        switch.setToolTip("Switch to this session's window")
        project_name = str(session["project"])
        cwd = str(session["cwd"])
        pids = list(session["client_pids"]) if isinstance(session["client_pids"], list) else []
        console_window = int(session.get("console_window") or 0)
        switch.clicked.connect(
            lambda _checked=False, p=project_name, c=cwd, ids=pids, con=console_window:
            self.switch_to_session(p, c, ids, con)
        )
        layout.addWidget(switch, 0, Qt.AlignmentFlag.AlignTop)

        logo_box = QLabel()
        logo_box.setObjectName("logoBox")
        logo_box.setFixedSize(24, 24)
        logo_box.setAlignment(Qt.AlignmentFlag.AlignCenter)
        pixmap = self.logo_pixmaps.get(agent)
        if pixmap is not None:
            logo_box.setPixmap(pixmap)
        if dim:
            self.dim_widget(logo_box)
        layout.addWidget(logo_box, 0, Qt.AlignmentFlag.AlignTop)

        text_box = QWidget()
        text_layout = QVBoxLayout(text_box)
        text_layout.setContentsMargins(0, 0, 0, 0)
        text_layout.setSpacing(2)
        if dim:
            self.dim_widget(text_box)
        layout.addWidget(text_box, 1)

        top = QHBoxLayout()
        top.setSpacing(8)
        text_layout.addLayout(top)

        name = QLabel(str(session["name"]))
        name.setObjectName("agentName")
        name.setStyleSheet(f"color: {AGENT_NAME_COLORS.get(agent, '#9AA4B2')};")
        top.addWidget(name)

        status = ElidedLabel(str(session["status"]), color=color)
        status.setObjectName("statusText")
        top.addWidget(status, 1 if kind not in IN_PROGRESS else 0)

        if kind in IN_PROGRESS:
            dots = QLabel()
            dots.setObjectName("statusText")
            dots.setTextFormat(Qt.TextFormat.RichText)
            dots.setText(markup("", color))
            dots.setMinimumWidth(dots.fontMetrics().horizontalAdvance("...") + 2)
            dots.base_color = color  # type: ignore[attr-defined]
            dot_labels.append(dots)
            top.addWidget(dots)
            top.addStretch(1)

        meta_text = " · ".join(part for part in (str(session["project"]), str(session["time"])) if part)
        if meta_text:
            meta = ElidedLabel(meta_text, color=META_COLOR)
            meta.setObjectName("meta")
            text_layout.addWidget(meta)

        return row

    @staticmethod
    def dim_widget(widget: QWidget) -> None:
        effect = QGraphicsOpacityEffect(widget)
        effect.setOpacity(0.55)
        widget.setGraphicsEffect(effect)

    def build_lockup(self, subtitle: str) -> QWidget:
        """Horizontal lockup: full radar logo + 'AI Status Monitor' + a subtitle line.

        Reused for the startup intro and the idle state (different subtitle each time)."""
        box = QWidget()
        layout = QHBoxLayout(box)
        layout.setContentsMargins(18, 22, 18, 24)
        layout.setSpacing(16)
        layout.addStretch(1)

        logo = LogoMark(54, variant="full", sweep=True, tile=True)
        self.spinning.append(logo)
        layout.addWidget(logo, 0, Qt.AlignmentFlag.AlignVCenter)

        text = QVBoxLayout()
        text.setSpacing(6)
        title = QLabel('<span style="color:#E6EDF3">AI Status</span><span style="color:#2DD4BF"> Monitor</span>')
        title.setObjectName("lockupTitle")
        title.setTextFormat(Qt.TextFormat.RichText)
        text.addWidget(title)
        sub = QLabel(subtitle)
        sub.setObjectName("lockupSub")
        text.addWidget(sub)
        layout.addLayout(text)
        layout.addStretch(1)
        return box

    def build_empty_state(self) -> None:
        self.body_layout.addWidget(self.build_lockup("no active agents"))

    def build_intro(self) -> None:
        self.reset_body()
        self.body.show()
        self.body_layout.addWidget(self.build_lockup("CLI agent activity"))
        self.set_badge(False, 0)
        self.resize_to_content()

    def end_intro(self) -> bool:
        self.intro = False
        self.signature = None  # force a rebuild from real sessions
        self.refresh_status()
        return False  # one-shot

    def resize_to_content(self) -> None:
        self.adjustSize()
        QTimer.singleShot(0, self.layout_cards)

    def markup(self, value: str, color: str) -> str:
        return markup(value, color)

    def set_badge(self, has_sessions: bool, waiting_count: int) -> None:
        if waiting_count > 0:
            state, text = "alert", markup(f"▲ {waiting_count} ALERT", "#FB7060")
        elif has_sessions:
            alpha = "#4ADE80" if self.anim_frame % 8 < 4 else "#2f9c5a"
            state, text = "live", markup("● LIVE", alpha)
        else:
            state, text = "idle", markup("● IDLE", "#6B7785")
        if self.badge.property("state") != state:
            self.badge.setProperty("state", state)
            self.badge.style().unpolish(self.badge)
            self.badge.style().polish(self.badge)
        self.badge.setText(text)

    # ----------------------------- usage limits -----------------------------
    def render_usage_limits(self) -> None:
        clear_layout(self.usage_rows)
        self.usage_logo_widgets = {}
        self.usage_logo_buttons = {}
        for group in usage_limits.build_usage_groups(self.usage_snapshot):
            provider_key = str(group["provider_key"])
            if provider_key not in self.agents:
                continue
            provider_name = str(group["provider"])
            block = QWidget()
            block_layout = QHBoxLayout(block)
            block_layout.setContentsMargins(0, 4, 0, 4)
            block_layout.setSpacing(9)

            logo_button = QPushButton()
            logo_button.setObjectName("usageProviderButton")
            logo_button.setFocusPolicy(Qt.FocusPolicy.NoFocus)
            logo_button.setCursor(Qt.CursorShape.PointingHandCursor)
            logo_button.setEnabled(not self.usage_refreshing)
            logo_button.setToolTip(f"Refresh {provider_name} usage")
            logo_button.setAccessibleName(f"Refresh {provider_name} usage")
            logo_button.clicked.connect(lambda _checked=False, key=provider_key: self.start_usage_refresh(key))
            button_layout = QHBoxLayout(logo_button)
            button_layout.setContentsMargins(0, 0, 0, 0)
            pixmap = self.usage_logo_pixmaps.get(provider_key)
            if pixmap is not None:
                logo = RotatingProviderLogo(pixmap)
                self.usage_logo_widgets[provider_key] = logo
                button_layout.addWidget(logo, 0, Qt.AlignmentFlag.AlignCenter)
            else:
                fallback = QLabel(provider_name)
                fallback.setObjectName("usageProviderFallback")
                fallback.setAttribute(Qt.WidgetAttribute.WA_TransparentForMouseEvents)
                button_layout.addWidget(fallback, 0, Qt.AlignmentFlag.AlignCenter)
            self.usage_logo_buttons[provider_key] = logo_button
            block_layout.addWidget(logo_button, 0, Qt.AlignmentFlag.AlignVCenter)

            limit_stack = QVBoxLayout()
            limit_stack.setSpacing(4)
            block_layout.addLayout(limit_stack, 1)

            for data in group["rows"]:
                state = str(data["state"])
                limit = QVBoxLayout()
                limit.setSpacing(1)
                line = QHBoxLayout()
                line.setSpacing(5)
                limit.addLayout(line)

                window = str(data["window"])
                if window:
                    window_label = QLabel(window)
                    window_label.setObjectName("usageWindow")
                    set_flag(window_label, "stale", state == "stale")
                    line.addWidget(window_label)
                line.addStretch(1)
                percent = QLabel(str(data["percent_text"]))
                percent.setObjectName("usagePercent")
                set_flag(percent, "stale", state == "stale")
                set_flag(percent, "unavailable", state == "unavailable")
                line.addWidget(percent)

                if state != "unavailable":
                    progress = QProgressBar()
                    progress.setObjectName("usageProgress")
                    progress.setTextVisible(False)
                    progress.setRange(0, 1000)
                    progress.setValue(round(max(0.0, min(1.0, float(data["fraction"]))) * 1000))
                    color_class = str(data["color_class"])
                    if color_class:
                        progress.setProperty("usage", color_class)
                    limit.addWidget(progress)

                    reset_text = str(data["reset_text"])
                    if state == "stale":
                        reset_text = f"{reset_text} · stale"
                    if reset_text:
                        reset = QLabel(reset_text)
                        reset.setObjectName("usageReset")
                        reset.setAlignment(Qt.AlignmentFlag.AlignRight)
                        limit.addWidget(reset)

                limit_stack.addLayout(limit)

            self.usage_rows.addWidget(block)
        self.resize_to_content()

    def apply_demo_usage_state(self, index: int) -> None:
        state = self.demo_usage_scenarios[index % len(self.demo_usage_scenarios)]
        refreshing = bool(state["refreshing"])
        if not refreshing:
            self.stop_usage_animation()
        self.usage_snapshot = state["snapshot"]
        self.usage_refreshing = refreshing
        self.usage_refreshing_providers = set(self.agents) if self.usage_refreshing else set()
        self.render_usage_limits()
        if refreshing:
            self.start_usage_animation()

    def start_usage_refresh(self, provider_key: str | None = None, *_args: object) -> bool:
        if self.usage_refreshing:
            return False
        if provider_key is None:
            provider_keys = self.agents
        elif provider_key in self.agents:
            provider_keys = (provider_key,)
        else:
            return False
        self.usage_refreshing = True
        self.usage_refreshing_providers = set(provider_keys)
        self.render_usage_limits()
        self.start_usage_animation()

        if self.demo:
            timeout_add(600, self.finish_demo_usage_refresh)
            return False

        def worker() -> None:
            try:
                snapshot = usage_limits.refresh_usage(
                    USAGE_CACHE_FILE,
                    provider_keys=provider_keys,
                )
            except Exception:
                snapshot = {
                    "providers": usage_limits.load_usage_cache(USAGE_CACHE_FILE),
                    "errors": {provider: "unavailable" for provider in provider_keys},
                }
            idle_add(self.on_usage_result, snapshot)

        threading.Thread(target=worker, daemon=True).start()
        return False

    def usage_refresh_tick(self) -> bool:
        self.start_usage_refresh()
        return True

    def on_usage_result(self, snapshot: usage_limits.UsageSnapshot) -> bool:
        if self.closing:
            return False
        self.usage_snapshot = snapshot
        self.note_usage_limits(snapshot, trigger=True)
        self.stop_usage_animation()
        self.usage_refreshing = False
        self.usage_refreshing_providers = set()
        self.render_usage_limits()
        unavailable = sorted(snapshot.get("errors", {}))
        if unavailable:
            log(f"usage unavailable for: {', '.join(unavailable)}")
        return False

    def finish_demo_usage_refresh(self) -> bool:
        if self.closing:
            return False
        self.usage_snapshot = self.demo_usage_scenarios[0]["snapshot"]
        self.stop_usage_animation()
        self.usage_refreshing = False
        self.usage_refreshing_providers = set()
        self.render_usage_limits()
        return False

    def start_usage_animation(self) -> None:
        if self.usage_animation_source_id is not None:
            return
        self.usage_animation_angle = 0.0
        self.usage_animation_source_id = timeout_add(USAGE_ANIMATION_INTERVAL_MS, self.tick_usage_animation)

    def stop_usage_animation(self) -> None:
        source_id = self.usage_animation_source_id
        self.usage_animation_source_id = None
        source_remove(source_id)
        self.usage_animation_angle = 0.0
        for provider_key in self.usage_refreshing_providers:
            logo = self.usage_logo_widgets.get(provider_key)
            if logo is not None:
                logo.angle = 0.0
                logo.queue_draw()

    def tick_usage_animation(self) -> bool:
        if not self.usage_refreshing or not self.usage_refreshing_providers:
            self.usage_animation_source_id = None
            return False
        self.usage_animation_angle = (
            self.usage_animation_angle + USAGE_ROTATION_RADIANS_PER_TICK
        ) % (2 * math.pi)
        for provider_key in self.usage_refreshing_providers:
            logo = self.usage_logo_widgets.get(provider_key)
            if logo is not None:
                logo.angle = self.usage_animation_angle
                logo.queue_draw()
        return True

    def set_waiting_style(self, enabled: bool) -> None:
        set_flag(self.card, "waiting", enabled)
        if not enabled:
            set_flag(self.card, "pulse", False)

    def tick_animation(self) -> bool:
        if self.closing:
            return False
        self.anim_frame += 1

        # trailing "..." for in-progress rows, cycling every ~400ms
        count = (self.anim_frame // 2) % 4
        phase = (self.anim_frame % 8) / 8.0
        pulse = self.anim_frame % 8 < 4
        for label in self.anim_dot_labels:
            label.setText(markup("." * count, getattr(label, "base_color", STATE_COLORS["neutral"])))

        # expanding ring on waiting dots
        for dot in self.waiting_dots:
            dot.phase = phase
            dot.queue_draw()

        # red border pulse when waiting
        if flag(self.card, "waiting"):
            set_flag(self.card, "pulse", pulse)

        # the same animations inside every session window
        for card in self.session_cards.values():
            for label in card.dot_labels:
                label.setText(markup("." * count, getattr(label, "base_color", STATE_COLORS["neutral"])))
            for dot in card.waiting_dots:
                dot.phase = phase
                dot.queue_draw()
            if flag(card.card, "waiting"):
                set_flag(card.card, "pulse", pulse)

        # rotating sweep on the lockup logo (startup intro + idle state)
        if self.spinning:
            angle = (self.anim_frame * 0.12) % (2 * math.pi)
            for logo in self.spinning:
                logo.angle = angle
                logo.queue_draw()

        # subtle LIVE badge pulse
        if self.badge.property("state") == "live":
            self.badge.setText(markup("● LIVE", "#4ADE80" if pulse else "#2f9c5a"))
        return True

    # ----------------------------- sound -----------------------------
    def play_notification_sound(self) -> None:
        platform_support.play_sound(NOTIFICATION_SOUND, log)

    # ----------------------------- window plumbing -----------------------------
    def mousePressEvent(self, event: object) -> None:  # noqa: N802 - Qt API
        button = event.button()
        if button == Qt.MouseButton.LeftButton:
            handle = self.windowHandle()
            if handle is not None:
                handle.startSystemMove()
            return
        if button == Qt.MouseButton.RightButton:
            self.show_menu(event.globalPosition().toPoint())
            return
        super().mousePressEvent(event)

    def keyPressEvent(self, event: object) -> None:  # noqa: N802 - Qt API
        if event.key() in (Qt.Key.Key_Return, Qt.Key.Key_Enter, Qt.Key.Key_Escape):
            return
        super().keyPressEvent(event)

    def build_menu(self) -> QMenu:
        menu = QMenu(self)
        menu.addAction("Settings…").triggered.connect(self.open_settings)
        menu.addMenu(self.build_agents_menu(menu))
        serious = menu.addAction("Serious mode (no stickers)")
        serious.setCheckable(True)
        serious.setChecked(self.serious_mode)
        serious.toggled.connect(self.set_serious_mode)
        dock = menu.addAction("Dock all session windows")
        dock.setEnabled(any(card.floating for card in self.session_cards.values()))
        dock.triggered.connect(self.dock_all_cards)
        if not self.klipy_api_key:
            menu.addAction("Get GIFs from KLIPY (free key)…").triggered.connect(lambda: self.open_klipy_guide())
        menu.addSeparator()
        menu.addAction("Reload").triggered.connect(self.reload)
        menu.addAction("Open logs folder").triggered.connect(self.open_logs_folder)
        if self.update_available:
            menu.addAction(f"Update to {self.update_available}").triggered.connect(self.run_update)
        else:
            menu.addAction("Check for updates").triggered.connect(self.start_update_check)
        menu.addAction("Quit").triggered.connect(self.quit)
        return menu

    def show_menu(self, position: object) -> None:
        self.build_menu().exec(position)

    def reload(self) -> None:
        self.signature = None
        self.refresh_status()

    # ----------------------------- session windows -----------------------------
    def load_card_positions(self) -> dict[str, dict[str, float]]:
        try:
            loaded = json.loads(SESSION_WINDOWS_FILE.read_text(encoding="utf-8"))
        except (FileNotFoundError, OSError, json.JSONDecodeError):
            return {}
        if not isinstance(loaded, dict):
            return {}
        cutoff = time.time() - SESSION_WINDOW_POSITION_TTL_SECONDS
        positions: dict[str, dict[str, float]] = {}
        for session_id, value in loaded.items():
            if not isinstance(value, dict):
                continue
            x, y, saved = value.get("x"), value.get("y"), value.get("t", 0)
            if all(isinstance(item, (int, float)) and not isinstance(item, bool) for item in (x, y, saved)) and saved >= cutoff:
                positions[str(session_id)] = {"x": int(x), "y": int(y), "t": float(saved)}
        return positions

    def write_card_positions(self) -> None:
        cutoff = time.time() - SESSION_WINDOW_POSITION_TTL_SECONDS
        self.card_positions = {key: value for key, value in self.card_positions.items() if value["t"] >= cutoff}
        try:
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            SESSION_WINDOWS_FILE.write_text(json.dumps(self.card_positions, indent=2) + "\n", encoding="utf-8")
        except OSError as error:
            log(f"failed to save session window positions: {error}")

    def save_card_position(self, session_id: str, x: int, y: int) -> None:
        self.card_positions[session_id] = {"x": int(x), "y": int(y), "t": time.time()}
        self.write_card_positions()

    def sync_session_cards(self, sessions: list[dict[str, object]]) -> None:
        """One window per visible session: create new ones, update, close finished ones."""
        wanted = {str(session["id"]) for session in sessions}
        for session_id in [key for key in self.session_cards if key not in wanted]:
            self.session_cards.pop(session_id).close_card()
            self.card_order.remove(session_id)
        for session in sessions:
            session_id = str(session["id"])
            card = self.session_cards.get(session_id)
            if card is None:
                card = SessionCard(self, session_id)
                self.session_cards[session_id] = card
                self.card_order.append(session_id)
                card.update_session(session)
                saved = self.card_positions.get(session_id)
                if saved is not None:
                    card.floating = True
                    card.move(*self.clamp_to_visible(int(saved["x"]), int(saved["y"])))
                card.show()
            else:
                card.update_session(session)
        self.layout_cards()

    def layout_cards(self) -> None:
        """Stack docked session windows under the widget, oldest first (stable order)."""
        if not self.session_cards or self.closing:
            return
        geometry = self.geometry()
        # Window y + height - 8 px margin is the card's bottom edge; each session window
        # also has an 8 px margin, so its window top is (visual top - 8).
        next_y = geometry.y() + geometry.height() - 2 * WINDOW_MARGIN + SESSION_CARD_GAP
        for session_id in self.card_order:
            card = self.session_cards[session_id]
            if card.floating:
                continue
            card.dock_at(geometry.x(), next_y)
            next_y += card.height() - 2 * WINDOW_MARGIN + SESSION_CARD_GAP

    def dock_card(self, session_id: str) -> None:
        card = self.session_cards.get(session_id)
        if card is not None:
            card.floating = False
        if self.card_positions.pop(session_id, None) is not None:
            self.write_card_positions()
        self.layout_cards()

    def dock_all_cards(self) -> None:
        for card in self.session_cards.values():
            card.floating = False
        if self.card_positions:
            self.card_positions = {}
            self.write_card_positions()
        self.layout_cards()

    def close_session_cards(self) -> None:
        for card in self.session_cards.values():
            card.close_card()
        self.session_cards = {}
        self.card_order = []

    # ----------------------------- GIF stickers -----------------------------
    def build_sticker_source(self) -> stickers.StickerSource:
        bubbles, queries = stickers.load_sticker_texts(STICKER_TEXTS_FILE)
        klipy = None
        if self.klipy_api_key:
            klipy = stickers.KlipyClient(
                self.klipy_api_key,
                stickers.load_customer_id(KLIPY_CUSTOMER_ID_FILE),
            )
        return stickers.StickerSource(GIFS_DIR, bubbles, queries, klipy, log=log)

    def update_stickers(self, sessions: list[dict[str, object]]) -> None:
        """Pop a sticker for the session whose sticker status changed (waiting rows first)."""
        current: dict[str, str] = {}
        for session in sessions:
            key = stickers.sticker_for_kind(session["kind"])
            if key is not None:
                current[str(session["id"])] = key
        changed = [session_id for session_id, key in current.items() if self.sticker_kinds.get(session_id) != key]
        self.sticker_kinds = current
        if not self.sticker_primed:
            # Do not greet every already-running session with a sticker on startup.
            self.sticker_primed = True
            return
        overlay = self.sticker_overlay
        owner = self.sticker_owner
        if (
            overlay is not None and overlay.visible and overlay.sticky and owner is not None
            and overlay.choice is not None and current.get(owner) != overlay.choice.key
        ):
            overlay.tuck()
            self.sticker_owner = None
        if changed:
            self.request_sticker(current[changed[0]], changed[0])

    def note_usage_limits(self, snapshot: object, *, trigger: bool) -> None:
        providers = snapshot.get("providers") if isinstance(snapshot, dict) else None
        if not isinstance(providers, dict):
            return
        for provider, limits in providers.items():
            if provider not in self.agents or not isinstance(limits, list):
                continue
            for limit in limits:
                if not isinstance(limit, dict):
                    continue
                used = limit.get("used_percent")
                if not isinstance(used, (int, float)) or used < stickers.LIMIT_THRESHOLD_PERCENT:
                    continue
                token = (str(provider), str(limit.get("window")), str(limit.get("resets_at")))
                if token in self.limits_seen:
                    continue
                self.limits_seen.add(token)
                if trigger:
                    self.request_sticker("limit", f"limit:{provider}")

    def request_sticker(self, key: str, session_id: str, *, sticky: bool | None = None,
                        debounce_ms: int = STICKER_DEBOUNCE_MS) -> None:
        """Debounced: rapid status changes collapse into one sticker for the latest change."""
        if self.serious_mode or self.sticker_overlay is None:
            return
        source_remove(self.sticker_debounce)
        self.sticker_request += 1
        request = self.sticker_request
        is_sticky = key in stickers.STICKY_KEYS if sticky is None else sticky

        def pick_in_background() -> bool:
            self.sticker_debounce = None
            source = self.sticker_source

            def worker() -> None:
                try:
                    choice = source.pick(key)
                except Exception as error:  # never let a sticker take the widget down
                    log(f"sticker: pick failed: {error}")
                    choice = stickers.StickerChoice(key, None, "", "placeholder")
                idle_add(self.show_sticker, request, session_id, choice, is_sticky)

            threading.Thread(target=worker, daemon=True).start()
            return False

        self.sticker_debounce = timeout_add(max(1, debounce_ms), pick_in_background)

    def show_sticker(self, request: int, session_id: str, choice: stickers.StickerChoice, sticky: bool) -> bool:
        overlay = self.sticker_overlay
        if overlay is None or request != self.sticker_request or self.serious_mode or self.closing:
            return False
        self.last_stickers[session_id] = choice
        self.sticker_owner = session_id
        log(f"sticker: {choice.key} from {choice.source} ({choice.label})")
        self.sticker_hovered = None
        self.position_sticker_overlay()
        overlay.present_sticker(choice, sticky)
        return False

    def position_sticker_overlay(self) -> None:
        if self.sticker_overlay is None:
            return
        geometry = self.geometry()
        # The card sits inside an 8 px transparent margin of the widget window.
        self.sticker_overlay.place_for_card(geometry.x() + geometry.width() - WINDOW_MARGIN,
                                            geometry.y() + WINDOW_MARGIN)

    def on_row_enter(self, session_id: str) -> None:
        overlay = self.sticker_overlay
        if overlay is None or self.serious_mode:
            return
        choice = self.last_stickers.get(session_id)
        if choice is None:
            return
        if overlay.phase in ("in", "shown") and self.sticker_owner == session_id:
            self.sticker_hovered = session_id  # already showing this row's sticker: keep it
            return
        self.sticker_hovered = session_id
        self.sticker_owner = session_id
        self.position_sticker_overlay()
        overlay.present_sticker(choice, sticky=False, hold_ms=None)

    def on_row_leave(self, box: QWidget, session_id: str) -> None:
        if self.rebuilding or self.sticker_hovered != session_id:
            return
        if self.pointer_inside(box):
            return  # a spurious crossing (e.g. a window mapped above): still hovering
        self.sticker_hovered = None
        if self.sticker_overlay is not None:
            self.sticker_overlay.tuck()

    def pointer_inside(self, widget: QWidget) -> bool:
        if not widget.isVisible():
            return False
        return widget.rect().contains(widget.mapFromGlobal(QCursor.pos()))

    def verify_hover(self) -> bool:
        session_id = self.sticker_hovered
        if session_id is None:
            return False
        box = self.row_hover_boxes.get(session_id)
        if box is None or not self.pointer_inside(box):
            self.sticker_hovered = None
            if self.sticker_overlay is not None:
                self.sticker_overlay.tuck()
        return False

    def show_test_sticker(self, key: str | None = None) -> None:
        """Debug / Settings helper: show one sticker now, cycling through every status."""
        if key is None:
            key = stickers.STICKER_KEYS[self.test_sticker_index % len(stickers.STICKER_KEYS)]
            self.test_sticker_index += 1
        self.request_sticker(key, f"test:{key}", sticky=False, debounce_ms=1)

    def set_serious_mode(self, enabled: bool) -> None:
        self.update_setting("AI_STATUS_SERIOUS_MODE", "true" if enabled else "false")
        window = self.settings_window
        if window is not None and window.serious_switch.isChecked() != enabled:
            window.serious_switch.setChecked(enabled)

    def open_klipy_guide(self, _parent: QWidget | None = None) -> None:
        if self.klipy_guide is None:
            self.klipy_guide = KlipyKeyGuide(self)
            self.klipy_guide.show()
            anchor = self.settings_window if self.settings_window is not None else self
            self.place_beside(self.klipy_guide, anchor)
        self.klipy_guide.raise_()
        self.klipy_guide.activateWindow()

    def on_klipy_guide_closed(self, window: KlipyKeyGuide) -> None:
        if self.klipy_guide is window:
            self.klipy_guide = None

    def open_settings(self) -> None:
        if self.settings_window is None:
            self.settings_window = SettingsWindow(self)
            self.settings_window.show()
            self.place_beside(self.settings_window, self)
        self.settings_window.raise_()
        self.settings_window.activateWindow()

    def place_beside(self, window: QWidget, anchor: QWidget, gap: int = 12) -> None:
        """Open a dialog next to the widget (right if it fits, else left) so changes stay visible."""
        window.adjustSize()
        geometry = anchor.frameGeometry()
        screen = QGuiApplication.screenAt(geometry.topLeft()) or QGuiApplication.primaryScreen()
        if screen is None:
            return
        area = screen.availableGeometry()
        size = window.frameGeometry().size()
        window.move(*screen_geometry.place_beside(
            screen_geometry.Rect(geometry.x(), geometry.y(), geometry.width(), geometry.height()),
            (size.width(), size.height()),
            screen_geometry.Rect(area.x(), area.y(), area.width(), area.height()),
            gap,
        ))

    def on_settings_closed(self, window: SettingsWindow) -> None:
        if self.settings_window is window:
            self.settings_window = None

    def sync_settings_window(self) -> None:
        """Keep the open Settings window in step when agents change from the menu."""
        window = self.settings_window
        if window is None:
            return
        for agent, check in window.agent_checks.items():
            if check.isChecked() != (agent in self.agents):
                check.setChecked(agent in self.agents)

    def update_setting(self, key: str, value: str) -> None:
        """Apply one setting to the running widget and save it to the runtime .env."""
        if key == "AI_STATUS_SOUND_ENABLED":
            self.config["sound_enabled"] = value == "true"
        elif key == "AI_STATUS_SERIOUS_MODE":
            self.serious_mode = value == "true"
            if self.serious_mode:
                source_remove(self.sticker_debounce)
                self.sticker_debounce = None
                self.sticker_request += 1
                if self.sticker_overlay is not None:
                    self.sticker_overlay.hide_now()
            for card in self.session_cards.values():
                if self.serious_mode:
                    card.clear_sticker()
                else:
                    card.refresh_sticker()
        elif key == "AI_STATUS_STICKER_ROTATE_SECONDS":
            self.sticker_rotate_seconds = max(0, int(value))
            for card in self.session_cards.values():
                if card.sticker_key is not None:
                    card.schedule_rotation()  # restarts (or stops, for 0) the timer
        elif key == "AI_STATUS_SESSION_WINDOWS":
            self.session_windows = value == "true"
            if not self.session_windows:
                self.close_session_cards()
        elif key == "AI_STATUS_KLIPY_API_KEY":
            self.klipy_api_key = value
            self.sticker_source = self.build_sticker_source()
        elif key == "AI_STATUS_MAX_ROWS":
            self.max_rows = max(1, int(value))
        else:
            for env_key, config_key, _label, _hint in TIMING_SETTINGS:
                if env_key == key:
                    self.config[config_key] = max(0, int(value))
        shown = "(hidden)" if key == "AI_STATUS_KLIPY_API_KEY" and value else value
        log(f"setting {key}={shown}")
        try:
            write_env_value(SETTINGS.env_file, key, value)
        except OSError as error:
            log(f"failed to save {key} to {SETTINGS.env_file}: {error}")
        if key in os.environ:
            log(f"{key} is set in the environment and will override the saved value on restart")
        self.signature = None
        if not self.intro:
            self.refresh_status()

    def build_agents_menu(self, parent: QMenu) -> QMenu:
        submenu = QMenu("Show agents", parent)
        group = QActionGroup(submenu)
        group.setExclusive(True)
        for label, agents in AGENT_FILTER_CHOICES:
            action = QAction(label, submenu)
            action.setCheckable(True)
            action.setChecked(agents == self.agents)
            action.triggered.connect(lambda _checked=False, choice=agents: self.set_agents(choice))
            group.addAction(action)
            submenu.addAction(action)
        return submenu

    def set_agents(self, agents: tuple[str, ...]) -> None:
        if agents == self.agents:
            return
        newly_shown = set(agents) - set(self.agents)
        self.agents = agents
        self.update_setting("AI_STATUS_AGENTS", format_agents(agents))
        self.render_usage_limits()
        self.sync_settings_window()
        missing = [
            agent for agent in newly_shown
            if not self.usage_snapshot.get("providers", {}).get(agent)
        ]
        if missing and not self.demo:
            self.start_usage_refresh(missing[0] if len(missing) == 1 else None)

    def start_update_check(self) -> bool:
        """Kick off a one-shot background version check against GitHub.

        Runs in a daemon thread so the (networked, possibly slow) request never
        blocks the Qt main loop; the result is delivered back via idle_add.
        """
        def worker() -> None:
            version = updates.check_for_update()
            if version:
                idle_add(self.on_update_result, version)

        threading.Thread(target=worker, daemon=True).start()
        return False  # one-shot timeout

    def on_update_result(self, version: str) -> bool:
        if self.closing:
            return False
        self.update_available = version
        self.update_button.setText(f"update {version} ↑")
        self.update_button.show()
        self.resize_to_content()
        log(f"update available: {version}")
        return False

    def run_update(self, *_args: object) -> None:
        if self.updating:
            return
        if not UPDATE_SCRIPT.exists():
            log(f"update script not found: {UPDATE_SCRIPT}")
            return
        self.updating = True
        self.update_button.setText("updating…")
        self.update_button.setEnabled(False)
        log("starting self-update")
        try:
            # Detach so the updater (which stops and restarts this widget via the
            # installer) outlives the process it is replacing. It runs with the base
            # interpreter, not the widget's venv.
            with open(LOG_FILE, "a", encoding="utf-8") as logfile:
                subprocess.Popen(
                    [process_control.base_interpreter(DATA_DIR), str(UPDATE_SCRIPT)],
                    stdin=subprocess.DEVNULL,
                    stdout=logfile,
                    stderr=logfile,
                    **platform_support.detached_flags(),
                )
        except OSError as error:
            self.updating = False
            self.update_button.setEnabled(True)
            log(f"failed to start update: {error}")

    def open_logs_folder(self) -> None:
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        if not QDesktopServices.openUrl(QUrl.fromLocalFile(str(CACHE_DIR))):
            if not platform_support.open_path(CACHE_DIR):
                log(f"cannot open {CACHE_DIR}: no file manager opener available")

    def monitor_workareas(self) -> list[screen_geometry.Rect]:
        """Work areas of the connected monitors, in virtual-screen coordinates."""
        areas = []
        for screen in QGuiApplication.screens():
            area = screen.availableGeometry()
            areas.append(screen_geometry.Rect(area.x(), area.y(), area.width(), area.height()))
        return areas

    def clamp_to_visible(self, x: int, y: int) -> tuple[int, int]:
        return screen_geometry.clamp_to_visible(x, y, self.monitor_workareas(), CARD_WIDTH, log)

    def restore_position(self) -> None:
        try:
            data = json.loads(WIDGET_CONFIG.read_text(encoding="utf-8"))
            x = int(data.get("x", 40))
            y = int(data.get("y", 80))
        except Exception:
            x, y = 40, 80
        self.move(*self.clamp_to_visible(x, y))

    def save_position(self) -> None:
        try:
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            self.write_config({"x": self.x(), "y": self.y()})
        except OSError as error:
            log(f"failed to save position: {error}")

    def moveEvent(self, event: object) -> None:  # noqa: N802 - Qt API
        super().moveEvent(event)
        if self.closing or not self.isVisible():
            return
        self.save_position()
        if self.sticker_overlay is not None and self.sticker_overlay.visible:
            self.position_sticker_overlay()
        self.layout_cards()

    def resizeEvent(self, event: object) -> None:  # noqa: N802 - Qt API
        super().resizeEvent(event)
        if self.sticker_overlay is not None and self.sticker_overlay.visible:
            self.position_sticker_overlay()
        if not self.closing:
            self.layout_cards()

    def closeEvent(self, event: object) -> None:  # noqa: N802 - Qt API
        self.quit()
        super().closeEvent(event)

    def shutdown(self) -> None:
        """Stop timers and close every window this widget owns (without quitting Qt)."""
        if self.closing:
            return
        self.closing = True
        for timer in self.timers:
            source_remove(timer)
        self.timers = []
        source_remove(self.sticker_debounce)
        self.sticker_debounce = None
        self.stop_usage_animation()
        if self.sticker_overlay is not None:
            self.sticker_overlay.hide_now()
        self.close_session_cards()
        for window in (self.settings_window, self.klipy_guide):
            if window is not None:
                window.close()
        self.hide()
        # Run the pending deleteLater()s now: once the event loop has ended, objects still
        # waiting for deferred deletion are torn down during interpreter exit, which crashes.
        QApplication.sendPostedEvents(None, QEvent.Type.DeferredDelete)

    def quit(self, *_args: object) -> None:
        if not self.closing and self.isVisible():
            self.save_position()
        self.shutdown()
        app = QApplication.instance()
        if app is not None:
            app.quit()

    def switch_to_session(self, project: str, cwd: str, client_pids: list[int], console_window: int = 0) -> None:
        """Raise the terminal window of a session (see ai_agent_status_lib.window_switch)."""
        window_switch.switch_to_session(project, cwd, client_pids, console_window=console_window, log=log)

    def own_window_id(self) -> str | None:
        """This widget's X11 window id as wmctrl expects it (hex), or None off X11."""
        return window_id_of(self)

    def apply_wmctrl_hints(self) -> bool:
        """X11 only: keep the widget and cards on every workspace, above, off the taskbar.

        Qt has no "sticky" window flag, and Mutter/Muffin drop "above" now and then, so this
        re-asserts the EWMH state with wmctrl every few seconds.
        """
        if self.closing or QGuiApplication.platformName() != "xcb":
            return False
        wmctrl = shutil.which("wmctrl")
        if not wmctrl:
            return False  # nothing to reinforce; stop the timer
        # Target our own window by id. Matching by title (`wmctrl -r TITLE`) hits the first
        # window whose title merely *contains* it, e.g. a terminal whose title mentions
        # "AI Agents Status", which then becomes sticky instead of the widget.
        window_id = self.own_window_id()
        targets = [["-i", "-r", window_id] if window_id else ["-r", TITLE]]
        for card in self.session_cards.values():
            card_id = window_id_of(card)
            if card_id:
                targets.append(["-i", "-r", card_id])
        for target in targets:
            try:
                subprocess.run(
                    [wmctrl, *target, "-b", "add,above,sticky,skip_taskbar"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    check=False,
                )
            except OSError as error:
                log(f"wmctrl failed: {error}")
                return False
        return True  # repeat: re-assert above/sticky/skip_taskbar as the WM drops them


def main() -> int:
    parser = argparse.ArgumentParser(description="Floating Qt widget for ai-cli-status-monitor.")
    parser.add_argument("--demo", action="store_true", help="cycle through demo states")
    parser.add_argument("--version", action="store_true", help="print the installed version and exit")
    parser.add_argument(
        "--sticker",
        choices=(*stickers.STICKER_KEYS, "all"),
        help="debug: show this GIF sticker after the intro ('all' cycles through every status)",
    )
    args = parser.parse_args()

    if args.version:
        print(updates.installed_version())
        return 0

    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    if LEGACY_STICKER_CACHE_DIR.is_dir():
        shutil.rmtree(LEGACY_STICKER_CACHE_DIR, ignore_errors=True)
        log("removed the old on-disk KLIPY GIF cache (KLIPY media is now loaded directly)")
    for warning in CONFIG_WARNINGS:
        log(f"configuration: {warning}")
    PID_FILE.write_text(f"{os.getpid()}\n", encoding="utf-8")
    app = ensure_app()
    widget = StatusWidget(demo=args.demo)
    widget.show()

    # Quit cleanly (saving the position) on Ctrl+C / `kill`; Python only sees signals
    # while it runs, so a cheap timer hands control back to the interpreter.
    for signum in (signal.SIGINT, getattr(signal, "SIGTERM", None)):
        if signum is not None:
            signal.signal(signum, lambda *_args: QTimer.singleShot(0, widget.quit))
    timeout_add(500, lambda: True)

    if args.sticker:
        def show_debug_sticker() -> bool:
            if args.sticker == "all":
                widget.show_test_sticker()
                return True  # keep cycling, one status every 5 s
            widget.show_test_sticker(args.sticker)
            return False

        def start_debug_stickers() -> bool:
            if show_debug_sticker():
                timeout_add(5000, show_debug_sticker)
            return False

        timeout_add(3500, start_debug_stickers)
    log(f"widget started ({QGuiApplication.platformName()})" + (" in demo mode" if args.demo else ""))
    app.exec()
    log("widget stopped")
    try:
        PID_FILE.unlink()
    except OSError:
        pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
