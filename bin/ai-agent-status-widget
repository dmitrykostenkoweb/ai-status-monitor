    """Map a legacy status string to a state kind used for colour and animation."""
    return classify_status_text(status)


# ----------------------------- Qt main-loop helpers -----------------------------

class _MainThreadDispatcher(QObject):
    """Runs callbacks posted from worker threads on the Qt main thread."""

    call = Signal(object)

    def __init__(self) -> None:
        super().__init__()
        self.call.connect(self._run, Qt.ConnectionType.QueuedConnection)

    def _run(self, callback: Callable[[], object]) -> None:
        try:
            callback()
        except Exception as error:  # never let a late callback take the widget down
            log(f"main-thread callback failed: {error}")


_DISPATCHER: _MainThreadDispatcher | None = None


def prefer_x11() -> None:
    """On Linux, run through X11/XWayland when possible.

    The widget positions its own windows (docked session cards, the sticker overlay, the
    saved position) and raises terminals via wmctrl, none of which Wayland clients may do.
    Qt 6.5+ needs libxcb-cursor for its xcb backend, so only switch when it is present —
    and on a pure X11 session without it, explain instead of letting Qt abort.
    """
    if platform_support.PLATFORM != platform_support.LINUX or os.environ.get("QT_QPA_PLATFORM"):
        return
    missing = platform_support.missing_linux_qt_packages()
    if os.environ.get("WAYLAND_DISPLAY"):
        if os.environ.get("DISPLAY") and not missing:
            os.environ["QT_QPA_PLATFORM"] = "xcb"
        return
    if missing:
        message = f"Qt needs {', '.join(missing)} for X11: sudo apt install {' '.join(missing)}"
        log(message)
        print(message, file=sys.stderr)
        raise SystemExit(1)


def ensure_app() -> QApplication:
    global _DISPATCHER
    app = QApplication.instance()
    if app is None:
        prefer_x11()
        app = QApplication(sys.argv[:1])
        app.setApplicationName("AI Status Monitor")
        app.setQuitOnLastWindowClosed(False)
        app.setStyle("Fusion")
        load_fonts()
        app.setFont(body_font(13))
        app.setStyleSheet(style_sheet(T()))
    if _DISPATCHER is None:
        _DISPATCHER = _MainThreadDispatcher()
    return app  # type: ignore[return-value]


def idle_add(callback: Callable[..., object], *args: object) -> None:
    """Thread-safe: run ``callback(*args)`` on the main thread (GLib.idle_add semantics)."""
    assert _DISPATCHER is not None, "ensure_app() must run first"
    _DISPATCHER.call.emit(lambda: callback(*args))


def timeout_add(interval_ms: int, callback: Callable[..., object], *args: object) -> QTimer:
    """Repeat ``callback`` every ``interval_ms`` while it returns True (GLib.timeout_add semantics)."""
    timer = QTimer(QApplication.instance())
    timer.setInterval(max(0, int(interval_ms)))

    def fire() -> None:
        try:
            keep = callback(*args)
        except Exception as error:
            log(f"timer callback failed: {error}")
            keep = False
        if not keep:
            source_remove(timer)

    timer.timeout.connect(fire)
    timer.start()
    return timer


def timeout_add_seconds(seconds: int, callback: Callable[..., object], *args: object) -> QTimer:
    return timeout_add(seconds * 1000, callback, *args)


def source_remove(timer: QTimer | None) -> None:
    if timer is None:
        return
    try:
        timer.stop()
        timer.deleteLater()
    except RuntimeError:  # already deleted
        pass


def process_events(seconds: float = 0.0) -> None:
    """Pump the event loop (tests and one-off waits)."""
    deadline = time.monotonic() + seconds
    while True:
        QApplication.processEvents()
        if time.monotonic() >= deadline:
            return
        time.sleep(0.01)


def monotonic_ms() -> float:
    return time.monotonic() * 1000.0


# ----------------------------- painting helpers -----------------------------

def qcolor(value: str, alpha: float = 1.0) -> QColor:
    color = QColor(value)
    color.setAlphaF(max(0.0, min(1.0, alpha)))
    return color


def add_arc(path: QPainterPath, cx: float, cy: float, radius: float, start: float, end: float,
            connect: bool = True) -> None:
    """Append a cairo-style arc (radians, y down, clockwise for growing angles)."""
    while end < start:
        end += 2 * math.pi
    steps = max(2, int((end - start) / (2 * math.pi) * 96) + 1)
    for index in range(steps + 1):
        angle = start + (end - start) * index / steps
        point = QPointF(cx + radius * math.cos(angle), cy + radius * math.sin(angle))
        if index == 0 and (not connect or path.elementCount() == 0):
            path.moveTo(point)
        else:
            path.lineTo(point)


def rounded_rect_path(x: float, y: float, w: float, h: float,
                      radii: tuple[float, float, float, float]) -> QPainterPath:
    """Rounded rectangle; radii are (top-left, top-right, bottom-right, bottom-left)."""
    tl, tr, br, bl = radii
    path = QPainterPath()
    add_arc(path, x + w - tr, y + tr, tr, -math.pi / 2, 0, connect=False)
    add_arc(path, x + w - br, y + h - br, br, 0, math.pi / 2)
    add_arc(path, x + bl, y + h - bl, bl, math.pi / 2, math.pi)
    add_arc(path, x + tl, y + tl, tl, math.pi, 3 * math.pi / 2)
    path.closeSubpath()
    return path


def text_block(text: str, font: QFont, width: float,
               line_height: float | None = None) -> tuple[QTextLayout, float, float]:
    """Lay out wrapped text (word boundaries, else anywhere); returns (layout, width, height).

    ``line_height`` sets a fixed pitch (CSS ``line-height`` in px) instead of the font's."""
    layout = QTextLayout(text, font)
    option = QTextOption()
    option.setWrapMode(QTextOption.WrapMode.WrapAtWordBoundaryOrAnywhere)
    layout.setTextOption(option)
    layout.beginLayout()
    height = 0.0
    natural = 0.0
    while True:
        line = layout.createLine()
        if not line.isValid():
            break
        line.setLineWidth(width)
        line.setPosition(QPointF(0, height))
        height += line_height if line_height else line.height()
        natural = max(natural, line.naturalTextWidth())
    layout.endLayout()
    return layout, natural, height


def load_scaled_pixmap(path: Path, size: int) -> QPixmap | None:
    """Load a PNG/SVG at ``size`` logical pixels, rendered for the screen's pixel ratio."""
    reader = QImageReader(str(path))
    native = reader.size()
    ratio = max(1.0, QGuiApplication.primaryScreen().devicePixelRatio() if QGuiApplication.primaryScreen() else 1.0)
    target = round(size * ratio)
    if native.isValid() and native.width() > 0 and native.height() > 0:
        scale = target / max(native.width(), native.height())
        reader.setScaledSize(QSize(max(1, round(native.width() * scale)), max(1, round(native.height() * scale))))
    image = reader.read()
    if image.isNull():
        return None
    pixmap = QPixmap.fromImage(image)
    pixmap.setDevicePixelRatio(ratio)
    return pixmap


def set_flag(widget: QWidget, name: str, enabled: bool) -> None:
    """Toggle a boolean style-sheet property (``#card[waiting="true"]``) and re-polish."""
    value = "true" if enabled else "false"
    if widget.property(name) == value:
        return
    widget.setProperty(name, value)
    style = widget.style()
    style.unpolish(widget)
    style.polish(widget)
    widget.update()


def flag(widget: QWidget, name: str) -> bool:
    return widget.property(name) == "true"


def clear_layout(layout: QLayout) -> None:
    while layout.count():
        item = layout.takeAt(0)
        child = item.widget()
        if child is not None:
            child.hide()
            child.setParent(None)
            child.deleteLater()
        elif item.layout() is not None:
            clear_layout(item.layout())


def markup(value: str, color: str) -> str:
    return f'<span style="color:{color}">{html.escape(value)}</span>'


def tool_window_flags(accept_focus: bool = True) -> Qt.WindowType:
    flags = Qt.WindowType.Tool | Qt.WindowType.FramelessWindowHint | Qt.WindowType.WindowStaysOnTopHint
    if not accept_focus:
        flags |= Qt.WindowType.WindowDoesNotAcceptFocus
    return flags


def prepare_floating_window(window: QWidget) -> None:
    window.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
    # macOS hides tool windows whenever the app is not active; keep them up.
    window.setAttribute(Qt.WidgetAttribute.WA_MacAlwaysShowToolWindow)


def window_id_of(window: QWidget) -> str | None:
    """A window's X11 id as wmctrl expects it (hex), or None off X11 / before it exists."""
    if QGuiApplication.platformName() != "xcb":
        return None
    try:
        return hex(int(window.winId()))
    except Exception:
        return None


# Built outside the f-string: Python < 3.12 forbids backslashes inside f-string expressions.
# ----------------------------- comic theme: fonts, colours, style sheet -----------------------------

DISPLAY_FAMILIES = ["Bangers", "Impact", "Arial Black", "sans-serif"]
BODY_FAMILIES = ["Comic Neue", "Comic Sans MS", "Chalkboard SE", "sans-serif"]
MONO_FAMILIES = ["Space Mono", "Menlo", "Consolas", "DejaVu Sans Mono", "monospace"]
# Bundled OFL fonts: installed to <data>/fonts; assets/fonts when running from the repo.
FONT_DIRS = (DATA_DIR / "fonts", Path(__file__).resolve().parent.parent / "assets" / "fonts")
PROVIDER_LABELS = {"claude": "Anthropic", "codex": "OpenAI"}
CURRENT_THEME = theme.get_theme(SETTINGS.theme)


def T() -> theme.Theme:
    """The active comic theme (dark or light)."""
    return CURRENT_THEME


def set_theme(name: str) -> None:
    global CURRENT_THEME
    CURRENT_THEME = theme.get_theme(name)
    app = QApplication.instance()
    if app is not None:
        app.setStyleSheet(style_sheet(CURRENT_THEME))


def load_fonts() -> None:
    for directory in FONT_DIRS:
        files = sorted(directory.glob("*.ttf")) if directory.is_dir() else []
        if not files:
            continue
        for path in files:
            if QFontDatabase.addApplicationFont(str(path)) < 0:
                log(f"font: cannot load {path}")
        return
    log("font: bundled comic fonts not found, using system fallbacks")


def comic_font(families: list[str], pixels: float, weight: QFont.Weight = QFont.Weight.Normal,
               spacing: float = 0.0) -> QFont:
    font = QFont()
    font.setFamilies(families)
    font.setPixelSize(max(1, round(pixels)))
    font.setWeight(weight)
    if spacing:
        font.setLetterSpacing(QFont.SpacingType.AbsoluteSpacing, spacing)
    return font


def display_font(pixels: float, spacing: float = 0.0) -> QFont:
    return comic_font(DISPLAY_FAMILIES, pixels, spacing=spacing)


def body_font(pixels: float) -> QFont:
    return comic_font(BODY_FAMILIES, pixels, QFont.Weight.Bold)


def mono_font(pixels: float, bold: bool = False) -> QFont:
    return comic_font(MONO_FAMILIES, pixels, QFont.Weight.Bold if bold else QFont.Weight.Normal)


def resolve_color(value: str) -> str:
    """A literal colour, or the name of a theme token (``ink``, ``card``, ``text_secondary``…)."""
    if value.startswith("#"):
        return value
    return str(getattr(T(), value))


# The widget's cards are drawn at 70 % of the design handoff's sizes (dialogs stay at 100 %,
# GIF stickers keep their full size). Small text never drops below a readable floor.
UI_SCALE = 0.7
MIN_TEXT_PX = 8.0


def sc(value: float) -> float:
    """A handoff size in px, scaled for the widget's cards."""
    return value * UI_SCALE


def sci(value: float) -> int:
    return max(1, round(value * UI_SCALE))


def sct(pixels: float) -> float:
    """A scaled text size, but never below MIN_TEXT_PX."""
    return max(MIN_TEXT_PX, pixels * UI_SCALE)


def comic_label(text: str, font: QFont, role: str = "text", wrap: bool = False) -> QLabel:
    """A label whose colour follows the theme through the style sheet (objectName = role)."""
    label = QLabel(text)
    label.setObjectName(role)
    label.setFont(font)
    label.setWordWrap(wrap)
    return label


def style_sheet(t: theme.Theme) -> str:
    return f"""
QLabel#text {{ color: {t.text}; }}
QLabel#secondary {{ color: {t.text_secondary}; }}
QLabel#tertiary {{ color: {t.text_tertiary}; }}
QLabel#ink {{ color: {t.ink}; }}
QWidget#settingsWindow {{ background: {t.card}; }}
QMenu {{
  background: {t.card}; color: {t.text}; border: 3px solid {t.ink}; padding: 4px;
  font-family: "Comic Neue", "Comic Sans MS", sans-serif; font-size: 13px; font-weight: 700;
}}
QMenu::item {{ padding: 6px 20px 6px 26px; border-radius: 3px; }}
QMenu::item:selected {{ background: {theme.YELLOW}; color: {theme.INK_ON_COLOUR}; }}
QMenu::item:disabled {{ color: {t.text_secondary}; }}
QMenu::separator {{ height: 2px; background: {t.ink}; margin: 4px 8px; }}
QToolTip {{
  background: {theme.YELLOW}; color: {theme.INK_ON_COLOUR}; border: 2px solid {theme.INK_ON_COLOUR};
  padding: 3px 6px; font-family: "Comic Neue", "Comic Sans MS", sans-serif; font-size: 12px; font-weight: 700;
}}
QWidget#settingsWindow QSpinBox, QWidget#settingsWindow QDoubleSpinBox, QWidget#settingsWindow QLineEdit {{
  background: {t.inner}; color: {t.text}; border: 2px solid {t.ink}; border-radius: 4px;
  font-family: "Space Mono", monospace; font-size: 12px; min-height: 24px; padding: 0 6px;
  selection-background-color: {theme.YELLOW}; selection-color: {theme.INK_ON_COLOUR};
}}
QWidget#settingsWindow QAbstractSpinBox {{ min-width: 46px; }}
QWidget#settingsWindow QAbstractSpinBox::up-button, QWidget#settingsWindow QAbstractSpinBox::down-button {{
  width: 0; border: none;
}}
"""


def tinted(pixmap: QPixmap, color: str) -> QPixmap:
    """A one-colour silhouette of ``pixmap`` (logos printed in ink on a colour disc)."""
    result = QPixmap(pixmap.size())
    result.setDevicePixelRatio(pixmap.devicePixelRatio())
    result.fill(Qt.GlobalColor.transparent)
    painter = QPainter(result)
    painter.drawPixmap(0, 0, pixmap)
    painter.setCompositionMode(QPainter.CompositionMode.CompositionMode_SourceIn)
    painter.fillRect(result.rect(), QColor(color))
    painter.end()
    return result


def ink_pen(color: str, width: float) -> QPen:
    pen = QPen(QColor(color), width)
    pen.setJoinStyle(Qt.PenJoinStyle.MiterJoin)
    return pen


def draw_halftone(painter: QPainter, rect: QRectF, color: QColor, radius: float, step: float) -> None:
    """CSS ``radial-gradient(<dot> r, transparent) / step step`` dots over ``rect``."""
    painter.save()
    painter.setClipRect(rect, Qt.ClipOperation.IntersectClip)
    painter.setPen(Qt.PenStyle.NoPen)
    painter.setBrush(color)
    y = rect.top() + step / 2
    while y < rect.bottom() + step:
        x = rect.left() + step / 2
        while x < rect.right() + step:
            painter.drawEllipse(QPointF(x, y), radius, radius)
            x += step
        y += step
    painter.restore()


# ----------------------------- comic widgets -----------------------------

class ComicFrame(QFrame):
    """Ink-outlined panel with an optional hard (blur-free) offset shadow.

    The shadow lives inside the widget's own rect (bottom/right ``shadow`` px are kept
    free through the contents margins), so layouts never clip it. While the frame's
    ``waiting`` flag is set, the outline pulses red with the ``pulse`` flag.
    """

    def __init__(self, fill: str = "card", radius: float = 6, border: float = 3, shadow: int = 0) -> None:
        super().__init__()
        self.fill = fill
        self.radius = radius
        self.border = border
        self.shadow = shadow
        self.setContentsMargins(0, 0, shadow, shadow)

    def body_rect(self) -> QRectF:
        return QRectF(0, 0, self.width() - self.shadow, self.height() - self.shadow)

    def paintEvent(self, _event: object) -> None:  # noqa: N802 - Qt API
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        body = self.body_rect()
        if self.shadow:
            painter.setPen(Qt.PenStyle.NoPen)
            painter.setBrush(QColor(T().shadow))
            painter.drawRoundedRect(body.translated(self.shadow, self.shadow), self.radius, self.radius)
        outline = theme.RED if flag(self, "waiting") and flag(self, "pulse") else T().ink
        half = self.border / 2
        painter.setPen(ink_pen(outline, self.border))
        painter.setBrush(QColor(resolve_color(self.fill)))
        painter.drawRoundedRect(body.adjusted(half, half, -half, -half), max(0.0, self.radius - half),
                                max(0.0, self.radius - half))


class HalftoneHeader(QFrame):
    """Header strip: the theme's header colour with halftone dots and a 3 px ink rule."""

    def __init__(self, corner: float = 3, scale: float = 1.0) -> None:
        super().__init__()
        self.corner = corner
        self.scale = scale
        self.rule = max(1, round(3 * scale))

    def paintEvent(self, _event: object) -> None:  # noqa: N802 - Qt API
        t = T()
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        rect = QRectF(self.rect())
        path = rounded_rect_path(rect.x(), rect.y(), rect.width(), rect.height(), (self.corner, self.corner, 0, 0))
        painter.setClipPath(path)
        painter.fillRect(rect, QColor(t.header))
        r, g, b, a = t.header_dots
        draw_halftone(painter, rect, QColor(r, g, b, round(a * 255)), 1.6 * self.scale, 7 * self.scale)
        painter.fillRect(QRectF(rect.left(), rect.bottom() - self.rule + 1, rect.width(), self.rule), QColor(t.ink))


class ComicText(QWidget):
    """Display text with an ink stroke and a hard drop shadow (Bangers titles, agent names)."""

    def __init__(self, text: str, font: QFont, fill: str, stroke: float = 0.0, stroke_color: str = "#111111",
                 shadow: int = 0, elide: bool = False) -> None:
        super().__init__()
        self.text = text
        self.font_ = font
        self.fill = fill
        self.stroke = stroke
        self.stroke_color = stroke_color
        self.shadow = shadow
        self.elide = elide
        self.setAttribute(Qt.WidgetAttribute.WA_TransparentForMouseEvents)
        policy = QSizePolicy.Policy.Ignored if elide else QSizePolicy.Policy.Fixed
        self.setSizePolicy(policy, QSizePolicy.Policy.Fixed)

    def set_text(self, text: str) -> None:
        self.text = text
        self.updateGeometry()
        self.update()

    def sizeHint(self) -> QSize:  # noqa: N802 - Qt API
        metrics = QFontMetricsF(self.font_)
        width = metrics.horizontalAdvance(self.text) + self.stroke + self.shadow
        height = metrics.ascent() + metrics.descent() + self.stroke * 2 + self.shadow
        return QSize(math.ceil(width), math.ceil(height))

    def minimumSizeHint(self) -> QSize:  # noqa: N802 - Qt API
        hint = self.sizeHint()
        return QSize(40 if self.elide else hint.width(), hint.height())

    def paintEvent(self, _event: object) -> None:  # noqa: N802 - Qt API
        font = QFont(self.font_)
        metrics = QFontMetricsF(font)
        text = self.text
        room = self.width() - self.stroke - self.shadow
        if self.elide:
            # Shrink (down to 60 %) before eliding, so a busy header keeps the whole title.
            minimum = round(self.font_.pixelSize() * 0.6)
            while metrics.horizontalAdvance(text) > room and font.pixelSize() > minimum:
                font.setPixelSize(font.pixelSize() - 1)
                metrics = QFontMetricsF(font)
            if metrics.horizontalAdvance(text) > room:
                text = metrics.elidedText(text, Qt.TextElideMode.ElideRight, room)
        baseline = (self.height() + metrics.ascent() - metrics.descent()) / 2
        path = QPainterPath()
        path.addText(QPointF(self.stroke / 2, baseline), font, text)
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        pen = QPen(QColor(resolve_color(self.stroke_color)), self.stroke)
        pen.setJoinStyle(Qt.PenJoinStyle.RoundJoin)
        if self.shadow:
            shadow = QColor(T().shadow)
            painter.save()
            painter.translate(self.shadow, self.shadow)
            painter.fillPath(path, shadow)
            if self.stroke:
                shadow_pen = QPen(pen)
                shadow_pen.setColor(shadow)
                painter.strokePath(path, shadow_pen)
            painter.restore()
        painter.fillPath(path, QColor(resolve_color(self.fill)))
        if self.stroke:
            painter.strokePath(path, pen)


class ComicBadge(QWidget):
    """The tilted LIVE / ALERT / IDLE sticker in the header."""

    TILT = -4.0

    def __init__(self, scale: float = 1.0) -> None:
        super().__init__()
        self.text = "● IDLE"
        self.bg = "#8E8BA6"
        self.fg = theme.INK_ON_COLOUR
        self.k = scale
        self.font_ = display_font(16 * scale, 1.0 * scale)
        self.setAttribute(Qt.WidgetAttribute.WA_TransparentForMouseEvents)
        self.setSizePolicy(QSizePolicy.Policy.Fixed, QSizePolicy.Policy.Fixed)

    def set_badge(self, text: str, bg: str, fg: str) -> None:
        if (text, bg, fg) == (self.text, self.bg, self.fg):
            return
        self.text, self.bg, self.fg = text, bg, fg
        self.updateGeometry()
        self.update()

    def box_size(self) -> tuple[float, float]:
        metrics = QFontMetricsF(self.font_)
        k = self.k
        return metrics.horizontalAdvance(self.text) + 23 * k, metrics.height() + 9 * k

    def sizeHint(self) -> QSize:  # noqa: N802 - Qt API
        width, height = self.box_size()
        return QSize(math.ceil(width + 6 * self.k), math.ceil(height + 8 * self.k))

    def paintEvent(self, _event: object) -> None:  # noqa: N802 - Qt API
        width, height = self.box_size()
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        k = self.k
        painter.translate(self.width() / 2 - k, self.height() / 2 - k)
        painter.rotate(self.TILT)
        box = QRectF(-width / 2, -height / 2, width, height)
        painter.setPen(Qt.PenStyle.NoPen)
        painter.setBrush(QColor(T().shadow))
        painter.drawRoundedRect(box.translated(2 * k, 2 * k), 4 * k, 4 * k)
        painter.setPen(ink_pen(T().ink, 2.5 * k))
        painter.setBrush(QColor(self.bg))
        painter.drawRoundedRect(box.adjusted(1.25 * k, 1.25 * k, -1.25 * k, -1.25 * k), 3 * k, 3 * k)
        painter.setPen(QColor(self.fg))
        mark, _space, label = self.text.partition(" ")
        if mark in ("●", "▲") and label:
            # Bangers has no ● / ▲: draw the mark small and centred like the browser fallback.
            metrics = QFontMetricsF(self.font_)
            mark_font = body_font(10 * self.k)
            mark_w = QFontMetricsF(mark_font).horizontalAdvance(mark) + 5 * self.k
            start = -(mark_w + metrics.horizontalAdvance(label)) / 2
            painter.setFont(mark_font)
            painter.drawText(QRectF(start, box.top(), mark_w, box.height()),
                             Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter, mark)
            painter.setFont(self.font_)
            painter.drawText(QRectF(start + mark_w, box.top() + 2 * self.k, box.width(), box.height()),
                             Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter, label)
            return
        painter.setFont(self.font_)
        painter.drawText(box.adjusted(0, 2, 0, 0), Qt.AlignmentFlag.AlignCenter, self.text)


class ComicButton(QAbstractButton):
    """Ink-outlined button with a 2 px hard shadow that "sinks" into it while pressed."""

    def __init__(self, text: str, *, size: int | None = None, bg: str = "inner", fg: str = "text",
                 hover_bg: str | None = None, font: QFont | None = None, padding: tuple[int, int] = (4, 12),
                 radius: float = 4, border: float = 2.5, shadow: int = 2, scale: float = 1.0) -> None:
        super().__init__()
        self.setText(text)
        self.square = size
        self.bg = bg
        self.fg = fg
        self.hover_bg = hover_bg
        self.font_ = font or body_font(13)
        self.padding = (padding[0] * scale, padding[1] * scale)
        self.radius = radius * scale
        self.border = border * scale
        self.shadow = max(1, round(shadow * scale))
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.setFocusPolicy(Qt.FocusPolicy.NoFocus)
        self.setSizePolicy(QSizePolicy.Policy.Fixed, QSizePolicy.Policy.Fixed)

    def sizeHint(self) -> QSize:  # noqa: N802 - Qt API
        if self.square:
            return QSize(self.square + self.shadow, self.square + self.shadow)
        metrics = QFontMetricsF(self.font_)
        vertical, horizontal = self.padding
        width = metrics.horizontalAdvance(self.text()) + 2 * horizontal + 2 * self.border + self.shadow
        height = metrics.height() + 2 * vertical + 2 * self.border + self.shadow
        return QSize(math.ceil(width), math.ceil(height))

    def enterEvent(self, event: object) -> None:  # noqa: N802 - Qt API
        self.update()
        super().enterEvent(event)

    def leaveEvent(self, event: object) -> None:  # noqa: N802 - Qt API
        self.update()
        super().leaveEvent(event)

    def paintEvent(self, _event: object) -> None:  # noqa: N802 - Qt API
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        if not self.isEnabled():
            painter.setOpacity(0.5)
        pressed = self.isDown()
        body = QRectF(0, 0, self.width() - self.shadow, self.height() - self.shadow)
        if pressed:
            body.translate(self.shadow, self.shadow)
        elif self.shadow:
            painter.setPen(Qt.PenStyle.NoPen)
            painter.setBrush(QColor(T().shadow))
            painter.drawRoundedRect(body.translated(self.shadow, self.shadow), self.radius, self.radius)
        hovered = self.underMouse() and self.isEnabled() and self.hover_bg is not None
        half = self.border / 2
        painter.setPen(ink_pen(T().ink, self.border))
        painter.setBrush(QColor(resolve_color(self.hover_bg if hovered else self.bg)))
        painter.drawRoundedRect(body.adjusted(half, half, -half, -half), max(0.0, self.radius - half),
                                max(0.0, self.radius - half))
        painter.setPen(QColor(resolve_color(self.fg)))
        painter.setFont(self.font_)
        painter.drawText(body.adjusted(0, 1, 0, 0), Qt.AlignmentFlag.AlignCenter, self.text())


class RadarLogo(QWidget):
    """The comic radar mark: ink ring, inner ring, red sweep (``angle`` animates it), centre dot."""

    BASE = 30.0

    def __init__(self, size: int = 30) -> None:
        super().__init__()
        self.setFixedSize(size, size)
        self.setAttribute(Qt.WidgetAttribute.WA_TransparentForMouseEvents)
        self.angle = 0.0

    def queue_draw(self) -> None:
        self.update()

    def paintEvent(self, _event: object) -> None:  # noqa: N802 - Qt API
        t = T()
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        painter.scale(self.width() / self.BASE, self.height() / self.BASE)
        center = QPointF(15, 15)
        painter.setPen(Qt.PenStyle.NoPen)
        painter.setBrush(QColor(t.inner))
        painter.drawEllipse(center, 14, 14)
        clip = QPainterPath()
        clip.addEllipse(center, 12.5, 12.5)
        painter.save()
        painter.setClipPath(clip)
        painter.setPen(ink_pen(t.ink, 2))
        painter.setBrush(Qt.BrushStyle.NoBrush)
        painter.drawEllipse(center, 5.5, 5.5)
        painter.translate(center)
        painter.rotate(-40 + math.degrees(self.angle))
        painter.fillRect(QRectF(0, -1.25, 13, 2.5), QColor(theme.RED))
        painter.restore()
        painter.setPen(Qt.PenStyle.NoPen)
        painter.setBrush(QColor(theme.INK_ON_COLOUR))
        painter.drawEllipse(center, 3, 3)
        painter.setPen(ink_pen(t.ink, 2.5))
        painter.setBrush(Qt.BrushStyle.NoBrush)
        painter.drawEllipse(center, 13.75, 13.75)


class AgentCircle(QAbstractButton):
    """Agent/provider logo printed in ink on a disc of the agent colour.

    Usage blocks make it the "refresh usage" button (and spin it via ``angle`` while
    refreshing); session rows show it as a plain, click-through badge.
    """

    def __init__(self, diameter: int, color: str, logo: QPixmap | None, initial: str = "",
                 shadow: int = 0, interactive: bool = False, border: float = 2.5) -> None:
        super().__init__()
        self.border = border
        self.diameter = diameter
        self.color = color
        self.logo = tinted(logo, theme.INK_ON_COLOUR) if logo is not None else None
        self.initial = initial
        self.shadow = shadow
        self.angle = 0.0
        self.setFixedSize(diameter + shadow, diameter + shadow)
        self.setFocusPolicy(Qt.FocusPolicy.NoFocus)
        if interactive:
            self.setCursor(Qt.CursorShape.PointingHandCursor)
        else:
            self.setAttribute(Qt.WidgetAttribute.WA_TransparentForMouseEvents)

    def queue_draw(self) -> None:
        self.update()

    def paintEvent(self, _event: object) -> None:  # noqa: N802 - Qt API
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        painter.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform)
        radius = self.diameter / 2
        center = QPointF(radius, radius)
        if self.isDown():
            center += QPointF(self.shadow, self.shadow)
        elif self.shadow:
            painter.setPen(Qt.PenStyle.NoPen)
            painter.setBrush(QColor(T().shadow))
            painter.drawEllipse(center + QPointF(self.shadow, self.shadow), radius, radius)
        painter.setPen(ink_pen(T().ink, self.border))
        painter.setBrush(QColor(self.color))
        painter.drawEllipse(center, radius - self.border / 2, radius - self.border / 2)
        painter.save()
        painter.translate(center)
        painter.rotate(math.degrees(self.angle))
        if self.logo is not None:
            size = self.logo.deviceIndependentSize()
            painter.drawPixmap(QPointF(-size.width() / 2, -size.height() / 2), self.logo)
        elif self.initial:
            painter.setPen(QColor(theme.INK_ON_COLOUR))
            painter.setFont(display_font(self.diameter * 0.52))
            box = QRectF(-radius, -radius, self.diameter, self.diameter)
            painter.drawText(box, Qt.AlignmentFlag.AlignCenter, self.initial)
        painter.restore()


class ComicBar(QWidget):
    """Quota bar: ink outline, track, halftone fill and an ink edge where the fill ends."""

    def __init__(self, fraction: float, color: str, scale: float = 1.0) -> None:
        super().__init__()
        self.fraction = max(0.0, min(1.0, fraction))
        self.color = color
        self.k = scale
        self.setFixedHeight(max(6, round(12 * scale)))
        self.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Fixed)

    def paintEvent(self, _event: object) -> None:  # noqa: N802 - Qt API
        t = T()
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        k = self.k
        border = max(1.4, 2 * k)
        outer = QRectF(self.rect()).adjusted(border / 2, border / 2, -border / 2, -border / 2)
        painter.setPen(ink_pen(t.ink, border))
        painter.setBrush(QColor(t.track))
        painter.drawRoundedRect(outer, 3 * k, 3 * k)
        inner = outer.adjusted(border / 2, border / 2, -border / 2, -border / 2)
        clip = QPainterPath()
        clip.addRoundedRect(inner, 2 * k, 2 * k)
        painter.setClipPath(clip)
        fill = QRectF(inner.left(), inner.top(), inner.width() * self.fraction, inner.height())
        if fill.width() > 0:
            painter.fillRect(fill, QColor(self.color))
            draw_halftone(painter, fill, QColor(17, 17, 17, 77), max(0.8, 1.0 * k), max(3.5, 5 * k))
            if self.fraction < 1.0:
                painter.fillRect(QRectF(fill.right(), inner.top(), border, inner.height()), QColor(t.ink))


class Chip(QWidget):
    """Status chip: Comic Neue on a colour fill with a 2 px ink outline; elides when narrow."""

    def __init__(self, text: str, bg: str, fg: str, scale: float = 1.0) -> None:
        super().__init__()
        self.text = text
        self.bg = bg
        self.fg = fg
        self.k = scale
        self.font_ = body_font(max(MIN_TEXT_PX + 1, 14 * scale))
        self.setAttribute(Qt.WidgetAttribute.WA_TransparentForMouseEvents)
        self.setSizePolicy(QSizePolicy.Policy.Preferred, QSizePolicy.Policy.Fixed)

    def sizeHint(self) -> QSize:  # noqa: N802 - Qt API
        metrics = QFontMetricsF(self.font_)
        return QSize(math.ceil(metrics.horizontalAdvance(self.text) + 18 * self.k),
                     math.ceil(metrics.height() + 6 * self.k))

    def minimumSizeHint(self) -> QSize:  # noqa: N802 - Qt API
        return QSize(min(60, self.sizeHint().width()), self.sizeHint().height())

    def paintEvent(self, _event: object) -> None:  # noqa: N802 - Qt API
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        border = max(1.4, 2 * self.k)
        box = QRectF(self.rect()).adjusted(border / 2, border / 2, -border / 2, -border / 2)
        painter.setPen(ink_pen(T().ink, border))
        painter.setBrush(QColor(self.bg))
        painter.drawRoundedRect(box, 3 * self.k, 3 * self.k)
        painter.setPen(QColor(self.fg))
        painter.setFont(self.font_)
        metrics = QFontMetricsF(self.font_)
        text = metrics.elidedText(self.text, Qt.TextElideMode.ElideRight, box.width() - 14 * self.k)
        painter.drawText(box, Qt.AlignmentFlag.AlignCenter, text)


class ComicSwitch(QAbstractButton):
    """On/off pill: ink outline and knob, green track when on."""

    def __init__(self, checked: bool = False) -> None:
        super().__init__()
        self.setCheckable(True)
        self.setChecked(checked)
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.setFocusPolicy(Qt.FocusPolicy.NoFocus)
        self.setFixedSize(48, 28)

    def sizeHint(self) -> QSize:  # noqa: N802 - Qt API
        return QSize(48, 28)

    def paintEvent(self, _event: object) -> None:  # noqa: N802 - Qt API
        t = T()
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        track = QRectF(1.25, 1.25, 44, 23.5)
        painter.setPen(Qt.PenStyle.NoPen)
        painter.setBrush(QColor(t.shadow))
        painter.drawRoundedRect(track.translated(2, 2), 12, 12)
        on = self.isChecked()
        painter.setPen(ink_pen(t.ink, 2.5))
        painter.setBrush(QColor("#4ADE80" if on else t.track))
        painter.drawRoundedRect(track, 11.75, 11.75)
        knob = 15.0
        x = track.right() - knob - 4 if on else track.left() + 4
        painter.setPen(ink_pen(t.ink, 2))
        painter.setBrush(QColor(theme.WHITE if on else t.inner))
        painter.drawEllipse(QRectF(x, track.center().y() - knob / 2, knob, knob))


class ComicCheck(QAbstractButton):
    """Checkbox with an ink box, a yellow fill and a hand-drawn tick, plus an agent disc."""

    def __init__(self, text: str, color: str, logo: QPixmap | None) -> None:
        super().__init__()
        self.setText(text)
        self.setCheckable(True)
        self.color = color
        self.logo = tinted(logo, theme.INK_ON_COLOUR) if logo is not None else None
        self.font_ = body_font(14)
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.setFocusPolicy(Qt.FocusPolicy.NoFocus)

    def sizeHint(self) -> QSize:  # noqa: N802 - Qt API
        metrics = QFontMetricsF(self.font_)
        return QSize(math.ceil(20 + 8 + 22 + 6 + metrics.horizontalAdvance(self.text()) + 4), 26)

    def paintEvent(self, _event: object) -> None:  # noqa: N802 - Qt API
        t = T()
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        box = QRectF(1.25, 4.25, 17.5, 17.5)
        painter.setPen(ink_pen(t.ink, 2.5))
        painter.setBrush(QColor(theme.YELLOW if self.isChecked() else t.inner))
        painter.drawRoundedRect(box, 3, 3)
        if self.isChecked():
            tick = QPainterPath()
            tick.moveTo(box.left() + 4, box.center().y())
            tick.lineTo(box.left() + 7.5, box.bottom() - 4.5)
            tick.lineTo(box.right() - 3.5, box.top() + 4)
            pen = QPen(QColor(theme.INK_ON_COLOUR), 2.6)
            pen.setCapStyle(Qt.PenCapStyle.RoundCap)
            pen.setJoinStyle(Qt.PenJoinStyle.RoundJoin)
            painter.setPen(pen)
            painter.setBrush(Qt.BrushStyle.NoBrush)
            painter.drawPath(tick)
        center = QPointF(28 + 11, 13)
        painter.setPen(ink_pen(t.ink, 2))
        painter.setBrush(QColor(self.color))
        painter.drawEllipse(center, 10, 10)
        if self.logo is not None:
            size = self.logo.deviceIndependentSize()
            painter.drawPixmap(center - QPointF(size.width() / 2, size.height() / 2), self.logo)
        painter.setPen(QColor(t.text))
        painter.setFont(self.font_)
        painter.drawText(QRectF(28 + 22 + 6, 0, self.width(), self.height()),
                         Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter, self.text())


class ElidedLabel(QLabel):
    """Single-line label that ends in "…" when narrower than its text."""

    def __init__(self, text: str = "", color: str = "text") -> None:
        super().__init__()
        self.full_text = text
        self.color = color
        self.setSizePolicy(QSizePolicy.Policy.Preferred, QSizePolicy.Policy.Fixed)
        self.setText(text)

    def set_full_text(self, text: str) -> None:
        self.full_text = text
        self.setText(text)
        self.update()

    def minimumSizeHint(self) -> QSize:  # noqa: N802 - Qt API
        hint = super().minimumSizeHint()
        return QSize(min(hint.width(), self.fontMetrics().horizontalAdvance("…") + 2), hint.height())

    def paintEvent(self, _event: object) -> None:  # noqa: N802 - Qt API
        painter = QPainter(self)
        painter.setPen(QColor(resolve_color(self.color)))
        rect = self.contentsRect()
        elided = self.fontMetrics().elidedText(self.full_text, Qt.TextElideMode.ElideRight, rect.width())
        painter.drawText(rect, int(self.alignment()), elided)


class HoverBox(QWidget):
    """Row container reporting pointer enter/leave (shows the row's last sticker)."""

    def __init__(self, on_enter: Callable[["HoverBox"], None], on_leave: Callable[["HoverBox"], None]) -> None:
        super().__init__()
        self.on_enter = on_enter
        self.on_leave = on_leave

    def enterEvent(self, event: object) -> None:  # noqa: N802 - Qt API
        self.on_enter(self)
        super().enterEvent(event)

    def leaveEvent(self, event: object) -> None:  # noqa: N802 - Qt API
        self.on_leave(self)
        super().leaveEvent(event)


# ---- GIF sticker: a tilted polaroid with a sound-effect caption, plus a speech bubble ----
# Geometry follows the comic handoff: the sticker block's right edge sits 14 px outside the
# card's right edge and its bottom 22 px below the card's top edge.
POLAROID_IMAGE = (124, 96)
POLAROID_IMAGE_BORDER = 2
POLAROID_PADDING = (7, 7, 22)  # sides, top, bottom
POLAROID_BORDER = 3
POLAROID_WIDTH = POLAROID_IMAGE[0] + 2 * POLAROID_IMAGE_BORDER + 2 * POLAROID_PADDING[0] + 2 * POLAROID_BORDER
POLAROID_HEIGHT = (POLAROID_IMAGE[1] + 2 * POLAROID_IMAGE_BORDER + POLAROID_PADDING[1] + POLAROID_PADDING[2]
                   + 2 * POLAROID_BORDER)
POLAROID_SHADOW = 5
POLAROID_TILT_DEG = 5.0
BUBBLE_TEXT_WIDTH = 170
BUBBLE_PADDING = (8, 12, 7)  # top, sides, bottom
BUBBLE_BORDER = 3
BUBBLE_RADIUS = 18
BUBBLE_TILT_DEG = -5.0
BUBBLE_LIFT = 34      # bubble bottom sits this far above the polaroid's bottom
BUBBLE_GAP = 10
STICKER_RIGHT_OVERHANG = 14
# The handoff tucks the polaroid 22 px into the card; the 70 % card would put its status chip
# under the full-size polaroid, so it only overlaps the card's top edge.
STICKER_BOTTOM_BELOW_CARD_TOP = 4
OVERLAY_PAD = 26
OVERLAY_SLIDE_ROOM = 40
POP_IN_MS = 500
BUBBLE_DELAY_MS = 80
TUCK_AWAY_MS = 200
STICKER_HOLD_MS = 4000
STICKER_DEBOUNCE_MS = 500
STICKER_FRAME_MS = 16


def cubic_bezier(x1: float, y1: float, x2: float, y2: float) -> Callable[[float], float]:
    """CSS ``cubic-bezier()`` timing function (y may overshoot)."""
    def coordinate(t: float, a: float, b: float) -> float:
        return 3 * a * (1 - t) ** 2 * t + 3 * b * (1 - t) * t * t + t ** 3

    def solve(x: float) -> float:
        if x <= 0.0 or x >= 1.0:
            return 0.0 if x <= 0.0 else 1.0
        low, high = 0.0, 1.0
        for _ in range(40):
            middle = (low + high) / 2
            if coordinate(middle, x1, x2) < x:
                low = middle
            else:
                high = middle
        return coordinate((low + high) / 2, y1, y2)

    return lambda x: solve(max(0.0, min(1.0, x)))


POP_EASING = cubic_bezier(0.3, 1.6, 0.5, 1.0)


def pop_transform(progress: float) -> tuple[float, float]:
    """The handoff's ``pop`` keyframes: scale .6 → 1.08 (70 %) → 1, opacity 0 → 1.

    As in CSS, the timing function applies within each keyframe segment."""
    progress = max(0.0, min(1.0, progress))
    if progress < 0.7:
        scale = 0.6 + 0.48 * POP_EASING(progress / 0.7)
    else:
        scale = 1.08 - 0.08 * POP_EASING((progress - 0.7) / 0.3)
    return scale, max(0.0, min(1.0, POP_EASING(progress)))


def ease_out_back(progress: float) -> float:
    """Kept for callers of the earlier sticker motion."""
    c1 = 1.70158
    c3 = c1 + 1
    t = max(0.0, min(1.0, progress)) - 1
    return 1 + c3 * t * t * t + c1 * t * t


class StickerOverlay(QWidget):
    """Transparent, click-through window: a tilted polaroid GIF sticker and a speech bubble.

    It lives in its own window so the card never changes size or shifts. KLIPY media arrives
    as bytes and is decoded from memory (QBuffer); it is never written to disk.
    """

    WIDTH = OVERLAY_PAD + BUBBLE_TEXT_WIDTH + 2 * (BUBBLE_PADDING[1] + BUBBLE_BORDER) + BUBBLE_GAP \
        + POLAROID_WIDTH + OVERLAY_PAD
    HEIGHT = OVERLAY_PAD + POLAROID_HEIGHT + OVERLAY_SLIDE_ROOM + OVERLAY_PAD

    def __init__(self, tilt: float = POLAROID_TILT_DEG) -> None:
        super().__init__(None, Qt.WindowType.ToolTip | Qt.WindowType.FramelessWindowHint
                         | Qt.WindowType.WindowStaysOnTopHint | Qt.WindowType.WindowTransparentForInput
                         | Qt.WindowType.WindowDoesNotAcceptFocus)
        self.setObjectName("stickerOverlay")
        prepare_floating_window(self)
        self.setAttribute(Qt.WidgetAttribute.WA_ShowWithoutActivating)
        self.setAttribute(Qt.WidgetAttribute.WA_TransparentForMouseEvents)
        self.setFixedSize(self.WIDTH, self.HEIGHT)

        self.tilt = tilt
        self.choice: stickers.StickerChoice | None = None
        self.color = theme.bubble_fill("idle")
        self.sfx = ""
        self.frame: QImage | None = None
        self.movie: QMovie | None = None
        self.buffer: QBuffer | None = None
        self.phase = "hidden"  # hidden → in → shown → out → hidden
        self.phase_started = 0.0
        self.sticky = False
        self.reduced_motion = False
        self.tick_source: QTimer | None = None
        self.hold_source: QTimer | None = None

    @property
    def visible(self) -> bool:
        return self.phase != "hidden"

    def polaroid_rect(self) -> QRectF:
        """The untransformed polaroid box inside the overlay."""
        right = self.WIDTH - OVERLAY_PAD
        bottom = self.HEIGHT - OVERLAY_PAD - OVERLAY_SLIDE_ROOM
        return QRectF(right - POLAROID_WIDTH, bottom - POLAROID_HEIGHT, POLAROID_WIDTH, POLAROID_HEIGHT)

    def place_for_card(self, card_right: int, card_top: int, overlap: int = STICKER_BOTTOM_BELOW_CARD_TOP) -> None:
        """Sticker block's right edge 14 px outside the card, its bottom ``overlap`` px below the card's top."""
        box = self.polaroid_rect()
        self.move(round(card_right + STICKER_RIGHT_OVERHANG - box.right()),
                  round(card_top + overlap - box.bottom()))

    def stop_movie(self) -> None:
        if self.movie is not None:
            self.movie.stop()
            self.movie.deleteLater()
        self.movie = None
        self.buffer = None

    def load_image(self, choice: stickers.StickerChoice) -> None:
        """Load a local file, or KLIPY media straight from memory (it is never written to disk)."""
        self.stop_movie()
        self.frame = None
        if choice.image is None and choice.data is None:
            return
        movie = QMovie()
        if choice.data is not None:
            self.buffer = QBuffer()
            self.buffer.setData(QByteArray(bytes(choice.data)))
            self.buffer.open(QIODevice.OpenModeFlag.ReadOnly)
            movie.setDevice(self.buffer)
        else:
            movie.setFileName(str(choice.image))
        if not movie.isValid() or not movie.jumpToFrame(0):
            log(f"sticker: cannot load {choice.label}")
            self.buffer = None
            return
        self.frame = movie.currentImage()
        if self.frame.isNull():
            log(f"sticker: cannot decode {choice.label}")
            self.frame = None
            self.buffer = None
            return
        if movie.frameCount() == 1:
            log(f"sticker: {choice.label} is a still image (no animation frames)")
            self.buffer = None
            return
        movie.frameChanged.connect(self.on_frame)
        self.movie = movie
        movie.start()

    def on_frame(self, _number: int) -> None:
        if self.movie is None or not self.visible:
            return
        self.frame = self.movie.currentImage()
        self.update()

    def present_sticker(self, choice: stickers.StickerChoice, sticky: bool, hold_ms: int | None = STICKER_HOLD_MS) -> None:
        """Pop a sticker in. `hold_ms=None` keeps it until `tuck()` (hover, sticky states)."""
        source_remove(self.hold_source)
        self.hold_source = None
        self.choice = choice
        self.color = theme.bubble_fill(choice.key)
        self.sfx = random.choice(stickers.STICKER_SFX.get(choice.key, ("!",)))
        self.sticky = sticky
        self.load_image(choice)
        self.phase = "in"
        self.phase_started = monotonic_ms()
        self.show()
        self.update()
        self.start_tick()
        if not sticky and hold_ms is not None:
            self.hold_source = timeout_add(hold_ms, self.on_hold_done)

    def on_hold_done(self) -> bool:
        self.hold_source = None
        self.tuck()
        return False

    def tuck(self) -> None:
        if self.phase in ("hidden", "out"):
            return
        source_remove(self.hold_source)
        self.hold_source = None
        self.phase = "out"
        self.phase_started = monotonic_ms()
        self.start_tick()

    def hide_now(self) -> None:
        for name in ("hold_source", "tick_source"):
            source_remove(getattr(self, name))
            setattr(self, name, None)
        self.stop_movie()
        self.phase = "hidden"
        self.choice = None
        self.frame = None
        self.hide()

    def start_tick(self) -> None:
        if self.tick_source is None:
            self.tick_source = timeout_add(STICKER_FRAME_MS, self.on_tick)

    def elapsed_ms(self) -> float:
        return monotonic_ms() - self.phase_started

    def on_tick(self) -> bool:
        elapsed = self.elapsed_ms()
        if self.phase == "in" and elapsed >= POP_IN_MS + BUBBLE_DELAY_MS:
            self.phase = "shown"
        elif self.phase == "out" and elapsed >= TUCK_AWAY_MS:
            self.tick_source = None
            self.hide_now()
            return False
        self.update()
        if self.phase == "shown":
            self.tick_source = None
            return False
        return True

    def transform(self, delay_ms: float = 0.0) -> tuple[float, float, float]:
        """(scale, opacity, y offset) for the current animation phase."""
        elapsed = self.elapsed_ms()
        if self.phase == "in":
            progress = max(0.0, elapsed - delay_ms) / POP_IN_MS
            if self.reduced_motion:
                return 1.0, min(1.0, progress), 0.0
            scale, opacity = pop_transform(progress)
            return scale, opacity, 0.0
        if self.phase == "out":
            progress = min(1.0, elapsed / TUCK_AWAY_MS)
            if self.reduced_motion:
                return 1.0, 1.0 - progress, 0.0
            eased = progress * progress
            return 1.0 - 0.1 * eased, 1.0 - eased, OVERLAY_SLIDE_ROOM * eased
        return 1.0, 1.0, 0.0

    def paintEvent(self, _event: object) -> None:  # noqa: N802 - Qt API
        if self.choice is None or not self.visible:
            return
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        painter.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform)
        if self.choice.bubble:
            self.draw_bubble(painter)
        self.draw_polaroid(painter)

    def draw_polaroid(self, painter: QPainter) -> None:
        scale, opacity, dy = self.transform()
        if opacity <= 0:
            return
        box = self.polaroid_rect()
        painter.save()
        painter.translate(box.center().x(), box.center().y() + dy)
        painter.rotate(self.tilt)
        painter.scale(scale, scale)
        painter.setOpacity(opacity)
        half_w, half_h = POLAROID_WIDTH / 2, POLAROID_HEIGHT / 2
        frame = QRectF(-half_w, -half_h, POLAROID_WIDTH, POLAROID_HEIGHT)
        painter.fillRect(frame.translated(POLAROID_SHADOW, POLAROID_SHADOW), QColor(T().shadow))
        half = POLAROID_BORDER / 2
        painter.setPen(ink_pen(theme.POLAROID_INK, POLAROID_BORDER))
        painter.setBrush(QColor(theme.POLAROID))
        painter.drawRect(frame.adjusted(half, half, -half, -half))

        side, top, _bottom = POLAROID_PADDING
        image_box = QRectF(frame.left() + POLAROID_BORDER + side, frame.top() + POLAROID_BORDER + top,
                           POLAROID_IMAGE[0] + 2 * POLAROID_IMAGE_BORDER, POLAROID_IMAGE[1] + 2 * POLAROID_IMAGE_BORDER)
        image = image_box.adjusted(POLAROID_IMAGE_BORDER, POLAROID_IMAGE_BORDER,
                                   -POLAROID_IMAGE_BORDER, -POLAROID_IMAGE_BORDER)
        painter.save()
        painter.setClipRect(image)
        if self.frame is not None and not self.frame.isNull():
            width, height = self.frame.width(), self.frame.height()
            cover = max(image.width() / width, image.height() / height)
            target = QRectF(image.center().x() - width * cover / 2, image.center().y() - height * cover / 2,
                            width * cover, height * cover)
            painter.drawImage(target, self.frame)
        else:
            self.draw_placeholder(painter, image)
        if self.choice is not None and self.choice.source == "klipy":
            self.draw_klipy_mark(painter, image)
        painter.restore()
        painter.setPen(ink_pen(theme.POLAROID_INK, POLAROID_IMAGE_BORDER))
        painter.setBrush(Qt.BrushStyle.NoBrush)
        painter.drawRect(image_box.adjusted(1, 1, -1, -1))

        if self.sfx:
            painter.setFont(display_font(13, 1.0))
            painter.setPen(QColor(theme.INK_ON_COLOUR))
            caption = QRectF(frame.left(), frame.bottom() - POLAROID_BORDER - 4 - 18, frame.width(), 18)
            painter.drawText(caption, Qt.AlignmentFlag.AlignHCenter | Qt.AlignmentFlag.AlignBottom, self.sfx)
        painter.restore()

    def draw_klipy_mark(self, painter: QPainter, image: QRectF) -> None:
        """Small "KLIPY" attribution mark in the image's bottom-right corner."""
        font = comic_font(MONO_FAMILIES, 7, QFont.Weight.Bold)
        metrics = QFontMetricsF(font)
        text_w, text_h = metrics.horizontalAdvance("KLIPY"), metrics.height()
        x = image.right() - text_w - 7
        y = image.bottom() - text_h - 4
        painter.setPen(Qt.PenStyle.NoPen)
        painter.setBrush(QColor(0, 0, 0, 115))
        painter.drawRoundedRect(QRectF(x - 4, y - 1, text_w + 8, text_h + 2), 3, 3)
        painter.setFont(font)
        painter.setPen(QColor(255, 255, 255, 230))
        painter.drawText(QRectF(x, y, text_w + 1, text_h), Qt.AlignmentFlag.AlignLeft, "KLIPY")

    @staticmethod
    def draw_placeholder(painter: QPainter, rect: QRectF) -> None:
        """The handoff's empty-photo look: beige 45° stripes."""
        painter.fillRect(rect, QColor("#EEE7D0"))
        painter.setPen(QPen(QColor("#E2D9BC"), 6 * math.sqrt(2) / 2))
        step = 12 * math.sqrt(2)
        offset = -rect.height()
        while offset < rect.width() + rect.height():
            painter.drawLine(QPointF(rect.left() + offset, rect.bottom()),
                             QPointF(rect.left() + offset + rect.height(), rect.top()))
            offset += step

    def draw_bubble(self, painter: QPainter) -> None:
        scale, opacity, dy = self.transform(delay_ms=BUBBLE_DELAY_MS if self.phase == "in" else 0.0)
        if opacity <= 0 or self.choice is None:
            return
        font = display_font(18, 0.8)
        layout, text_w, text_h = text_block(self.choice.bubble, font, BUBBLE_TEXT_WIDTH, line_height=18 * 1.05)
        pad_top, pad_side, pad_bottom = BUBBLE_PADDING
        width = text_w + 2 * (pad_side + BUBBLE_BORDER)
        height = text_h + pad_top + pad_bottom + 2 * BUBBLE_BORDER
        box = self.polaroid_rect()
        right = box.left() - BUBBLE_GAP
        bottom = box.bottom() - BUBBLE_LIFT + dy
        painter.save()
        painter.translate(right - width / 2, bottom - height / 2)
        painter.rotate(BUBBLE_TILT_DEG)
        painter.scale(scale, scale)
        painter.setOpacity(opacity)
        body = QRectF(-width / 2, -height / 2, width, height)
        painter.setPen(Qt.PenStyle.NoPen)
        painter.setBrush(QColor(T().shadow))
        painter.drawRoundedRect(body.translated(3, 3), BUBBLE_RADIUS, BUBBLE_RADIUS)
        half = BUBBLE_BORDER / 2
        painter.setPen(ink_pen(theme.POLAROID_INK, BUBBLE_BORDER))
        painter.setBrush(QColor(self.color))
        painter.drawRoundedRect(body.adjusted(half, half, -half, -half), BUBBLE_RADIUS - half, BUBBLE_RADIUS - half)
        # Tail on the right, pointing at the polaroid: fill over the outline, ink its two outer edges.
        base_top = QPointF(body.right() - BUBBLE_BORDER - 1, body.bottom() - 30)
        base_bottom = QPointF(body.right() - BUBBLE_BORDER - 1, body.bottom() - 12)
        tip = QPointF(body.right() + 12, body.bottom() - 19)
        painter.setPen(Qt.PenStyle.NoPen)
        painter.drawPolygon(QPolygonF([base_top, tip, base_bottom]))
        tail_pen = ink_pen(theme.POLAROID_INK, BUBBLE_BORDER)
        tail_pen.setJoinStyle(Qt.PenJoinStyle.RoundJoin)
        painter.setPen(tail_pen)
        painter.drawPolyline(QPolygonF([base_top + QPointF(1, 0), tip, base_bottom + QPointF(1, 0)]))
        painter.setPen(QColor(theme.INK_ON_COLOUR))
        layout.draw(painter, QPointF(-text_w / 2, body.top() + BUBBLE_BORDER + pad_top))
        painter.restore()


# Docked session windows stack under the widget: 22 px apart, plus room for the sticker
# that sticks out above each card (the handoff's 118 px) while stickers are on.
SESSION_CARD_SPACING = sci(22)
SESSION_CARD_STICKER_ROOM = 136  # the full-size sticker standing on the card's top edge
SESSION_CARD_TITLE = "AI agent session"
MAIN_CARD_SHADOW = sci(7)
SESSION_CARD_SHADOW = sci(6)
CARD_BORDER = sc(3)


def build_card_window(window: QWidget, shadow: int, padding: tuple[int, int, int, int] = (0, 0, 0, 0)
                      ) -> tuple[ComicFrame, QVBoxLayout]:
    """Transparent window → 8 px margin → comic card (outline + hard shadow); hugs its content."""
    outer = QVBoxLayout(window)
    outer.setContentsMargins(WINDOW_MARGIN, WINDOW_MARGIN, WINDOW_MARGIN, WINDOW_MARGIN)
    outer.setSpacing(0)
    outer.setSizeConstraint(QLayout.SizeConstraint.SetFixedSize)
    card = ComicFrame("card", radius=sc(6), border=CARD_BORDER, shadow=shadow)
    card.setObjectName("card")
    card.setFixedWidth(CARD_WIDTH + shadow)
    outer.addWidget(card)
    inner = QVBoxLayout(card)
    left, top, right, bottom = padding
    edge = math.ceil(CARD_BORDER)
    inner.setContentsMargins(edge + left, edge + top, edge + right, edge + bottom)
    inner.setSpacing(0)
    return card, inner


def card_top_right(window: QWidget) -> tuple[int, int]:
    """Screen position of a card window's visual top-right corner (shadow excluded)."""
    geometry = window.geometry()
    return geometry.x() + WINDOW_MARGIN + CARD_WIDTH, geometry.y() + WINDOW_MARGIN


class SessionCard(QWidget):
    """A separate, draggable window for one agent session (run), with its own GIF sticker.

    Docked cards stack under the main widget and follow it; dragging a card makes it
    floating, and its position is remembered per session. The sticker stays up while the
    session works or waits and tucks away when it is done or idle.
    """

    def __init__(self, owner: "StatusWidget", session_id: str) -> None:
        super().__init__(None, tool_window_flags(accept_focus=False))
        self.owner = owner
        self.session_id = session_id
        self.setWindowTitle(SESSION_CARD_TITLE)
        self.setObjectName("window")
        prepare_floating_window(self)
        self.card, card_layout = build_card_window(self, SESSION_CARD_SHADOW)
        self.content = QVBoxLayout()
        self.content.setContentsMargins(sci(11), sci(11), sci(14), sci(11))
        card_layout.addLayout(self.content)

        self.signature: str | None = None
        self.session: dict[str, object] | None = None
        self.floating = False
        self.closed = False
        self.sticker_key: str | None = None
        self.sticker_request = 0
        self.sticker_debounce: QTimer | None = None
        self.rotate_source: QTimer | None = None
        self.save_source: QTimer | None = None
        self.overlay: StickerOverlay | None = StickerOverlay()

    # ---- content ----
    def update_session(self, session: dict[str, object]) -> None:
        self.session = session
        signature = json.dumps(
            [session["name"], session["status"], session["project"], session["time"], session["kind"]],
            ensure_ascii=False,
        )
        if signature != self.signature:
            self.signature = signature
            clear_layout(self.content)
            self.content.addWidget(self.owner.build_row(session))
            waiting = session["kind"] == "waiting"
            set_flag(self.card, "waiting", waiting)
            if not waiting:
                set_flag(self.card, "pulse", False)
            self.adjustSize()  # shrink-wrap to the new row
        self.update_sticker()

    def update_sticker(self) -> None:
        """Keep the sticker in step with the session: new GIF on a new sticker status,
        tucked away when done/idle or in Serious mode."""
        session = self.session
        key = stickers.sticker_for_kind(session["kind"]) if session is not None else None
        if self.owner.serious_mode or key in (None, "done", "idle"):
            self.clear_sticker()
            return
        if key == self.sticker_key:
            return
        self.sticker_key = key
        self.request_sticker(key)

    def request_sticker(self, key: str) -> None:
        if self.overlay is None:
            return
        source_remove(self.sticker_debounce)
        self.sticker_request += 1
        request = self.sticker_request
        source = self.owner.sticker_source

        def pick_in_background() -> bool:
            self.sticker_debounce = None

            def worker() -> None:
                try:
                    choice = source.pick(key)
                except Exception as error:  # never let a sticker take the widget down
                    log(f"sticker: pick failed: {error}")
                    choice = stickers.StickerChoice(key, None, "", "placeholder")
                idle_add(self.apply_sticker, request, choice)

            threading.Thread(target=worker, daemon=True).start()
            return False

        self.sticker_debounce = timeout_add(STICKER_DEBOUNCE_MS, pick_in_background)

    def apply_sticker(self, request: int, choice: stickers.StickerChoice) -> bool:
        if self.closed or self.overlay is None or request != self.sticker_request or self.owner.serious_mode:
            return False
        log(f"sticker: {self.session_id} {choice.key} from {choice.source} ({choice.label})")
        self.place_overlay()
        self.overlay.present_sticker(choice, sticky=True)
        self.schedule_rotation()
        return False

    def schedule_rotation(self) -> None:
        """While the session keeps working, swap to a fresh GIF every N seconds."""
        self.stop_rotation()
        seconds = self.owner.sticker_rotate_seconds
        if seconds > 0 and self.sticker_key is not None:
            self.rotate_source = timeout_add_seconds(seconds, self.on_rotate)

    def stop_rotation(self) -> None:
        source_remove(self.rotate_source)
        self.rotate_source = None

    def on_rotate(self) -> bool:
        self.rotate_source = None
        self.show_another_gif()
        return False

    def show_another_gif(self) -> None:
        if not self.closed and self.sticker_key is not None and not self.owner.serious_mode:
            self.request_sticker(self.sticker_key)

    def clear_sticker(self) -> None:
        self.stop_rotation()
        self.sticker_key = None
        self.sticker_request += 1
        source_remove(self.sticker_debounce)
        self.sticker_debounce = None
        if self.overlay is not None and self.overlay.visible:
            self.overlay.tuck()

    def refresh_sticker(self) -> None:
        """Re-pick after Serious mode was turned off or the GIF source changed."""
        self.sticker_key = None
        self.update_sticker()

    def place_overlay(self) -> None:
        if self.overlay is None:
            return
        self.overlay.place_for_card(*card_top_right(self))

    def set_tilt(self, tilt: float) -> None:
        """Polaroids lean alternately left and right down the stack of cards."""
        if self.overlay is not None and self.overlay.tilt != tilt:
            self.overlay.tilt = tilt
            self.overlay.update()

    # ---- placement ----
    def dock_at(self, x: int, y: int) -> None:
        if self.floating:
            return
        if (self.x(), self.y()) != (x, y):
            self.move(x, y)

    def moveEvent(self, event: object) -> None:  # noqa: N802 - Qt API
        super().moveEvent(event)
        if self.overlay is not None and self.overlay.visible:
            self.place_overlay()
        if self.floating and not self.closed:
            # A drag fires many move events; persist once it settles.
            source_remove(self.save_source)
            self.save_source = timeout_add(400, self.save_position)

    def save_position(self) -> bool:
        self.save_source = None
        if not self.closed and self.floating:
            self.owner.save_card_position(self.session_id, self.x(), self.y())
        return False

    def mousePressEvent(self, event: object) -> None:  # noqa: N802 - Qt API
        button = event.button()
        if button == Qt.MouseButton.LeftButton:
            self.floating = True
            handle = self.windowHandle()
            if handle is not None:
                handle.startSystemMove()
            return
        if button == Qt.MouseButton.RightButton:
            menu = QMenu(self)
            another = menu.addAction("Show another GIF")
            another.setEnabled(self.sticker_key is not None and not self.owner.serious_mode)
            another.triggered.connect(self.show_another_gif)
            dock = menu.addAction("Dock under the widget")
            dock.setEnabled(self.floating)
            dock.triggered.connect(lambda: self.owner.dock_card(self.session_id))
            dock_all = menu.addAction("Dock all session windows")
            dock_all.triggered.connect(self.owner.dock_all_cards)
            settings = menu.addAction("Settings…")
            settings.triggered.connect(self.owner.open_settings)
            menu.exec(event.globalPosition().toPoint())
            return
        super().mousePressEvent(event)

    def close_card(self) -> None:
        if self.closed:
            return
        self.closed = True
        for name in ("sticker_debounce", "save_source", "rotate_source"):
            source_remove(getattr(self, name))
            setattr(self, name, None)
        if self.overlay is not None:
            self.overlay.hide_now()
            self.overlay.deleteLater()
        if self.owner.x11 is not None:
            self.owner.x11.forget(int(self.winId()))  # X may reuse the id for a new window
        self.hide()
        self.deleteLater()


# Timing settings shown in the Settings window: (env key, widget config key, label, hint).
TIMING_SETTINGS = (
    ("AI_STATUS_STALE_AFTER_SECONDS", "stale_after_seconds",
     "No new events after", "row turns grey"),
    ("AI_STATUS_HIDE_DONE_AFTER_SECONDS", "hide_done_after_seconds",
     "Hide finished after", "done rows disappear"),
    ("AI_STATUS_IDLE_AFTER_SECONDS", "idle_after_seconds",
     "Show as idle after", "silent session"),
    ("AI_STATUS_HIDE_STALE_AFTER_SECONDS", "hide_stale_after_seconds",
     "Hide inactive after", "silent row disappears"),
)
MAX_ROWS_LIMIT = 12
MAX_MINUTES = 24 * 60


def section_label(text: str) -> QLabel:
    label = comic_label(text.upper(), display_font(18, 1.0), "ink")
    label.setContentsMargins(0, 12, 0, 2)
    return label


def hint_label(text: str, wrap: bool = False) -> QLabel:
    return comic_label(text, mono_font(10), "secondary", wrap=wrap)


def dialog_button(text: str) -> ComicButton:
    return ComicButton(text, font=body_font(13), padding=(3, 12))


def new_grid() -> QGridLayout:
    grid = QGridLayout()
    grid.setVerticalSpacing(10)
    grid.setHorizontalSpacing(18)
    grid.setColumnStretch(0, 1)
    return grid


def style_spin(spin: QAbstractSpinBox) -> None:
    # The step buttons live next to the field (see spin_field): style sheets cannot draw
    # Fusion's arrow images, so the built-in ones are collapsed to zero width in
    # style_sheet() (NoButtons plus a style sheet leaves Qt's line edit 1 px wide).
    spin.setAlignment(Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter)


def spin_field(spin: QAbstractSpinBox) -> QWidget:
    """A spin box with comic "−" / "+" buttons on its right."""
    field = QWidget()
    layout = QHBoxLayout(field)
    layout.setContentsMargins(0, 0, 0, 0)
    layout.setSpacing(5)
    layout.addWidget(spin)
    for text, step in (("−", spin.stepDown), ("+", spin.stepUp)):
        button = ComicButton(text, size=26, font=body_font(17))
        button.setAutoRepeat(True)
        button.clicked.connect(step)
        layout.addWidget(button)
    return field


def minutes_spin(maximum: float, value: float) -> QDoubleSpinBox:
    spin = QDoubleSpinBox()
    style_spin(spin)
    spin.setRange(0, maximum)
    spin.setSingleStep(0.5)
    spin.setDecimals(1)
    spin.setValue(value)
    spin.setKeyboardTracking(False)
    return spin


class InkRule(QWidget):
    """A 3 px ink line between dialog sections."""

    def __init__(self) -> None:
        super().__init__()
        self.setFixedHeight(3)

    def paintEvent(self, _event: object) -> None:  # noqa: N802 - Qt API
        QPainter(self).fillRect(self.rect(), QColor(T().ink))


class DialogWindow(QWidget):
    """Always-on-top comic dialog shell shared by Settings and the KLIPY guide."""

    def __init__(self, title: str, heading: str) -> None:
        super().__init__(None, Qt.WindowType.Window | Qt.WindowType.WindowStaysOnTopHint)
        self.setWindowTitle(title)
        self.setObjectName("settingsWindow")
        self.setAttribute(Qt.WidgetAttribute.WA_StyledBackground)
        self.setAttribute(Qt.WidgetAttribute.WA_DeleteOnClose)
        outer = QVBoxLayout(self)
        outer.setContentsMargins(0, 0, 0, 0)
        outer.setSpacing(0)
        outer.setSizeConstraint(QLayout.SizeConstraint.SetFixedSize)
        self.outer = outer

        header = HalftoneHeader(corner=0)
        header_layout = QHBoxLayout(header)
        header_layout.setContentsMargins(16, 12, 16, 12 + header.rule)
        header_layout.setSpacing(10)
        header_layout.addWidget(RadarLogo(30), 0, Qt.AlignmentFlag.AlignVCenter)
        header_layout.addWidget(ComicText(heading, display_font(26, 1.2), fill=theme.WHITE, stroke=1.5,
                                          stroke_color=theme.INK_ON_COLOUR, shadow=2), 0, Qt.AlignmentFlag.AlignVCenter)
        header_layout.addStretch(1)
        outer.addWidget(header)

        content_frame = QWidget()
        self.content = QVBoxLayout(content_frame)
        self.content.setContentsMargins(18, 6, 18, 16)
        self.content.setSpacing(5)
        outer.addWidget(content_frame)

        footer = QWidget()
        self.footer = QHBoxLayout(footer)
        self.footer.setContentsMargins(18, 12, 18, 14)
        self.footer.setSpacing(10)
        self.footer_frame = footer

    def finish(self, note: QLabel) -> None:
        self.footer.addWidget(note, 1)
        close = ComicButton("CLOSE", bg=theme.YELLOW, fg=theme.INK_ON_COLOUR, hover_bg=theme.YELLOW_HOVER,
                            font=display_font(17, 1.0), padding=(2, 14))
        close.clicked.connect(self.close)
        self.footer.addWidget(close, 0, Qt.AlignmentFlag.AlignVCenter)
        self.outer.addWidget(InkRule())
        self.outer.addWidget(self.footer_frame)

    def keyPressEvent(self, event: object) -> None:  # noqa: N802 - Qt API
        if event.key() == Qt.Key.Key_Escape:
            self.close()
            return
        super().keyPressEvent(event)


class SettingsWindow(DialogWindow):
    """Small instant-apply settings dialog; every change is saved to the runtime .env."""

    def __init__(self, owner: "StatusWidget") -> None:
        super().__init__("AI Status Monitor — Settings", "Settings")
        self.owner = owner
        self.agent_checks: dict[str, ComicCheck] = {}
        self.klipy_save_source: QTimer | None = None
        content = self.content

        # ---- agents ----
        content.addWidget(section_label("Agents"))
        agents_row = QHBoxLayout()
        agents_row.setSpacing(14)
        for agent, label in (("claude", "Claude Code"), ("codex", "Codex")):
            check = ComicCheck(label, theme.AGENT_COLORS[agent], owner.logo_pixmaps.get(agent))
            check.setChecked(agent in owner.agents)
            check.toggled.connect(lambda _checked, box=check: self.on_agent_toggled(box))
            self.agent_checks[agent] = check
            agents_row.addWidget(check)
        agents_row.addStretch(1)
        content.addLayout(agents_row)
        content.addWidget(hint_label("Hidden agents get no rows, usage bars, sounds or usage requests."))

        # ---- display ----
        content.addWidget(section_label("Display"))
        grid = new_grid()
        self.sound_switch = ComicSwitch(owner.config.get("sound_enabled") is True)
        self.sound_switch.toggled.connect(self.on_sound_changed)
        self.attach_row(grid, 0, "Notification sound", "on waiting and when done", self.sound_switch)
        self.rows_spin = QSpinBox()
        style_spin(self.rows_spin)
        self.rows_spin.setRange(1, MAX_ROWS_LIMIT)
        self.rows_spin.setValue(owner.max_rows)
        self.rows_spin.setKeyboardTracking(False)
        self.rows_spin.valueChanged.connect(self.on_rows_changed)
        self.attach_row(grid, 1, "Visible rows", "sessions shown at once", spin_field(self.rows_spin))
        self.windows_switch = ComicSwitch(owner.session_windows)
        self.windows_switch.toggled.connect(self.on_windows_changed)
        self.attach_row(grid, 2, "Session windows", "each run in its own draggable window", self.windows_switch)
        self.light_switch = ComicSwitch(T().name == "light")
        self.light_switch.toggled.connect(self.on_theme_changed)
        self.attach_row(grid, 3, "Light theme", "comic dark is the default", self.light_switch)
        self.limits_switch = ComicSwitch(owner.show_limits)
        self.limits_switch.toggled.connect(owner.set_show_limits)
        self.attach_row(grid, 4, "Usage limits", "bars in the main card · ▴/▾ in the header", self.limits_switch)
        self.autostart_switch = ComicSwitch(autostart.is_enabled(platform_support.home_dir()))
        self.autostart_switch.toggled.connect(self.on_autostart_changed)
        self.attach_row(grid, 5, "Start at login", "open the widget when you sign in", self.autostart_switch)
        content.addLayout(grid)

        # ---- stickers ----
        content.addWidget(section_label("Stickers"))
        grid = new_grid()
        self.serious_switch = ComicSwitch(owner.serious_mode)
        self.serious_switch.toggled.connect(self.on_serious_changed)
        self.attach_row(grid, 0, "Serious mode", "no GIF stickers, good for meetings", self.serious_switch)

        self.klipy_entry = QLineEdit(owner.klipy_api_key)
        self.klipy_entry.setEchoMode(QLineEdit.EchoMode.Password)
        self.klipy_entry.setPlaceholderText("optional")
        self.klipy_entry.setFixedWidth(110)
        self.klipy_entry.textChanged.connect(self.on_klipy_changed)
        key_box = QHBoxLayout()
        key_box.setSpacing(6)
        key_box.addWidget(self.klipy_entry)
        guide_button = dialog_button("Get a free key…")
        guide_button.clicked.connect(lambda: owner.open_klipy_guide(self))
        key_box.addWidget(guide_button)
        key_widget = QWidget()
        key_widget.setLayout(key_box)
        key_box.setContentsMargins(0, 0, 0, 0)
        self.attach_row(grid, 1, "KLIPY API key", "random GIFs · Powered by KLIPY", key_widget)

        self.rotate_spin = minutes_spin(30, owner.sticker_rotate_seconds / 60)
        self.rotate_spin.valueChanged.connect(self.on_rotate_changed)
        self.attach_row(grid, 2, "New GIF every (min)", "while an agent works · 0 = never", spin_field(self.rotate_spin))

        test = dialog_button("Show test sticker")
        test.clicked.connect(lambda: owner.show_test_sticker())
        self.attach_row(grid, 3, "Preview", "cycles through every status", test)
        content.addLayout(grid)
        content.addWidget(hint_label(f"Local GIFs: {display_path(GIFS_DIR)}/<status>/", wrap=True))

        # ---- timing ----
        content.addWidget(section_label("Timing (minutes)"))
        grid = new_grid()
        for index, (env_key, config_key, label, hint) in enumerate(TIMING_SETTINGS):
            spin = minutes_spin(MAX_MINUTES, owner.config_seconds(config_key) / 60)
            spin.valueChanged.connect(lambda value, key=env_key: self.on_timing_changed(value, key))
            self.attach_row(grid, index, label, hint, spin_field(spin))
        content.addLayout(grid)

        note = hint_label(f"Saved automatically to {display_path(SETTINGS.env_file)}", wrap=True)
        note.setMaximumWidth(260)
        self.finish(note)

    @staticmethod
    def attach_row(grid: QGridLayout, row: int, title: str, hint: str, control: QWidget) -> None:
        labels = QVBoxLayout()
        labels.setSpacing(1)
        labels.addWidget(comic_label(title, body_font(14), "text"))
        labels.addWidget(hint_label(hint))
        grid.addLayout(labels, row, 0)
        grid.addWidget(control, row, 1, Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter)

    def closeEvent(self, event: object) -> None:  # noqa: N802 - Qt API
        if self.klipy_save_source is not None:
            source_remove(self.klipy_save_source)
            self.save_klipy_key()
        self.owner.on_settings_closed(self)
        super().closeEvent(event)

    def on_agent_toggled(self, check: QCheckBox) -> None:
        agents = tuple(agent for agent in SUPPORTED_AGENTS if self.agent_checks[agent].isChecked())
        if not agents:
            # At least one agent must stay visible; undo the last uncheck.
            check.setChecked(True)
            return
        self.owner.set_agents(agents)

    def on_sound_changed(self, checked: bool) -> None:
        self.owner.update_setting("AI_STATUS_SOUND_ENABLED", "true" if checked else "false")

    def on_serious_changed(self, checked: bool) -> None:
        if checked != self.owner.serious_mode:
            self.owner.set_serious_mode(checked)

    def on_rotate_changed(self, value: float) -> None:
        self.owner.update_setting("AI_STATUS_STICKER_ROTATE_SECONDS", str(round(value * 60)))

    def on_klipy_changed(self, _text: str) -> None:
        # Save once typing/pasting settles instead of on every keystroke.
        source_remove(self.klipy_save_source)
        self.klipy_save_source = timeout_add(700, self.save_klipy_key)

    def save_klipy_key(self) -> bool:
        self.klipy_save_source = None
        value = self.klipy_entry.text().strip()
        if value != self.owner.klipy_api_key:
            self.owner.update_setting("AI_STATUS_KLIPY_API_KEY", value)
        return False

    def on_autostart_changed(self, checked: bool) -> None:
        self.owner.update_setting("AI_STATUS_AUTOSTART", "true" if checked else "false")

    def on_theme_changed(self, checked: bool) -> None:
        self.owner.update_setting("AI_STATUS_THEME", "light" if checked else "dark")

    def on_windows_changed(self, checked: bool) -> None:
        self.owner.update_setting("AI_STATUS_SESSION_WINDOWS", "true" if checked else "false")

    def on_rows_changed(self, value: int) -> None:
        self.owner.update_setting("AI_STATUS_MAX_ROWS", str(int(value)))

    def on_timing_changed(self, value: float, env_key: str) -> None:
        self.owner.update_setting(env_key, str(round(value * 60)))


class KlipyKeyGuide(DialogWindow):
    """Step-by-step "get a free KLIPY key" guide with copy buttons and a key test."""

    def __init__(self, owner: "StatusWidget") -> None:
        super().__init__("Get a free KLIPY key", "Get a free KLIPY key")
        self.owner = owner
        self.checking = False
        self.closed = False
        content = self.content
        content.setSpacing(6)
        content.addWidget(self.hint(
            "Stickers can show random GIFs from KLIPY. It takes about two minutes and is free; "
            "without a key the widget uses local GIFs only."
        ))

        # 1. account
        content.addWidget(section_label("1 · Sign up"))
        open_button = dialog_button("Open the KLIPY Partner Panel ↗")
        open_button.clicked.connect(self.open_partner_panel)
        content.addWidget(open_button, 0, Qt.AlignmentFlag.AlignLeft)
        content.addWidget(self.hint(f"{stickers.KLIPY_PARTNER_URL} — sign up, it is free."))

        # 2. platform details
        content.addWidget(section_label("2 · Add your platform"))
        grid = new_grid()
        grid.setVerticalSpacing(6)
        for row, (label, value) in enumerate((
            ("Platform name", stickers.KLIPY_GUIDE_PLATFORM_NAME),
            ("Platform website", stickers.KLIPY_GUIDE_WEBSITE),
            ("About / integration", "a ready-made description"),
        )):
            text = stickers.KLIPY_GUIDE_DESCRIPTION if row == 2 else value
            self.attach_copy_row(grid, row, label, value, text)
        content.addLayout(grid)
        content.addWidget(self.hint("Then tick the KLIPY API Terms checkbox (read them first) and press Add Platform."))

        # 3. key
        content.addWidget(section_label("3 · Create an API key"))
        grid = new_grid()
        grid.setVerticalSpacing(6)
        self.attach_copy_row(grid, 0, "Key name", stickers.KLIPY_GUIDE_KEY_NAME, stickers.KLIPY_GUIDE_KEY_NAME)
        self.attach_copy_row(grid, 1, "URL", stickers.KLIPY_GUIDE_WEBSITE, stickers.KLIPY_GUIDE_WEBSITE)
        content.addLayout(grid)
        content.addWidget(self.hint("Leave “Enable the Ads API” OFF, then press Create and copy the key."))

        # 4. paste + test
        content.addWidget(section_label("4 · Paste and test"))
        row = QHBoxLayout()
        row.setSpacing(8)
        self.key_entry = QLineEdit(owner.klipy_api_key)
        self.key_entry.setEchoMode(QLineEdit.EchoMode.Password)
        self.key_entry.setPlaceholderText("paste your KLIPY key")
        self.key_entry.returnPressed.connect(self.test_and_save)
        row.addWidget(self.key_entry, 1)
        self.test_button = dialog_button("Test & save")
        self.test_button.clicked.connect(self.test_and_save)
        row.addWidget(self.test_button)
        content.addLayout(row)
        self.status = self.hint("")
        content.addWidget(self.status)

        self.finish(self.hint(
            "Free test keys allow 100 requests per hour; the widget stays under 60. The key is saved "
            f"in {display_path(SETTINGS.env_file)} (mode 0600) and never written to logs. Powered by KLIPY."
        ))

    @staticmethod
    def hint(text: str) -> QLabel:
        label = hint_label(text, wrap=True)
        label.setFixedWidth(400)
        return label

    def attach_copy_row(self, grid: QGridLayout, row: int, label: str, shown: str, copied: str) -> None:
        texts = QVBoxLayout()
        texts.setSpacing(1)
        texts.addWidget(comic_label(label, body_font(14), "text"))
        value = ElidedLabel(shown, color="text_secondary")
        value.setFont(mono_font(10))
        value.setFixedWidth(280)
        texts.addWidget(value)
        grid.addLayout(texts, row, 0)
        button = dialog_button("Copy")
        button.clicked.connect(lambda: self.on_copy(button, copied))
        grid.addWidget(button, row, 1, Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter)

    def on_copy(self, button: QPushButton, text: str) -> None:
        QGuiApplication.clipboard().setText(text)
        button.setText("Copied ✓")
        # Parented to the button: the reset is dropped if the guide closes first.
        QTimer.singleShot(1500, button, lambda: button.setText("Copy"))

    def open_partner_panel(self) -> None:
        if not QDesktopServices.openUrl(QUrl(stickers.KLIPY_PARTNER_URL)):
            platform_support.open_path(stickers.KLIPY_PARTNER_URL)

    def test_and_save(self) -> None:
        if self.checking:
            return
        key = self.key_entry.text().strip()
        if not key:
            self.show_status("Paste the key from the KLIPY Partner Panel first.", ok=False)
            return
        self.checking = True
        self.test_button.setEnabled(False)
        self.show_status("Checking the key with KLIPY…", ok=None)

        def worker() -> None:
            result = stickers.verify_klipy_key(key, stickers.load_customer_id(KLIPY_CUSTOMER_ID_FILE))
            idle_add(self.on_verified, key, result)

        threading.Thread(target=worker, daemon=True).start()

    def on_verified(self, key: str, result: str) -> bool:
        # Save first: the guide may have been closed (and deleted) while the check ran.
        if result in ("ok", "rate_limited"):
            self.owner.update_setting("AI_STATUS_KLIPY_API_KEY", key)
            window = self.owner.settings_window
            if window is not None and window.klipy_entry.text().strip() != key:
                window.klipy_entry.setText(key)
        log(f"KLIPY key check: {result}")
        if self.closed:
            return False
        self.checking = False
        self.test_button.setEnabled(True)
        self.show_status(stickers.KLIPY_KEY_STATUS_MESSAGES.get(result, result), ok=result in ("ok", "rate_limited"))
        return False

    def show_status(self, text: str, ok: bool | None) -> None:
        color = {True: T().bar_inks["ok"], False: theme.RED, None: T().text_secondary}[ok]
        self.status.setText(markup(text, color))

    def closeEvent(self, event: object) -> None:  # noqa: N802 - Qt API
        self.closed = True
        self.owner.on_klipy_guide_closed(self)
        super().closeEvent(event)


def display_path(path: Path) -> str:
    try:
        relative = path.relative_to(Path.home())
    except ValueError:
        return str(path)
    return "~/" + relative.as_posix()


class StatusWidget(QWidget):
    def __init__(self, demo: bool = False) -> None:
        ensure_app()
        super().__init__(None, tool_window_flags())
        self.setWindowTitle(TITLE)
        self.setObjectName("window")
        prepare_floating_window(self)
        self.demo = demo
        self.demo_index = 0
        self.config = self.load_config()
        self.agents: tuple[str, ...] = SETTINGS.agents
        self.max_rows = MAX_ROWS
        self.settings_window: SettingsWindow | None = None
        self.klipy_guide: KlipyKeyGuide | None = None
        self.serious_mode = SETTINGS.serious_mode
        self.klipy_api_key = SETTINGS.klipy_api_key
        self.sticker_overlay: StickerOverlay | None = StickerOverlay()
        self.sticker_source = self.build_sticker_source()
        self.sticker_kinds: dict[str, str] = {}
        self.sticker_primed = False
        self.sticker_request = 0
        self.sticker_debounce: QTimer | None = None
        self.sticker_owner: str | None = None
        self.sticker_hovered: str | None = None
        self.row_hover_boxes: dict[str, HoverBox] = {}
        self.last_stickers: dict[str, stickers.StickerChoice] = {}
        self.limits_seen: set[tuple[str, str, str]] = set()
        self.test_sticker_index = 0
        self.session_windows = SETTINGS.session_windows
        self.show_limits = SETTINGS.show_limits
        self.sticker_rotate_seconds = SETTINGS.sticker_rotate_seconds
        self.session_cards: dict[str, SessionCard] = {}
        self.card_order: list[str] = []
        self.card_positions = self.load_card_positions()
        self.was_waiting_for_interaction = False
        self.was_done = False
        self.anim_frame = 0
        self.signature: str | None = None
        self.spinning: list[RadarLogo] = []
        self.intro = True
        self.closing = False
        self.rebuilding = False
        self.timers: list[QTimer] = []
        self.update_available: str | None = None
        self.updating = False
        self.usage_refreshing = False
        self.usage_refreshing_providers: set[str] = set()
        self.usage_animation_source_id: QTimer | None = None
        self.usage_animation_angle = 0.0
        self.usage_logo_widgets: dict[str, AgentCircle] = {}
        self.usage_logo_buttons: dict[str, AgentCircle] = {}
        self.usage_snapshot: usage_limits.UsageSnapshot = {
            "providers": usage_limits.load_usage_cache(USAGE_CACHE_FILE),
            "errors": {},
        }
        self.note_usage_limits(self.usage_snapshot, trigger=False)
        self.demo_usage_scenarios = usage_limits.demo_usage_states()
        if demo:
            self.usage_snapshot = self.demo_usage_scenarios[0]["snapshot"]
        self.logo_pixmaps = self.load_logos()  # Settings (full size)
        self.row_logo_pixmaps = self.load_logos(size=sci(14))
        self.usage_logo_pixmaps = self.load_logos(size=sci(20))
        self.demo_scenarios = [
            [("claude", "reading code", "unitbox-front", "22:16"),
             ("codex", "analyzing", "ai-cli-status-monitor", "22:16")],
            [("claude", "coding", "backend-api", "22:17"),
             ("codex", "waiting for approval", "ai-cli-status-monitor", "22:17")],
            [("claude", "thinking", "backend-api", "22:14"),
             ("codex", "running command", "infra-scripts", "22:15"),
             ("claude", "reading code", "unitbox-front", "22:16"),
             ("codex", "done", "docs-site", "22:11")],
            [],
        ]

        self._build_ui()
        self.restore_position()

        if self.session_windows:
            # The widget is just the usage panel; agents appear as their own windows.
            # No intro splash and no idle lockup animation.
            self.intro = False
            self.signature = json.dumps(["session-windows"])
            self.rebuild_body([], 0, show_lockup=False)
        else:
            self.build_intro()
            self.timers.append(timeout_add_seconds(3, self.end_intro))
        self.timers.append(timeout_add_seconds(1, self.refresh_status))
        self.timers.append(timeout_add(200, self.tick_animation))
        self.x11: x11_hints.X11Hints | None = None
        self.x11_checked = False
        # Every second, like the GTK widget re-asserted keep-above on each poll: Muffin and
        # Mutter drop "above" now and then (show desktop, workspace switch, focus changes).
        self.timers.append(timeout_add_seconds(1, self.apply_window_hints))
        if not demo:
            # Check GitHub for a newer release once, a few seconds after startup so
            # it never competes with the intro or first paint.
            self.timers.append(timeout_add_seconds(4, self.start_update_check))
            self.timers.append(timeout_add_seconds(4, self.start_usage_refresh))
            self.timers.append(timeout_add_seconds(120, self.usage_refresh_tick))

    def _build_ui(self) -> None:
        self.card, card_layout = build_card_window(self, MAIN_CARD_SHADOW)

        # ---- header: halftone strip with the radar mark, title, badge and buttons ----
        header = HalftoneHeader(corner=sc(3), scale=UI_SCALE)
        header.setObjectName("header")
        header_layout = QHBoxLayout(header)
        header_layout.setContentsMargins(sci(12), sci(10), sci(12), sci(10) + header.rule)
        header_layout.setSpacing(sci(8))
        card_layout.addWidget(header)

        self.header_icon = RadarLogo(sci(30))
        header_layout.addWidget(self.header_icon, 0, Qt.AlignmentFlag.AlignVCenter)

        self.title = ComicText(TITLE, display_font(sc(26), sc(1.2)), fill=theme.WHITE, stroke=sc(1.5),
                               stroke_color=theme.INK_ON_COLOUR, shadow=sci(2), elide=True)
        header_layout.addWidget(self.title, 1, Qt.AlignmentFlag.AlignVCenter)

        # Update pill: hidden until the startup check finds a newer version.
        self.update_button = ComicButton("UPDATE ↑", bg=theme.YELLOW, fg=theme.INK_ON_COLOUR,
                                         hover_bg=theme.YELLOW_HOVER, font=display_font(sct(14), sc(0.8)),
                                         padding=(1, 7), scale=UI_SCALE)
        self.update_button.setToolTip("A newer version is available — click to update")
        self.update_button.clicked.connect(self.run_update)
        self.update_button.hide()
        header_layout.addWidget(self.update_button, 0, Qt.AlignmentFlag.AlignVCenter)

        self.badge = ComicBadge(UI_SCALE)
        header_layout.addWidget(self.badge, 0, Qt.AlignmentFlag.AlignVCenter)

        buttons = QHBoxLayout()
        buttons.setSpacing(sci(6))
        self.limits_button = ComicButton("▴", size=sci(28), font=body_font(sc(15)), scale=UI_SCALE)
        self.limits_button.clicked.connect(lambda: self.set_show_limits(not self.show_limits))
        buttons.addWidget(self.limits_button)
        settings_button = ComicButton("⚙", size=sci(28), font=body_font(sc(15)), scale=UI_SCALE)
        settings_button.setToolTip("Settings")
        settings_button.clicked.connect(self.open_settings)
        buttons.addWidget(settings_button)
        close = ComicButton("X", size=sci(28), bg=theme.RED, fg=theme.WHITE, font=display_font(sc(18)),
                            scale=UI_SCALE)
        close.setToolTip("Quit")
        close.clicked.connect(self.quit)
        buttons.addWidget(close)
        header_layout.addLayout(buttons)

        # ---- body (classic list rows or the idle lockup) ----
        self.body = QWidget()
        self.body_layout = QVBoxLayout(self.body)
        self.body_layout.setContentsMargins(sci(14), sci(12), sci(14), 0)
        self.body_layout.setSpacing(sci(10))
        card_layout.addWidget(self.body)

        # ---- account usage limits: one inked block per provider (collapsible) ----
        self.usage_panel = QWidget()
        self.usage_panel.setObjectName("usagePanel")
        self.usage_rows = QVBoxLayout(self.usage_panel)
        self.usage_rows.setContentsMargins(sci(14), sci(12), sci(14), sci(14))
        self.usage_rows.setSpacing(sci(12))
        card_layout.addWidget(self.usage_panel)
        self.render_usage_limits()
        self.apply_limits_visibility()

    # ----------------------------- config -----------------------------
    def load_config(self) -> dict[str, object]:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        return dict(DEFAULT_CONFIG)

    def write_config(self, values: dict[str, object]) -> None:
        try:
            current = {}
            if WIDGET_CONFIG.exists():
                loaded = json.loads(WIDGET_CONFIG.read_text(encoding="utf-8"))
                if isinstance(loaded, dict):
                    current = loaded
            current.update(values)
            WIDGET_CONFIG.write_text(json.dumps(current, indent=2) + "\n", encoding="utf-8")
        except (json.JSONDecodeError, OSError) as error:
            log(f"failed to write widget config: {error}")

    def load_logos(self, size: int = 14) -> dict[str, QPixmap]:
        logos: dict[str, QPixmap] = {}
        for agent, path in (("claude", ANTHROPIC_LOGO), ("codex", OPENAI_LOGO)):
            if not path.exists():
                log(f"logo missing for {agent}: {path}")
                continue
            pixmap = load_scaled_pixmap(path, size)
            if pixmap is None:
                log(f"failed to load logo for {agent}: {path}")
                continue
            logos[agent] = pixmap
        return logos

    def config_seconds(self, key: str) -> int:
        value = self.config.get(key, DEFAULT_CONFIG[key])
        return value if isinstance(value, int) else int(DEFAULT_CONFIG[key])

    def config_timedelta(self, key: str) -> timedelta:
        return timedelta(seconds=self.config_seconds(key))

    # ----------------------------- data -----------------------------
    def collect_sessions(self) -> list[dict[str, object]]:
        if self.demo:
            # Rotate every 4 s so session windows' stickers have time to show.
            scenario = self.demo_scenarios[(self.demo_index // 4) % len(self.demo_scenarios)]
            sessions = []
            for agent, status, project, hhmm in scenario:
                session = self.make_session(agent, status, project, hhmm)
                session["id"] = f"{agent}:{project}"
                sessions.append(session)
        else:
            structured = self.read_structured_sessions()
            sessions = structured if structured is not None else self.read_combined_sessions()
        return [session for session in sessions if self.agent_enabled(str(session["agent"]))]

    def agent_enabled(self, agent: str) -> bool:
        """Sessions of an unrecognised agent stay visible only while every agent is shown."""
        if agent in SUPPORTED_AGENTS:
            return agent in self.agents
        return self.agents == SUPPORTED_AGENTS

    def make_session(
        self,
        agent: str,
        status: str,
        project: str,
        hhmm: str,
        cwd: str = "",
        client_pids: list[int] | None = None,
        kind: StatusKind | str | None = None,
        source_kind: StatusKind | str | None = None,
        console_window: int = 0,
    ) -> dict[str, object]:
        normalized_kind = normalize_kind(kind, status)
        original_kind = normalize_kind(source_kind if source_kind is not None else normalized_kind, status)
        return {
            "agent": agent if agent in AGENT_NAME_COLORS else "",
            "name": agent.capitalize() if agent else "AI",
            "status": status,
            "kind": normalized_kind,
            "source_kind": original_kind,
            "project": project,
            "time": hhmm,
            "cwd": cwd,
            "client_pids": client_pids or [],
            "console_window": console_window,
            "id": f"{agent}:{project}",
            "color": STATE_COLORS.get(normalized_kind, STATE_COLORS["neutral"]),
        }

    def read_structured_sessions(self) -> list[dict[str, object]] | None:
        paths = self.status_file_paths()
        if not paths:
            return None
        sessions: list[dict[str, object]] = []
        for path in paths:
            if not path.exists():
                continue
            try:
                data = json.loads(path.read_text(encoding="utf-8"))
            except (json.JSONDecodeError, OSError) as error:
                log(f"failed to read status json {path}: {error}")
                continue
            if not isinstance(data, dict):
                continue
            status = str(data.get("status") or "")
            project = str(data.get("project") or "")
            hhmm = str(data.get("timestamp_hhmm") or "")
            agent = str(data.get("agent") or path.stem).lower()
            cwd = str(data.get("cwd") or "")
            source_kind = normalize_kind(data.get("kind"), status)
            display_kind: StatusKind = source_kind
            raw_pids = data.get("client_pids")
            client_pids = [p for p in raw_pids if isinstance(p, int)] if isinstance(raw_pids, list) else []
            console = data.get("console_window")
            console_window = console if isinstance(console, int) and not isinstance(console, bool) else 0
            age = self.status_age(str(data.get("timestamp_iso") or ""))
            if age is not None:
                if self.should_hide_status(source_kind, status, age):
                    continue
                if age >= self.config_timedelta("hide_stale_after_seconds"):
                    continue
                if age >= self.config_timedelta("idle_after_seconds"):
                    status, project, display_kind = f"{agent.capitalize()}: idle", "", "idle"
                elif age >= self.config_timedelta("stale_after_seconds"):
                    status = f"{agent.capitalize()}: no new events"
                    display_kind = "stale"
            if not status:
                continue
            name, clean = self.split_agent_status(status, agent)
            session = self.make_session(agent, clean, project, hhmm, cwd, client_pids, display_kind, source_kind,
                                        console_window)
            session["name"] = name
            session["id"] = path.stem
            sessions.append(session)
        return sessions

    def read_combined_sessions(self) -> list[dict[str, object]]:
        try:
            raw = STATUS_FILE.read_text(encoding="utf-8").strip()
        except OSError:
            return []
        sessions: list[dict[str, object]] = []
        for line in raw.splitlines():
            line = line.strip()
            if not line:
                continue
            project, hhmm = "", ""
            text = line
            if "[" in text and "]" in text:
                before, _, rest = text.partition("[")
                project, _, after = rest.partition("]")
                text = before.strip()
                hhmm = after.strip()
            agent = "claude" if "claude" in line.lower() else ("codex" if "codex" in line.lower() else "")
            name, clean = self.split_agent_status(text, agent)
            session = self.make_session(agent, clean, project.strip(), hhmm)
            session["name"] = name
            session["id"] = f"{agent}:{project.strip()}"
            sessions.append(session)
        return sessions

    def split_agent_status(self, status: str, agent: str) -> tuple[str, str]:
        name = agent.capitalize() if agent in AGENT_NAME_COLORS else "AI"
        clean = status
        for prefix in ("Claude:", "Codex subagent:", "Codex:"):
            if clean.startswith(prefix):
                if prefix == "Codex subagent:":
                    name = "Codex subagent"
                clean = clean[len(prefix):]
                break
        return name, " ".join(clean.split())

    def status_file_paths(self) -> list[Path]:
        paths = list(STATUS_DIR.glob("*.json")) if STATUS_DIR.exists() else []
        if paths:
            paths.sort(key=self.status_file_timestamp, reverse=True)
            return paths
        return [path for path in AGENT_STATUS_FILES if path.exists()]

    def status_file_timestamp(self, path: Path) -> str:
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError):
            return ""
        if not isinstance(data, dict):
            return ""
        value = data.get("timestamp_iso")
        return value if isinstance(value, str) else ""

    def status_age(self, timestamp_iso: str) -> timedelta | None:
        if not timestamp_iso:
            return None
        try:
            timestamp = datetime.fromisoformat(timestamp_iso)
        except ValueError:
            return None
        return datetime.now() - timestamp

    def should_hide_status(self, kind: StatusKind, _status: str, age: timedelta) -> bool:
        # Legacy text has already been normalized into `kind` by the loader.
        return kind == "done" and age >= self.config_timedelta("hide_done_after_seconds")

    # ----------------------------- render -----------------------------
    def order_sessions(self, sessions: list[dict[str, object]]) -> list[dict[str, object]]:
        priority = {"waiting": 0, "error": 1}

        def rank(session: dict[str, object]) -> tuple[int, int]:
            kind = str(session["kind"])
            if kind in priority:
                return (priority[kind], 0)
            if kind in IN_PROGRESS:
                return (2, 0)
            return (3, 0)  # done / idle / stale last

        return sorted(sessions, key=rank)

    def refresh_status(self) -> bool:
        if self.closing:
            return False
        if self.intro:
            return True  # the startup lockup owns the body until end_intro()
        if self.demo:
            self.apply_demo_usage_state(self.demo_index)
        sessions = self.order_sessions(self.collect_sessions())
        if not self.demo and not self.session_windows:
            # In the classic list one sticker pops on change; session windows own theirs.
            self.update_stickers(sessions)
        visible = sessions[:self.max_rows]
        hidden_done = sum(1 for s in sessions[self.max_rows:] if s["kind"] in INACTIVE)

        waiting = any(s["kind"] == "waiting" for s in visible)
        waiting_count = sum(1 for s in visible if s["kind"] == "waiting")
        done = bool(visible) and all(s["kind"] in INACTIVE for s in visible)

        self.set_waiting_style(waiting)
        self.set_badge(bool(visible), waiting_count)

        if self.session_windows:
            self.sync_session_cards(visible)
            # Rows live in their own windows; the card is only header + usage, even when idle.
            signature = json.dumps(["session-windows"])
            if signature != self.signature:
                self.signature = signature
                self.rebuild_body([], 0, show_lockup=False)
        else:
            signature = json.dumps(
                [[s["name"], s["status"], s["project"], s["time"], s["kind"]] for s in visible] + [hidden_done],
                ensure_ascii=False,
            )
            if signature != self.signature:
                self.signature = signature
                self.rebuild_body(visible, hidden_done)

        if waiting and not self.was_waiting_for_interaction and self.config.get("sound_enabled") is True:
            self.play_notification_sound()
        elif done and not self.was_done and self.config.get("sound_enabled") is True:
            self.play_notification_sound()
        self.was_waiting_for_interaction = waiting
        self.was_done = done

        if self.demo:
            self.demo_index += 1
        return True

    def reset_body(self) -> None:
        self.row_hover_boxes = {}
        # Hiding the old rows sends them synthetic Leave events; let verify_hover() decide
        # after the rebuild instead of tucking the hovered row's sticker right away.
        self.rebuilding = True
        try:
            clear_layout(self.body_layout)
        finally:
            self.rebuilding = False
        self.spinning = []

    def rebuild_body(self, sessions: list[dict[str, object]], hidden_done: int, show_lockup: bool = True) -> None:
        self.reset_body()
        if not sessions and not show_lockup:
            # Session windows are showing the rows: collapse the body to nothing.
            self.body.hide()
            self.resize_to_content()
            return
        self.body.show()
        if not sessions:
            self.build_empty_state()
        else:
            for session in sessions:
                session_id = str(session["id"])
                hover = HoverBox(
                    lambda _box, sid=session_id: self.on_row_enter(sid),
                    lambda box, sid=session_id: self.on_row_leave(box, sid),
                )
                hover_layout = QVBoxLayout(hover)
                hover_layout.setContentsMargins(0, 0, 0, 0)
                hover_layout.addWidget(self.build_row(session, framed=True))
                self.body_layout.addWidget(hover)
                self.row_hover_boxes[session_id] = hover
            if hidden_done > 0:
                footer = comic_label(f"+{hidden_done} finished, hidden automatically", mono_font(sct(10)), "secondary")
                footer.setAlignment(Qt.AlignmentFlag.AlignHCenter)
                self.body_layout.addWidget(footer)

        self.resize_to_content()
        if self.sticker_hovered is not None:
            # The hovered row was rebuilt, so its leave event will never come: re-check once
            # the new rows are laid out and tuck the sticker only if the pointer really left.
            QTimer.singleShot(0, self.verify_hover)

    def build_row(self, session: dict[str, object], framed: bool = False) -> QWidget:
        """One session: jump button, agent disc, stroked name + status chip, project · time.

        Session windows put it straight into their card; the classic list wraps each row in
        an inked inner block (``framed``)."""
        kind = str(session["kind"])
        agent = str(session["agent"])
        dim = kind in INACTIVE

        row = ComicFrame("inner", radius=sc(4), border=sc(2.5)) if framed else QWidget()
        row.setObjectName("row")
        layout = QHBoxLayout(row)
        layout.setContentsMargins(*((sci(10), sci(9), sci(12), sci(9)) if framed else (0, 0, 0, 0)))
        layout.setSpacing(sci(11))

        jump = ComicButton("➜", size=sci(34), bg=theme.YELLOW, fg=theme.INK_ON_COLOUR, hover_bg=theme.YELLOW_HOVER,
                           font=display_font(sc(20)), scale=UI_SCALE)
        jump.setToolTip("Jump to this session's terminal")
        project_name = str(session["project"])
        cwd = str(session["cwd"])
        pids = list(session["client_pids"]) if isinstance(session["client_pids"], list) else []
        console_window = int(session.get("console_window") or 0)
        jump.clicked.connect(
            lambda _checked=False, p=project_name, c=cwd, ids=pids, con=console_window:
            self.switch_to_session(p, c, ids, con)
        )
        layout.addWidget(jump, 0, Qt.AlignmentFlag.AlignVCenter)

        agent_color = theme.AGENT_COLORS.get(agent, STATE_COLORS["neutral"])
        circle = AgentCircle(sci(30), agent_color, self.row_logo_pixmaps.get(agent),
                             initial=str(session["name"])[:1].upper(), border=sc(2.5))
        if dim:
            self.dim_widget(circle)
        layout.addWidget(circle, 0, Qt.AlignmentFlag.AlignVCenter)

        text_box = QWidget()
        text_layout = QVBoxLayout(text_box)
        text_layout.setContentsMargins(0, 0, 0, 0)
        text_layout.setSpacing(sci(3))
        if dim:
            self.dim_widget(text_box)
        layout.addWidget(text_box, 1)

        top = QHBoxLayout()
        top.setSpacing(sci(8))
        text_layout.addLayout(top)
        name = ComicText(str(session["name"]), display_font(sc(24), sc(1.2)), fill=agent_color, stroke=sc(1.3),
                         stroke_color=theme.INK_ON_COLOUR, shadow=sci(2))
        top.addWidget(name, 0, Qt.AlignmentFlag.AlignVCenter)
        status_text = str(session["status"])
        if kind in IN_PROGRESS and not status_text.endswith("…"):
            status_text += "…"
        bg, fg = theme.status_chip(kind, T())
        top.addWidget(Chip(status_text, bg, fg, UI_SCALE), 0, Qt.AlignmentFlag.AlignVCenter)
        top.addStretch(1)

        meta_text = " · ".join(part for part in (str(session["project"]), str(session["time"])) if part)
        if meta_text:
            meta = ElidedLabel(meta_text, color="text_tertiary")
            meta.setFont(mono_font(sct(11)))
            text_layout.addWidget(meta)
        return row

    @staticmethod
    def dim_widget(widget: QWidget) -> None:
        effect = QGraphicsOpacityEffect(widget)
        effect.setOpacity(0.55)
        widget.setGraphicsEffect(effect)

    def build_lockup(self, subtitle: str) -> QWidget:
        """Horizontal lockup: big radar mark + "AI Status Monitor!" + a subtitle line.

        Reused for the startup intro and the idle state (different subtitle each time)."""
        box = QWidget()
        layout = QHBoxLayout(box)
        layout.setContentsMargins(sci(8), sci(14), sci(8), sci(6))
        layout.setSpacing(sci(16))
        layout.addStretch(1)
        logo = RadarLogo(sci(56))
        self.spinning.append(logo)
        layout.addWidget(logo, 0, Qt.AlignmentFlag.AlignVCenter)
        text = QVBoxLayout()
        text.setSpacing(sci(4))
        text.addWidget(ComicText("AI Status Monitor!", display_font(sc(28), sc(1.2)), fill=theme.YELLOW,
                                 stroke=sc(1.5), stroke_color=theme.INK_ON_COLOUR, shadow=sci(2)))
        text.addWidget(comic_label(subtitle, mono_font(sct(11)), "secondary"))
        layout.addLayout(text)
        layout.addStretch(1)
        return box

    def build_empty_state(self) -> None:
        self.body_layout.addWidget(self.build_lockup("no active agents"))

    def build_intro(self) -> None:
        self.reset_body()
        self.body.show()
        self.body_layout.addWidget(self.build_lockup("CLI agent activity"))
        self.set_badge(False, 0)
        self.resize_to_content()

    def end_intro(self) -> bool:
        self.intro = False
        self.signature = None  # force a rebuild from real sessions
        self.refresh_status()
        return False  # one-shot

    def resize_to_content(self) -> None:
        self.adjustSize()
        QTimer.singleShot(0, self.layout_cards)

    def set_badge(self, has_sessions: bool, waiting_count: int) -> None:
        state = "alert" if waiting_count > 0 else "live" if has_sessions else "idle"
        self.badge.set_badge(*theme.badge_style(state, T(), waiting_count))

    # ----------------------------- usage limits -----------------------------
    def render_usage_limits(self) -> None:
        clear_layout(self.usage_rows)
        self.usage_logo_widgets = {}
        self.usage_logo_buttons = {}
        for group in usage_limits.build_usage_groups(self.usage_snapshot):
            provider_key = str(group["provider_key"])
            if provider_key not in self.agents:
                continue
            provider_name = str(group["provider"])
            block = ComicFrame("inner", radius=sc(4), border=sc(2.5))
            grid = QHBoxLayout(block)
            grid.setContentsMargins(sci(12), sci(10), sci(14), sci(10))
            grid.setSpacing(sci(12))

            side = QVBoxLayout()
            side.setSpacing(sci(4))
            circle = AgentCircle(sci(38), theme.AGENT_COLORS.get(provider_key, STATE_COLORS["neutral"]),
                                 self.usage_logo_pixmaps.get(provider_key), initial=provider_name[:1],
                                 shadow=sci(2), interactive=True, border=sc(2.5))
            circle.setEnabled(not self.usage_refreshing)
            circle.setToolTip(f"Refresh {provider_name} usage")
            circle.setAccessibleName(f"Refresh {provider_name} usage")
            circle.clicked.connect(lambda _checked=False, key=provider_key: self.start_usage_refresh(key))
            self.usage_logo_widgets[provider_key] = circle
            self.usage_logo_buttons[provider_key] = circle
            side.addWidget(circle, 0, Qt.AlignmentFlag.AlignHCenter)
            label = comic_label(PROVIDER_LABELS.get(provider_key, provider_name).upper(), mono_font(7), "text")
            label.setAlignment(Qt.AlignmentFlag.AlignHCenter)
            side.addWidget(label, 0, Qt.AlignmentFlag.AlignHCenter)
            side.addStretch(1)
            side_box = QWidget()
            side_box.setLayout(side)
            side_box.setFixedWidth(max(sci(46), label.sizeHint().width()))
            side.setContentsMargins(0, sci(2), 0, 0)
            grid.addWidget(side_box, 0, Qt.AlignmentFlag.AlignTop)

            bars = QVBoxLayout()
            bars.setSpacing(sci(9))
            grid.addLayout(bars, 1)
            for data in group["rows"]:
                state = str(data["state"])
                limit = QVBoxLayout()
                limit.setSpacing(sci(3))
                line = QHBoxLayout()
                line.setSpacing(sci(5))
                window = str(data["window"])
                if window:
                    line.addWidget(comic_label(window.upper(), display_font(sct(16), sc(0.8)), "text"))
                line.addStretch(1)
                used = float(data.get("used_percent") or 0.0)
                tone = theme.bar_tone(used)
                percent = QLabel(str(data["percent_text"]))
                if state == "unavailable":
                    percent.setObjectName("secondary")
                    percent.setFont(body_font(sct(13)))
                else:
                    percent.setFont(display_font(sct(17), sc(0.5)))
                    percent.setStyleSheet(f"color: {T().text_secondary if state == 'stale' else T().bar_inks[tone]};")
                line.addWidget(percent)
                limit.addLayout(line)

                if state != "unavailable":
                    limit.addWidget(ComicBar(float(data["fraction"]), theme.BAR_FILLS[tone], UI_SCALE))
                    reset_text = str(data["reset_text"])
                    if state == "stale":
                        reset_text = f"{reset_text} · stale"
                    if reset_text:
                        reset = comic_label(reset_text, mono_font(sct(10)), "secondary")
                        reset.setAlignment(Qt.AlignmentFlag.AlignRight)
                        limit.addWidget(reset)
                bars.addLayout(limit)
            self.usage_rows.addWidget(block)
        self.resize_to_content()

    # ----------------------------- collapsible limits -----------------------------
    def set_show_limits(self, shown: bool) -> None:
        """Header ▴/▾, Settings or the menu: hide the usage bars, keep the agents' cards."""
        if shown != self.show_limits:
            self.update_setting("AI_STATUS_SHOW_LIMITS", "true" if shown else "false")
        window = self.settings_window
        if window is not None and window.limits_switch.isChecked() != shown:
            window.limits_switch.setChecked(shown)

    def apply_limits_visibility(self) -> None:
        self.usage_panel.setVisible(self.show_limits)
        self.limits_button.setText("▴" if self.show_limits else "▾")
        self.limits_button.setToolTip("Hide usage limits" if self.show_limits else "Show usage limits")
        self.resize_to_content()

    def apply_demo_usage_state(self, index: int) -> None:
        state = self.demo_usage_scenarios[index % len(self.demo_usage_scenarios)]
        refreshing = bool(state["refreshing"])
        if not refreshing:
            self.stop_usage_animation()
        self.usage_snapshot = state["snapshot"]
        self.usage_refreshing = refreshing
        self.usage_refreshing_providers = set(self.agents) if self.usage_refreshing else set()
        self.render_usage_limits()
        if refreshing:
            self.start_usage_animation()

    def start_usage_refresh(self, provider_key: str | None = None, *_args: object) -> bool:
        if self.usage_refreshing or not self.show_limits:
            return False  # hidden limits are not fetched
        if provider_key is None:
            provider_keys = self.agents
        elif provider_key in self.agents:
            provider_keys = (provider_key,)
        else:
            return False
        self.usage_refreshing = True
        self.usage_refreshing_providers = set(provider_keys)
        self.render_usage_limits()
        self.start_usage_animation()

        if self.demo:
            timeout_add(600, self.finish_demo_usage_refresh)
            return False

        def worker() -> None:
            try:
                snapshot = usage_limits.refresh_usage(
                    USAGE_CACHE_FILE,
                    provider_keys=provider_keys,
                )
            except Exception:
                snapshot = {
                    "providers": usage_limits.load_usage_cache(USAGE_CACHE_FILE),
                    "errors": {provider: "unavailable" for provider in provider_keys},
                }
            idle_add(self.on_usage_result, snapshot)

        threading.Thread(target=worker, daemon=True).start()
        return False

    def usage_refresh_tick(self) -> bool:
        self.start_usage_refresh()
        return True

    def on_usage_result(self, snapshot: usage_limits.UsageSnapshot) -> bool:
        if self.closing:
            return False
        self.usage_snapshot = snapshot
        self.note_usage_limits(snapshot, trigger=True)
        self.stop_usage_animation()
        self.usage_refreshing = False
        self.usage_refreshing_providers = set()
        self.render_usage_limits()
        unavailable = sorted(snapshot.get("errors", {}))
        if unavailable:
            log(f"usage unavailable for: {', '.join(unavailable)}")
        return False

    def finish_demo_usage_refresh(self) -> bool:
        if self.closing:
            return False
        self.usage_snapshot = self.demo_usage_scenarios[0]["snapshot"]
        self.stop_usage_animation()
        self.usage_refreshing = False
        self.usage_refreshing_providers = set()
        self.render_usage_limits()
        return False

    def start_usage_animation(self) -> None:
        if self.usage_animation_source_id is not None:
            return
        self.usage_animation_angle = 0.0
        self.usage_animation_source_id = timeout_add(USAGE_ANIMATION_INTERVAL_MS, self.tick_usage_animation)

    def stop_usage_animation(self) -> None:
        source_id = self.usage_animation_source_id
        self.usage_animation_source_id = None
        source_remove(source_id)
        self.usage_animation_angle = 0.0
        for provider_key in self.usage_refreshing_providers:
            logo = self.usage_logo_widgets.get(provider_key)
            if logo is not None:
                logo.angle = 0.0
                logo.queue_draw()

    def tick_usage_animation(self) -> bool:
        if not self.usage_refreshing or not self.usage_refreshing_providers:
            self.usage_animation_source_id = None
            return False
        self.usage_animation_angle = (
            self.usage_animation_angle + USAGE_ROTATION_RADIANS_PER_TICK
        ) % (2 * math.pi)
        for provider_key in self.usage_refreshing_providers:
            logo = self.usage_logo_widgets.get(provider_key)
            if logo is not None:
                logo.angle = self.usage_animation_angle
                logo.queue_draw()
        return True

    def set_waiting_style(self, enabled: bool) -> None:
        set_flag(self.card, "waiting", enabled)
        if not enabled:
            set_flag(self.card, "pulse", False)

    def tick_animation(self) -> bool:
        if self.closing:
            return False
        self.anim_frame += 1
        pulse = self.anim_frame % 8 < 4

        # cards that wait for you pulse their outline red
        if flag(self.card, "waiting"):
            set_flag(self.card, "pulse", pulse)
        for card in self.session_cards.values():
            if flag(card.card, "waiting"):
                set_flag(card.card, "pulse", pulse)

        # slow radar sweep: header mark, plus the intro/idle lockup
        angle = (self.anim_frame * 0.12) % (2 * math.pi)
        for logo in (self.header_icon, *self.spinning):
            logo.angle = angle
            logo.queue_draw()
        return True

    # ----------------------------- sound -----------------------------
    def play_notification_sound(self) -> None:
        platform_support.play_sound(NOTIFICATION_SOUND, log)

    # ----------------------------- window plumbing -----------------------------
    def mousePressEvent(self, event: object) -> None:  # noqa: N802 - Qt API
        button = event.button()
        if button == Qt.MouseButton.LeftButton:
            handle = self.windowHandle()
            if handle is not None:
                handle.startSystemMove()
            return
        if button == Qt.MouseButton.RightButton:
            self.show_menu(event.globalPosition().toPoint())
            return
        super().mousePressEvent(event)

    def keyPressEvent(self, event: object) -> None:  # noqa: N802 - Qt API
        if event.key() in (Qt.Key.Key_Return, Qt.Key.Key_Enter, Qt.Key.Key_Escape):
            return
        super().keyPressEvent(event)

    def build_menu(self) -> QMenu:
        menu = QMenu(self)
        menu.addAction("Settings…").triggered.connect(self.open_settings)
        menu.addMenu(self.build_agents_menu(menu))
        serious = menu.addAction("Serious mode (no stickers)")
        serious.setCheckable(True)
        serious.setChecked(self.serious_mode)
        serious.toggled.connect(self.set_serious_mode)
        limits = menu.addAction("Show usage limits")
        limits.setCheckable(True)
        limits.setChecked(self.show_limits)
        limits.toggled.connect(self.set_show_limits)
        dock = menu.addAction("Dock all session windows")
        dock.setEnabled(any(card.floating for card in self.session_cards.values()))
        dock.triggered.connect(self.dock_all_cards)
        if not self.klipy_api_key:
            menu.addAction("Get GIFs from KLIPY (free key)…").triggered.connect(lambda: self.open_klipy_guide())
        menu.addSeparator()
        menu.addAction("Reload").triggered.connect(self.reload)
        menu.addAction("Open logs folder").triggered.connect(self.open_logs_folder)
        if self.update_available:
            menu.addAction(f"Update to {self.update_available}").triggered.connect(self.run_update)
        else:
            menu.addAction("Check for updates").triggered.connect(self.start_update_check)
        menu.addAction("Quit").triggered.connect(self.quit)
        return menu

    def show_menu(self, position: object) -> None:
        self.build_menu().exec(position)

    def reload(self) -> None:
        self.signature = None
        self.refresh_status()

    # ----------------------------- session windows -----------------------------
    def load_card_positions(self) -> dict[str, dict[str, float]]:
        try:
            loaded = json.loads(SESSION_WINDOWS_FILE.read_text(encoding="utf-8"))
        except (FileNotFoundError, OSError, json.JSONDecodeError):
            return {}
        if not isinstance(loaded, dict):
            return {}
        cutoff = time.time() - SESSION_WINDOW_POSITION_TTL_SECONDS
        positions: dict[str, dict[str, float]] = {}
        for session_id, value in loaded.items():
            if not isinstance(value, dict):
                continue
            x, y, saved = value.get("x"), value.get("y"), value.get("t", 0)
            if all(isinstance(item, (int, float)) and not isinstance(item, bool) for item in (x, y, saved)) and saved >= cutoff:
                positions[str(session_id)] = {"x": int(x), "y": int(y), "t": float(saved)}
        return positions

    def write_card_positions(self) -> None:
        cutoff = time.time() - SESSION_WINDOW_POSITION_TTL_SECONDS
        self.card_positions = {key: value for key, value in self.card_positions.items() if value["t"] >= cutoff}
        try:
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            SESSION_WINDOWS_FILE.write_text(json.dumps(self.card_positions, indent=2) + "\n", encoding="utf-8")
        except OSError as error:
            log(f"failed to save session window positions: {error}")

    def save_card_position(self, session_id: str, x: int, y: int) -> None:
        self.card_positions[session_id] = {"x": int(x), "y": int(y), "t": time.time()}
        self.write_card_positions()

    def sync_session_cards(self, sessions: list[dict[str, object]]) -> None:
        """One window per visible session: create new ones, update, close finished ones."""
        wanted = {str(session["id"]) for session in sessions}
        for session_id in [key for key in self.session_cards if key not in wanted]:
            self.session_cards.pop(session_id).close_card()
            self.card_order.remove(session_id)
        for session in sessions:
            session_id = str(session["id"])
            card = self.session_cards.get(session_id)
            if card is None:
                card = SessionCard(self, session_id)
                self.session_cards[session_id] = card
                self.card_order.append(session_id)
                card.update_session(session)
                saved = self.card_positions.get(session_id)
                if saved is not None:
                    card.floating = True
                    card.move(*self.clamp_to_visible(int(saved["x"]), int(saved["y"])))
                card.show()
                QTimer.singleShot(0, self.apply_window_hints)
            else:
                card.update_session(session)
        self.layout_cards()

    def layout_cards(self) -> None:
        """Stack docked session windows under the widget, oldest first (stable order)."""
        if not self.session_cards or self.closing:
            return
        geometry = self.geometry()
        gap = self.card_gap()
        # Each window holds its card 8 px in, and the card's hard shadow is not part of
        # its visual box: next window top = visual bottom of the card above + gap - 8.
        visual_bottom = geometry.y() + WINDOW_MARGIN + self.card.height() - self.card.shadow
        for index, session_id in enumerate(self.card_order):
            card = self.session_cards[session_id]
            card.set_tilt(POLAROID_TILT_DEG if index % 2 == 0 else -POLAROID_TILT_DEG)
            if card.floating:
                continue
            top = visual_bottom + gap - WINDOW_MARGIN
            card.dock_at(geometry.x(), top)
            visual_bottom = top + WINDOW_MARGIN + card.card.height() - card.card.shadow

    def card_gap(self) -> int:
        """Space between docked cards: room for each card's sticker unless stickers are off."""
        return SESSION_CARD_SPACING + (0 if self.serious_mode else SESSION_CARD_STICKER_ROOM)

    def dock_card(self, session_id: str) -> None:
        card = self.session_cards.get(session_id)
        if card is not None:
            card.floating = False
        if self.card_positions.pop(session_id, None) is not None:
            self.write_card_positions()
        self.layout_cards()

    def dock_all_cards(self) -> None:
        for card in self.session_cards.values():
            card.floating = False
        if self.card_positions:
            self.card_positions = {}
            self.write_card_positions()
        self.layout_cards()

    def close_session_cards(self) -> None:
        for card in self.session_cards.values():
            card.close_card()
        self.session_cards = {}
        self.card_order = []

    # ----------------------------- GIF stickers -----------------------------
    def build_sticker_source(self) -> stickers.StickerSource:
        bubbles, queries = stickers.load_sticker_texts(STICKER_TEXTS_FILE)
        klipy = None
        if self.klipy_api_key:
            klipy = stickers.KlipyClient(
                self.klipy_api_key,
                stickers.load_customer_id(KLIPY_CUSTOMER_ID_FILE),
            )
        return stickers.StickerSource(GIFS_DIR, bubbles, queries, klipy, log=log)

    def update_stickers(self, sessions: list[dict[str, object]]) -> None:
        """Pop a sticker for the session whose sticker status changed (waiting rows first)."""
        current: dict[str, str] = {}
        for session in sessions:
            key = stickers.sticker_for_kind(session["kind"])
            if key is not None:
                current[str(session["id"])] = key
        changed = [session_id for session_id, key in current.items() if self.sticker_kinds.get(session_id) != key]
        self.sticker_kinds = current
        if not self.sticker_primed:
            # Do not greet every already-running session with a sticker on startup.
            self.sticker_primed = True
            return
        overlay = self.sticker_overlay
        owner = self.sticker_owner
        if (
            overlay is not None and overlay.visible and overlay.sticky and owner is not None
            and overlay.choice is not None and current.get(owner) != overlay.choice.key
        ):
            overlay.tuck()
            self.sticker_owner = None
        if changed:
            self.request_sticker(current[changed[0]], changed[0])

    def note_usage_limits(self, snapshot: object, *, trigger: bool) -> None:
        providers = snapshot.get("providers") if isinstance(snapshot, dict) else None
        if not isinstance(providers, dict):
            return
        for provider, limits in providers.items():
            if provider not in self.agents or not isinstance(limits, list):
                continue
            for limit in limits:
                if not isinstance(limit, dict):
                    continue
                used = limit.get("used_percent")
                if not isinstance(used, (int, float)) or used < stickers.LIMIT_THRESHOLD_PERCENT:
                    continue
                token = (str(provider), str(limit.get("window")), str(limit.get("resets_at")))
                if token in self.limits_seen:
                    continue
                self.limits_seen.add(token)
                if trigger:
                    self.request_sticker("limit", f"limit:{provider}")

    def request_sticker(self, key: str, session_id: str, *, sticky: bool | None = None,
                        debounce_ms: int = STICKER_DEBOUNCE_MS) -> None:
        """Debounced: rapid status changes collapse into one sticker for the latest change."""
        if self.serious_mode or self.sticker_overlay is None:
            return
        source_remove(self.sticker_debounce)
        self.sticker_request += 1
        request = self.sticker_request
        is_sticky = key in stickers.STICKY_KEYS if sticky is None else sticky

        def pick_in_background() -> bool:
            self.sticker_debounce = None
            source = self.sticker_source

            def worker() -> None:
                try:
                    choice = source.pick(key)
                except Exception as error:  # never let a sticker take the widget down
                    log(f"sticker: pick failed: {error}")
                    choice = stickers.StickerChoice(key, None, "", "placeholder")
                idle_add(self.show_sticker, request, session_id, choice, is_sticky)

            threading.Thread(target=worker, daemon=True).start()
            return False

        self.sticker_debounce = timeout_add(max(1, debounce_ms), pick_in_background)

    def show_sticker(self, request: int, session_id: str, choice: stickers.StickerChoice, sticky: bool) -> bool:
        overlay = self.sticker_overlay
        if overlay is None or request != self.sticker_request or self.serious_mode or self.closing:
            return False
        self.last_stickers[session_id] = choice
        self.sticker_owner = session_id
        log(f"sticker: {choice.key} from {choice.source} ({choice.label})")
        self.sticker_hovered = None
        self.position_sticker_overlay()
        overlay.present_sticker(choice, sticky)
        return False

    def position_sticker_overlay(self) -> None:
        if self.sticker_overlay is None:
            return
        # The main card's header holds buttons, so its sticker sits just above the card.
        self.sticker_overlay.place_for_card(*card_top_right(self), overlap=-6)

    def on_row_enter(self, session_id: str) -> None:
        overlay = self.sticker_overlay
        if overlay is None or self.serious_mode:
            return
        choice = self.last_stickers.get(session_id)
        if choice is None:
            return
        if overlay.phase in ("in", "shown") and self.sticker_owner == session_id:
            self.sticker_hovered = session_id  # already showing this row's sticker: keep it
            return
        self.sticker_hovered = session_id
        self.sticker_owner = session_id
        self.position_sticker_overlay()
        overlay.present_sticker(choice, sticky=False, hold_ms=None)

    def on_row_leave(self, box: QWidget, session_id: str) -> None:
        if self.rebuilding or self.sticker_hovered != session_id:
            return
        if self.pointer_inside(box):
            return  # a spurious crossing (e.g. a window mapped above): still hovering
        self.sticker_hovered = None
        if self.sticker_overlay is not None:
            self.sticker_overlay.tuck()

    def pointer_inside(self, widget: QWidget) -> bool:
        if not widget.isVisible():
            return False
        return widget.rect().contains(widget.mapFromGlobal(QCursor.pos()))

    def verify_hover(self) -> bool:
        session_id = self.sticker_hovered
        if session_id is None:
            return False
        box = self.row_hover_boxes.get(session_id)
        if box is None or not self.pointer_inside(box):
            self.sticker_hovered = None
            if self.sticker_overlay is not None:
                self.sticker_overlay.tuck()
        return False

    def show_test_sticker(self, key: str | None = None) -> None:
        """Debug / Settings helper: show one sticker now, cycling through every status."""
        if key is None:
            key = stickers.STICKER_KEYS[self.test_sticker_index % len(stickers.STICKER_KEYS)]
            self.test_sticker_index += 1
        self.request_sticker(key, f"test:{key}", sticky=False, debounce_ms=1)

    def set_serious_mode(self, enabled: bool) -> None:
        self.update_setting("AI_STATUS_SERIOUS_MODE", "true" if enabled else "false")
        window = self.settings_window
        if window is not None and window.serious_switch.isChecked() != enabled:
            window.serious_switch.setChecked(enabled)

    def open_klipy_guide(self, _parent: QWidget | None = None) -> None:
        if self.klipy_guide is None:
            self.klipy_guide = KlipyKeyGuide(self)
            self.klipy_guide.show()
            anchor = self.settings_window if self.settings_window is not None else self
            self.place_beside(self.klipy_guide, anchor)
        self.klipy_guide.raise_()
        self.klipy_guide.activateWindow()

    def on_klipy_guide_closed(self, window: KlipyKeyGuide) -> None:
        if self.klipy_guide is window:
            self.klipy_guide = None

    def open_settings(self) -> None:
        if self.settings_window is None:
            self.settings_window = SettingsWindow(self)
            self.settings_window.show()
            self.place_beside(self.settings_window, self)
        self.settings_window.raise_()
        self.settings_window.activateWindow()

    def place_beside(self, window: QWidget, anchor: QWidget, gap: int = 12) -> None:
        """Open a dialog next to the widget (right if it fits, else left) so changes stay visible."""
        window.adjustSize()
        geometry = anchor.frameGeometry()
        screen = QGuiApplication.screenAt(geometry.topLeft()) or QGuiApplication.primaryScreen()
        if screen is None:
            return
        area = screen.availableGeometry()
        size = window.frameGeometry().size()
        window.move(*screen_geometry.place_beside(
            screen_geometry.Rect(geometry.x(), geometry.y(), geometry.width(), geometry.height()),
            (size.width(), size.height()),
            screen_geometry.Rect(area.x(), area.y(), area.width(), area.height()),
            gap,
        ))

    def on_settings_closed(self, window: SettingsWindow) -> None:
        if self.settings_window is window:
            self.settings_window = None

    def sync_settings_window(self) -> None:
        """Keep the open Settings window in step when agents change from the menu."""
        window = self.settings_window
        if window is None:
            return
        for agent, check in window.agent_checks.items():
            if check.isChecked() != (agent in self.agents):
                check.setChecked(agent in self.agents)

    def update_setting(self, key: str, value: str) -> None:
        """Apply one setting to the running widget and save it to the runtime .env."""
        if key == "AI_STATUS_SOUND_ENABLED":
            self.config["sound_enabled"] = value == "true"
        elif key == "AI_STATUS_SERIOUS_MODE":
            self.serious_mode = value == "true"
            if self.serious_mode:
                source_remove(self.sticker_debounce)
                self.sticker_debounce = None
                self.sticker_request += 1
                if self.sticker_overlay is not None:
                    self.sticker_overlay.hide_now()
            for card in self.session_cards.values():
                if self.serious_mode:
                    card.clear_sticker()
                else:
                    card.refresh_sticker()
        elif key == "AI_STATUS_STICKER_ROTATE_SECONDS":
            self.sticker_rotate_seconds = max(0, int(value))
            for card in self.session_cards.values():
                if card.sticker_key is not None:
                    card.schedule_rotation()  # restarts (or stops, for 0) the timer
        elif key == "AI_STATUS_SESSION_WINDOWS":
            self.session_windows = value == "true"
            if not self.session_windows:
                self.close_session_cards()
        elif key == "AI_STATUS_THEME":
            self.apply_theme(value)
        elif key == "AI_STATUS_SHOW_LIMITS":
            self.show_limits = value == "true"
            self.apply_limits_visibility()
            if self.show_limits and not self.demo:
                self.start_usage_refresh()
        elif key == "AI_STATUS_AUTOSTART":
            self.apply_autostart(value == "true")
        elif key == "AI_STATUS_KLIPY_API_KEY":
            self.klipy_api_key = value
            self.sticker_source = self.build_sticker_source()
        elif key == "AI_STATUS_MAX_ROWS":
            self.max_rows = max(1, int(value))
        else:
            for env_key, config_key, _label, _hint in TIMING_SETTINGS:
                if env_key == key:
                    self.config[config_key] = max(0, int(value))
        shown = "(hidden)" if key == "AI_STATUS_KLIPY_API_KEY" and value else value
        log(f"setting {key}={shown}")
        try:
            write_env_value(SETTINGS.env_file, key, value)
        except OSError as error:
            log(f"failed to save {key} to {SETTINGS.env_file}: {error}")
        if key in os.environ:
            log(f"{key} is set in the environment and will override the saved value on restart")
        self.signature = None
        if not self.intro:
            self.refresh_status()

    def apply_autostart(self, enabled: bool) -> None:
        """Write or remove the login entry (same entry the installer writes)."""
        try:
            autostart.set_enabled(enabled, platform_support.home_dir(), WIDGET_DIR, CACHE_DIR,
                                  process_control.widget_interpreter(DATA_DIR))
        except OSError as error:
            log(f"autostart: cannot {'enable' if enabled else 'disable'}: {error}")

    def apply_theme(self, name: str) -> None:
        """Switch dark/light live: new style sheet, rebuilt rows and usage, repaint the rest."""
        set_theme(name)
        self.signature = None
        if self.intro:
            self.build_intro()
        self.render_usage_limits()
        for card in self.session_cards.values():
            card.signature = None
            if card.session is not None:
                card.update_session(card.session)
        for window in QApplication.topLevelWidgets():
            for widget in (window, *window.findChildren(QWidget)):
                widget.update()

    def build_agents_menu(self, parent: QMenu) -> QMenu:
        submenu = QMenu("Show agents", parent)
        group = QActionGroup(submenu)
        group.setExclusive(True)
        for label, agents in AGENT_FILTER_CHOICES:
            action = QAction(label, submenu)
            action.setCheckable(True)
            action.setChecked(agents == self.agents)
            action.triggered.connect(lambda _checked=False, choice=agents: self.set_agents(choice))
            group.addAction(action)
            submenu.addAction(action)
        return submenu

    def set_agents(self, agents: tuple[str, ...]) -> None:
        if agents == self.agents:
            return
        newly_shown = set(agents) - set(self.agents)
        self.agents = agents
        self.update_setting("AI_STATUS_AGENTS", format_agents(agents))
        self.render_usage_limits()
        self.sync_settings_window()
        missing = [
            agent for agent in newly_shown
            if not self.usage_snapshot.get("providers", {}).get(agent)
        ]
        if missing and not self.demo:
            self.start_usage_refresh(missing[0] if len(missing) == 1 else None)

    def start_update_check(self) -> bool:
        """Kick off a one-shot background version check against GitHub.

        Runs in a daemon thread so the (networked, possibly slow) request never
        blocks the Qt main loop; the result is delivered back via idle_add.
        """
        def worker() -> None:
            version = updates.check_for_update()
            if version:
                idle_add(self.on_update_result, version)

        threading.Thread(target=worker, daemon=True).start()
        return False  # one-shot timeout

    def on_update_result(self, version: str) -> bool:
        if self.closing:
            return False
        self.update_available = version
        self.update_button.setText(f"update {version} ↑")
        self.update_button.show()
        self.resize_to_content()
        log(f"update available: {version}")
        return False

    def run_update(self, *_args: object) -> None:
        if self.updating:
            return
        if not UPDATE_SCRIPT.exists():
            log(f"update script not found: {UPDATE_SCRIPT}")
            return
        self.updating = True
        self.update_button.setText("updating…")
        self.update_button.setEnabled(False)
        log("starting self-update")
        try:
            # Detach so the updater (which stops and restarts this widget via the
            # installer) outlives the process it is replacing. It runs with the base
            # interpreter, not the widget's venv.
            with open(LOG_FILE, "a", encoding="utf-8") as logfile:
                subprocess.Popen(
                    [process_control.base_interpreter(DATA_DIR), str(UPDATE_SCRIPT)],
                    stdin=subprocess.DEVNULL,
                    stdout=logfile,
                    stderr=logfile,
                    **platform_support.detached_flags(),
                )
        except OSError as error:
            self.updating = False
            self.update_button.setEnabled(True)
            log(f"failed to start update: {error}")

    def open_logs_folder(self) -> None:
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        if not QDesktopServices.openUrl(QUrl.fromLocalFile(str(CACHE_DIR))):
            if not platform_support.open_path(CACHE_DIR):
                log(f"cannot open {CACHE_DIR}: no file manager opener available")

    def monitor_workareas(self) -> list[screen_geometry.Rect]:
        """Work areas of the connected monitors, in virtual-screen coordinates."""
        areas = []
        for screen in QGuiApplication.screens():
            area = screen.availableGeometry()
            areas.append(screen_geometry.Rect(area.x(), area.y(), area.width(), area.height()))
        return areas

    def clamp_to_visible(self, x: int, y: int) -> tuple[int, int]:
        return screen_geometry.clamp_to_visible(x, y, self.monitor_workareas(), CARD_WIDTH, log)

    def restore_position(self) -> None:
        try:
            data = json.loads(WIDGET_CONFIG.read_text(encoding="utf-8"))
            x = int(data.get("x", 40))
            y = int(data.get("y", 80))
        except Exception:
            x, y = 40, 80
        self.move(*self.clamp_to_visible(x, y))

    def save_position(self) -> None:
        try:
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            self.write_config({"x": self.x(), "y": self.y()})
        except OSError as error:
            log(f"failed to save position: {error}")

    def moveEvent(self, event: object) -> None:  # noqa: N802 - Qt API
        super().moveEvent(event)
        if self.closing or not self.isVisible():
            return
        self.save_position()
        if self.sticker_overlay is not None and self.sticker_overlay.visible:
            self.position_sticker_overlay()
        self.layout_cards()

    def resizeEvent(self, event: object) -> None:  # noqa: N802 - Qt API
        super().resizeEvent(event)
        if self.sticker_overlay is not None and self.sticker_overlay.visible:
            self.position_sticker_overlay()
        if not self.closing:
            self.layout_cards()

    def closeEvent(self, event: object) -> None:  # noqa: N802 - Qt API
        self.quit()
        super().closeEvent(event)

    def shutdown(self) -> None:
        """Stop timers and close every window this widget owns (without quitting Qt)."""
        if self.closing:
            return
        self.closing = True
        for timer in self.timers:
            source_remove(timer)
        self.timers = []
        source_remove(self.sticker_debounce)
        self.sticker_debounce = None
        self.stop_usage_animation()
        if self.sticker_overlay is not None:
            self.sticker_overlay.hide_now()
        self.close_session_cards()
        for window in (self.settings_window, self.klipy_guide):
            if window is not None:
                window.close()
        self.hide()
        if self.x11 is not None:
            self.x11.close()
            self.x11 = None
        # Run the pending deleteLater()s now: once the event loop has ended, objects still
        # waiting for deferred deletion are torn down during interpreter exit, which crashes.
        QApplication.sendPostedEvents(None, QEvent.Type.DeferredDelete)

    def quit(self, *_args: object) -> None:
        if not self.closing and self.isVisible():
            self.save_position()
        self.shutdown()
        app = QApplication.instance()
        if app is not None:
            app.quit()

    def switch_to_session(self, project: str, cwd: str, client_pids: list[int], console_window: int = 0) -> None:
        """Raise the terminal window of a session (see ai_agent_status_lib.window_switch)."""
        window_switch.switch_to_session(project, cwd, client_pids, console_window=console_window, log=log)

    def own_window_id(self) -> str | None:
        """This widget's X11 window id as wmctrl expects it (hex), or None off X11."""
        return window_id_of(self)

    def x11_windows(self) -> list[QWidget]:
        return [self, *(card for card in self.session_cards.values() if not card.closed)]

    def apply_window_hints(self) -> bool:
        """X11 only: keep the widget and cards above, on every workspace, off the taskbar.

        Talks EWMH directly through libX11 (see ai_agent_status_lib.x11_hints); falls back to
        wmctrl when libX11 cannot be loaded. Returns False (stopping the timer) off X11.
        """
        if self.closing or QGuiApplication.platformName() != "xcb":
            return False
        if not self.x11_checked:
            self.x11_checked = True
            self.x11 = x11_hints.X11Hints.open(log)
            if self.x11 is None:
                log("libX11 not available: keeping windows on top with wmctrl")
        if self.x11 is None:
            return self.apply_wmctrl_hints()
        for window in self.x11_windows():
            if not window.isVisible():
                continue
            try:
                self.x11.apply(int(window.winId()))
            except Exception as error:  # never let a window-manager hint take the widget down
                log(f"X11 hints failed: {error}")
                return False
        return True

    def apply_wmctrl_hints(self) -> bool:
        """Fallback for apply_window_hints(): the same EWMH state requests through wmctrl."""
        if self.closing or QGuiApplication.platformName() != "xcb":
            return False
        wmctrl = shutil.which("wmctrl")
        if not wmctrl:
            return False  # nothing to reinforce; stop the timer
        # Target our own window by id. Matching by title (`wmctrl -r TITLE`) hits the first
        # window whose title merely *contains* it, e.g. a terminal whose title mentions
        # "AI Agents Status", which then becomes sticky instead of the widget.
        window_id = self.own_window_id()
        targets = [["-i", "-r", window_id] if window_id else ["-r", TITLE]]
        for card in self.session_cards.values():
            card_id = window_id_of(card)
            if card_id:
                targets.append(["-i", "-r", card_id])
        for target in targets:
            try:
                subprocess.run(
                    [wmctrl, *target, "-b", "add,above,sticky,skip_taskbar"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    check=False,
                )
            except OSError as error:
                log(f"wmctrl failed: {error}")
                return False
        return True  # repeat: re-assert above/sticky/skip_taskbar as the WM drops them


def main() -> int:
    parser = argparse.ArgumentParser(description="Floating Qt widget for ai-cli-status-monitor.")
    parser.add_argument("--demo", action="store_true", help="cycle through demo states")
    parser.add_argument("--version", action="store_true", help="print the installed version and exit")
    parser.add_argument(
        "--sticker",
        choices=(*stickers.STICKER_KEYS, "all"),
        help="debug: show this GIF sticker after the intro ('all' cycles through every status)",
    )
    args = parser.parse_args()

    if args.version:
        print(updates.installed_version())
        return 0

    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    if LEGACY_STICKER_CACHE_DIR.is_dir():
        shutil.rmtree(LEGACY_STICKER_CACHE_DIR, ignore_errors=True)
        log("removed the old on-disk KLIPY GIF cache (KLIPY media is now loaded directly)")
    for warning in CONFIG_WARNINGS:
        log(f"configuration: {warning}")
    PID_FILE.write_text(f"{os.getpid()}\n", encoding="utf-8")
    app = ensure_app()
    widget = StatusWidget(demo=args.demo)
    widget.show()

    # Quit cleanly (saving the position) on Ctrl+C / `kill`; Python only sees signals
    # while it runs, so a cheap timer hands control back to the interpreter.
    for signum in (signal.SIGINT, getattr(signal, "SIGTERM", None)):
        if signum is not None:
            signal.signal(signum, lambda *_args: QTimer.singleShot(0, widget.quit))
    timeout_add(500, lambda: True)

    if args.sticker:
        def show_debug_sticker() -> bool:
            if args.sticker == "all":
                widget.show_test_sticker()
                return True  # keep cycling, one status every 5 s
            widget.show_test_sticker(args.sticker)
            return False

        def start_debug_stickers() -> bool:
            if show_debug_sticker():
                timeout_add(5000, show_debug_sticker)
            return False

        timeout_add(3500, start_debug_stickers)
    log(f"widget started ({QGuiApplication.platformName()})" + (" in demo mode" if args.demo else ""))
    app.exec()
    log("widget stopped")
    try:
        PID_FILE.unlink()
    except OSError:
        pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
