def log(message: str) -> None:
    try:
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        with LOG_FILE.open("a", encoding="utf-8") as handle:
            handle.write(f"{datetime.now().isoformat(timespec='seconds')} {message}\n")
    except OSError:
        pass


def reexec_with_widget_python() -> None:
    """Without PySide6 here, re-run under the interpreter the installer prepared (its venv)."""
    candidate = process_control.load_interpreters(DATA_DIR).get("widget")
    if not candidate or os.environ.get("AI_STATUS_WIDGET_REEXEC"):
        return
    # Compare paths, not resolved files: a venv's python is a symlink to the base one.
    if os.path.abspath(candidate) == os.path.abspath(sys.executable):
        return
    os.environ["AI_STATUS_WIDGET_REEXEC"] = "1"
    argv = [candidate, str(Path(__file__).resolve()), *sys.argv[1:]]
    if platform_support.PLATFORM == platform_support.WINDOWS:
        argv[0] = platform_support.gui_python(candidate)
        raise SystemExit(subprocess.call(argv, **platform_support.hidden_window_flags()))
    os.execv(candidate, argv)


