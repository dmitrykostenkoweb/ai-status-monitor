    # ----------------------------- config -----------------------------
    def load_config(self) -> dict[str, object]:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        return dict(DEFAULT_CONFIG)

    def write_config(self, values: dict[str, object]) -> None:
        try:
            current = {}
            if WIDGET_CONFIG.exists():
                loaded = json.loads(WIDGET_CONFIG.read_text(encoding="utf-8"))
                if isinstance(loaded, dict):
                    current = loaded
            current.update(values)
            WIDGET_CONFIG.write_text(json.dumps(current, indent=2) + "\n", encoding="utf-8")
        except (json.JSONDecodeError, OSError) as error:
            log(f"failed to write widget config: {error}")

    def load_logos(self, size: int = 14) -> dict[str, GdkPixbuf.Pixbuf]:
        logos: dict[str, GdkPixbuf.Pixbuf] = {}
        for agent, path in (("claude", ANTHROPIC_LOGO), ("codex", OPENAI_LOGO)):
            if not path.exists():
                log(f"logo missing for {agent}: {path}")
                continue
            try:
                logos[agent] = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(path), size, size, True)
            except Exception as error:
                log(f"failed to load logo for {agent}: {error}")
        return logos

    def config_seconds(self, key: str) -> int:
        value = self.config.get(key, DEFAULT_CONFIG[key])
        return value if isinstance(value, int) else int(DEFAULT_CONFIG[key])

    def config_timedelta(self, key: str) -> timedelta:
        return timedelta(seconds=self.config_seconds(key))

    # ----------------------------- data -----------------------------
    def collect_sessions(self) -> list[dict[str, object]]:
        if self.demo:
            # Rotate every 4 s so session windows' stickers have time to show.
            scenario = self.demo_scenarios[(self.demo_index // 4) % len(self.demo_scenarios)]
            sessions = []
            for agent, status, project, hhmm in scenario:
                session = self.make_session(agent, status, project, hhmm)
                session["id"] = f"{agent}:{project}"
                sessions.append(session)
        else:
            structured = self.read_structured_sessions()
            sessions = structured if structured is not None else self.read_combined_sessions()
        return [session for session in sessions if self.agent_enabled(str(session["agent"]))]

    def agent_enabled(self, agent: str) -> bool:
        """Sessions of an unrecognised agent stay visible only while every agent is shown."""
        if agent in SUPPORTED_AGENTS:
            return agent in self.agents
        return self.agents == SUPPORTED_AGENTS

    def make_session(
        self,
        agent: str,
        status: str,
        project: str,
        hhmm: str,
        cwd: str = "",
        client_pids: list[int] | None = None,
        kind: StatusKind | str | None = None,
        source_kind: StatusKind | str | None = None,
    ) -> dict[str, object]:
        normalized_kind = normalize_kind(kind, status)
        original_kind = normalize_kind(source_kind if source_kind is not None else normalized_kind, status)
        return {
            "agent": agent if agent in AGENT_NAME_COLORS else "",
            "name": agent.capitalize() if agent else "AI",
            "status": status,
            "kind": normalized_kind,
            "source_kind": original_kind,
            "project": project,
            "time": hhmm,
            "cwd": cwd,
            "client_pids": client_pids or [],
            "id": f"{agent}:{project}",
            "activity": None,
            "color": STATE_COLORS.get(normalized_kind, STATE_COLORS["neutral"]),
        }

    def read_structured_sessions(self) -> list[dict[str, object]] | None:
        paths = self.status_file_paths()
        if not paths:
            return None
        sessions: list[dict[str, object]] = []
        for path in paths:
            if not path.exists():
                continue
            try:
                data = json.loads(path.read_text(encoding="utf-8"))
            except (json.JSONDecodeError, OSError) as error:
                log(f"failed to read status json {path}: {error}")
                continue
            if not isinstance(data, dict):
                continue
            status = str(data.get("status") or "")
            project = str(data.get("project") or "")
            hhmm = str(data.get("timestamp_hhmm") or "")
            agent = str(data.get("agent") or path.stem).lower()
            cwd = str(data.get("cwd") or "")
            source_kind = normalize_kind(data.get("kind"), status)
            display_kind: StatusKind = source_kind
            raw_pids = data.get("client_pids")
            client_pids = [p for p in raw_pids if isinstance(p, int)] if isinstance(raw_pids, list) else []
            age = self.status_age(str(data.get("timestamp_iso") or ""))
            if age is not None:
                if self.should_hide_status(source_kind, status, age):
                    continue
                if age >= self.config_timedelta("hide_stale_after_seconds"):
                    continue
                if age >= self.config_timedelta("idle_after_seconds"):
                    status, project, display_kind = f"{agent.capitalize()}: idle", "", "idle"
                elif age >= self.config_timedelta("stale_after_seconds"):
                    status = f"{agent.capitalize()}: no new events"
                    display_kind = "stale"
            if not status:
                continue
            name, clean = self.split_agent_status(status, agent)
            session = self.make_session(agent, clean, project, hhmm, cwd, client_pids, display_kind, source_kind)
            session["name"] = name
            session["id"] = path.stem
            if display_kind == source_kind:  # a stale/idle row is no longer doing it
                session["activity"] = parse_activity(data.get("activity"))
            sessions.append(session)
        return sessions

    def read_combined_sessions(self) -> list[dict[str, object]]:
        try:
            raw = STATUS_FILE.read_text(encoding="utf-8").strip()
        except OSError:
            return []
        sessions: list[dict[str, object]] = []
        for line in raw.splitlines():
            line = line.strip()
            if not line:
                continue
            project, hhmm = "", ""
            text = line
            if "[" in text and "]" in text:
                before, _, rest = text.partition("[")
                project, _, after = rest.partition("]")
                text = before.strip()
                hhmm = after.strip()
            agent = "claude" if "claude" in line.lower() else ("codex" if "codex" in line.lower() else "")
            name, clean = self.split_agent_status(text, agent)
            session = self.make_session(agent, clean, project.strip(), hhmm)
            session["name"] = name
            session["id"] = f"{agent}:{project.strip()}"
            sessions.append(session)
        return sessions

    def split_agent_status(self, status: str, agent: str) -> tuple[str, str]:
        name = agent.capitalize() if agent in AGENT_NAME_COLORS else "AI"
        clean = status
        for prefix in ("Claude:", "Codex subagent:", "Codex:"):
            if clean.startswith(prefix):
                if prefix == "Codex subagent:":
                    name = "Codex subagent"
                clean = clean[len(prefix):]
                break
        return name, " ".join(clean.split())

    def status_file_paths(self) -> list[Path]:
        paths = list(STATUS_DIR.glob("*.json")) if STATUS_DIR.exists() else []
        if paths:
            paths.sort(key=self.status_file_timestamp, reverse=True)
            return paths
        return [path for path in AGENT_STATUS_FILES if path.exists()]

    def status_file_timestamp(self, path: Path) -> str:
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError):
            return ""
        if not isinstance(data, dict):
            return ""
        value = data.get("timestamp_iso")
        return value if isinstance(value, str) else ""

    def status_age(self, timestamp_iso: str) -> timedelta | None:
        if not timestamp_iso:
            return None
        try:
            timestamp = datetime.fromisoformat(timestamp_iso)
        except ValueError:
            return None
        return datetime.now() - timestamp

    def should_hide_status(self, kind: StatusKind, _status: str, age: timedelta) -> bool:
        # Legacy text has already been normalized into `kind` by the loader.
        return kind == "done" and age >= self.config_timedelta("hide_done_after_seconds")

    # ----------------------------- render -----------------------------
    def order_sessions(self, sessions: list[dict[str, object]]) -> list[dict[str, object]]:
        priority = {"waiting": 0, "error": 1}

        def rank(session: dict[str, object]) -> tuple[int, int]:
            kind = str(session["kind"])
            if kind in priority:
                return (priority[kind], 0)
            if kind in IN_PROGRESS:
                return (2, 0)
            return (3, 0)  # done / idle / stale last

        return sorted(sessions, key=rank)

    def refresh_status(self) -> bool:
        # Cheaply re-assert "always on top" every tick: GNOME/Mutter keeps
        # dropping _NET_WM_STATE_ABOVE, and this GTK call is a no-op when the
        # state already holds, so it is safe to repeat.
        self.set_keep_above(True)
        if self.intro:
            return True  # the startup lockup owns the body until end_intro()
        if self.demo:
            self.apply_demo_usage_state(self.demo_index)
        sessions = self.order_sessions(self.collect_sessions())
        if not self.demo and not self.session_windows:
            # In the classic list one sticker pops on change; session windows own theirs.
            self.update_stickers(sessions)
        visible = sessions[:self.max_rows]
        hidden_done = sum(1 for s in sessions[self.max_rows:] if s["kind"] in INACTIVE)

        waiting = any(s["kind"] == "waiting" for s in visible)
        waiting_count = sum(1 for s in visible if s["kind"] == "waiting")
        done = bool(visible) and all(s["kind"] in INACTIVE for s in visible)

        self.set_waiting_style(waiting)
        self.set_badge(bool(visible), waiting_count)

        if self.session_windows:
            self.sync_session_cards(visible)
            # Rows live in their own windows; the card is only header + usage, even when idle.
            signature = json.dumps(["session-windows"])
            if signature != self.signature:
                self.signature = signature
                self.rebuild_body([], 0, show_lockup=False)
        else:
            signature = json.dumps(
                [[s["name"], s["status"], s["project"], s["time"], s["kind"]] for s in visible] + [hidden_done],
                ensure_ascii=False,
            )
            if signature != self.signature:
                self.signature = signature
                self.rebuild_body(visible, hidden_done)

        if waiting and not self.was_waiting_for_interaction and self.config.get("sound_enabled") is True:
            self.play_notification_sound()
        elif done and not self.was_done and self.config.get("sound_enabled") is True:
            self.play_notification_sound()
        self.was_waiting_for_interaction = waiting
        self.was_done = done

        if self.demo:
            self.demo_index += 1
        return True

    def rebuild_body(self, sessions: list[dict[str, object]], hidden_done: int, show_lockup: bool = True) -> None:
        self.row_hover_boxes = {}
        for child in self.body.get_children():
            self.body.remove(child)
        self.anim_dot_labels = []
        self.waiting_dots = []
        self.spinning = []

        if not sessions and not show_lockup:
            # Session windows are showing the rows: collapse the body to nothing.
            self.body.set_no_show_all(True)
            self.body.hide()
            self.resize_to_content()
            return
        self.body.set_no_show_all(False)
        self.body.show()
        if not sessions:
            self.build_empty_state()
        else:
            for session in sessions:
                hover = Gtk.EventBox()
                hover.set_visible_window(False)
                hover.add(self.build_row(session))
                session_id = str(session["id"])
                hover.connect("enter-notify-event", self.on_row_enter, session_id)
                hover.connect("leave-notify-event", self.on_row_leave, session_id)
                self.body.pack_start(hover, False, False, 0)
                self.row_hover_boxes[session_id] = hover
            if hidden_done > 0:
                footer = Gtk.Label(label=f"+{hidden_done} finished, hidden automatically")
                footer.set_name("footer")
                self.body.pack_start(footer, False, False, 0)

        self.body.show_all()
        self.resize_to_content()
        if self.sticker_hovered is not None:
            # The hovered row was rebuilt, so its leave event will never come: re-check once
            # the new rows are laid out and tuck the sticker only if the pointer really left.
            GLib.idle_add(self.verify_hover)

    def build_row(
        self,
        session: dict[str, object],
        waiting_dots: list[StatusDot] | None = None,
        dot_labels: list[Gtk.Label] | None = None,
    ) -> Gtk.Widget:
        """One session row. Animated parts register in the given lists (a session window's own),
        defaulting to the main widget's lists that `tick_animation` drives."""
        waiting_dots = self.waiting_dots if waiting_dots is None else waiting_dots
        dot_labels = self.anim_dot_labels if dot_labels is None else dot_labels
        kind = str(session["kind"])
        color = str(session["color"])
        agent = str(session["agent"])
        waiting = kind == "waiting"

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=11)
        row.set_name("row")
        if waiting:
            row.get_style_context().add_class("alertRow")
        dim = kind in INACTIVE

        dot = StatusDot()
        dot.configure_dot(color, waiting)
        if waiting:
            waiting_dots.append(dot)
        dot.set_valign(Gtk.Align.START)
        dot.set_margin_top(4)
        row.pack_start(dot, False, False, 0)

        logo_box = Gtk.Box()
        logo_box.set_name("logoBox")
        if agent in ("claude", "codex"):
            logo_box.get_style_context().add_class(agent)
        logo_box.set_size_request(24, 24)
        logo_box.set_valign(Gtk.Align.START)
        logo_box.set_halign(Gtk.Align.CENTER)
        pixbuf = self.logo_pixbufs.get(agent)
        if pixbuf is not None:
            image = Gtk.Image.new_from_pixbuf(pixbuf)
            image.set_halign(Gtk.Align.CENTER)
            image.set_valign(Gtk.Align.CENTER)
            logo_box.pack_start(image, True, True, 0)
        if dim:
            logo_box.get_style_context().add_class("dim")
        row.pack_start(logo_box, False, False, 0)

        text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        if dim:
            text_box.get_style_context().add_class("dim")
        row.pack_start(text_box, True, True, 0)

        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        text_box.pack_start(top, False, False, 0)

        name = Gtk.Label()
        name.set_name("agentName")
        name.set_xalign(0)
        name.set_markup(self.markup(str(session["name"]), AGENT_NAME_COLORS.get(agent, "#9AA4B2")))
        top.pack_start(name, False, False, 0)

        status = Gtk.Label()
        status.set_name("statusText")
        status.set_xalign(0)
        status.set_ellipsize(Pango.EllipsizeMode.END)
        status.set_markup(self.markup(str(session["status"]), color))
        top.pack_start(status, False, False, 0)

        if kind in IN_PROGRESS:
            dots = Gtk.Label()
            dots.set_name("statusText")
            dots.set_xalign(0)
            dots.set_markup(self.markup("", color))
            dots.base_color = color  # type: ignore[attr-defined]
            dot_labels.append(dots)
            top.pack_start(dots, False, False, 0)

        meta_text = " · ".join(part for part in (str(session["project"]), str(session["time"])) if part)
        if meta_text:
            meta = Gtk.Label(label=meta_text)
            meta.set_name("meta")
            meta.set_xalign(0)
            meta.set_ellipsize(Pango.EllipsizeMode.END)
            text_box.pack_start(meta, False, False, 0)

        # `→` is shown on every row (not just alerts) and wired to this session.
        switch = Gtk.Button(label="→")
        switch.set_name("altText")
        switch.set_relief(Gtk.ReliefStyle.NONE)
        switch.set_can_focus(False)
        switch.set_focus_on_click(False)
        switch.set_valign(Gtk.Align.CENTER)
        switch.set_margin_end(2)
        switch.set_tooltip_text("Switch to this session's window")
        project_name = str(session["project"])
        cwd = str(session["cwd"])
        pids = list(session["client_pids"]) if isinstance(session["client_pids"], list) else []
        switch.connect(
            "clicked",
            lambda _b, p=project_name, c=cwd, ids=pids: self.switch_to_session(p, c, ids),
        )
        row.pack_end(switch, False, False, 0)

        return row

    def build_lockup(self, subtitle: str) -> Gtk.Widget:
        """Horizontal lockup: full radar logo + 'AI Status Monitor' + a subtitle line.

        Reused for the startup intro and the idle state (different subtitle each time)."""
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        box.set_halign(Gtk.Align.CENTER)
        box.set_margin_top(22)
        box.set_margin_bottom(24)
        box.set_margin_start(18)
        box.set_margin_end(18)

        logo = LogoMark(54, variant="full", sweep=True, tile=True)
        logo.set_valign(Gtk.Align.CENTER)
        self.spinning.append(logo)
        box.pack_start(logo, False, False, 0)

        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        text.set_valign(Gtk.Align.CENTER)
        title = Gtk.Label()
        title.set_name("lockupTitle")
        title.set_xalign(0)
        title.set_markup('<span foreground="#E6EDF3">AI Status</span>'
                         '<span foreground="#2DD4BF"> Monitor</span>')
        text.pack_start(title, False, False, 0)
        sub = Gtk.Label(label=subtitle)
        sub.set_name("lockupSub")
        sub.set_xalign(0)
        text.pack_start(sub, False, False, 0)
        box.pack_start(text, False, False, 0)
        return box

    def build_empty_state(self) -> None:
        self.body.pack_start(self.build_lockup("no active agents"), True, True, 0)

    def build_intro(self) -> None:
        for child in self.body.get_children():
            self.body.remove(child)
        self.anim_dot_labels = []
        self.waiting_dots = []
        self.spinning = []
        self.body.pack_start(self.build_lockup("CLI agent activity"), True, True, 0)
        self.set_badge(False, 0)
        self.body.show_all()
        self.resize_to_content()

    def end_intro(self) -> bool:
        self.intro = False
        self.signature = None  # force a rebuild from real sessions
        self.refresh_status()
        return False  # one-shot

    def resize_to_content(self) -> None:
        try:
            _minimum, natural = self.get_preferred_size()
            self.resize(max(natural.width, CARD_WIDTH + 16), max(natural.height, 1))
        except Exception as error:
            log(f"resize failed: {error}")
        GLib.idle_add(self.layout_cards_once)

    def markup(self, value: str, color: str) -> str:
        return f'<span foreground="{color}">{html.escape(value)}</span>'

    def set_badge(self, has_sessions: bool, waiting_count: int) -> None:
        context = self.badge.get_style_context()
        for cls in ("live", "alert", "idle"):
            context.remove_class(cls)
        if waiting_count > 0:
            context.add_class("alert")
            self.badge.set_markup(self.markup(f"▲ {waiting_count} ALERT", "#FB7060"))
        elif has_sessions:
            context.add_class("live")
            alpha = "#4ADE80" if self.anim_frame % 8 < 4 else "#2f9c5a"
            self.badge.set_markup(self.markup("● LIVE", alpha))
        else:
            context.add_class("idle")
            self.badge.set_markup(self.markup("● IDLE", "#6B7785"))

    # ----------------------------- usage limits -----------------------------
    def render_usage_limits(self) -> None:
        for child in self.usage_rows.get_children():
            self.usage_rows.remove(child)

        self.usage_logo_widgets = {}
        self.usage_logo_buttons = {}
        for group in usage_limits.build_usage_groups(self.usage_snapshot):
            provider_key = str(group["provider_key"])
            if provider_key not in self.agents:
                continue
            provider_name = str(group["provider"])
            block = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
            block.set_name("usageProviderBlock")

            logo_button = Gtk.Button()
            logo_button.set_name("usageProviderButton")
            logo_button.set_relief(Gtk.ReliefStyle.NONE)
            logo_button.set_focus_on_click(False)
            logo_button.set_valign(Gtk.Align.CENTER)
            logo_button.set_halign(Gtk.Align.CENTER)
            logo_button.set_sensitive(not self.usage_refreshing)
            logo_button.set_tooltip_text(f"Refresh {provider_name} usage")
            logo_button.get_accessible().set_name(f"Refresh {provider_name} usage")
            logo_button.connect(
                "clicked",
                lambda _button, key=provider_key: self.start_usage_refresh(key),
            )
            pixbuf = self.usage_logo_pixbufs.get(provider_key)
            if pixbuf is not None and CAIRO_OK:
                logo = RotatingProviderLogo(pixbuf)
                self.usage_logo_widgets[provider_key] = logo
                logo_button.add(logo)
            elif pixbuf is not None:
                logo_button.add(Gtk.Image.new_from_pixbuf(pixbuf))
            else:
                fallback = Gtk.Label(label=provider_name)
                fallback.set_name("usageProviderFallback")
                logo_button.add(fallback)
            self.usage_logo_buttons[provider_key] = logo_button
            block.pack_start(logo_button, False, False, 0)

            limit_stack = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            limit_stack.set_name("usageLimitStack")
            block.pack_start(limit_stack, True, True, 0)

            for data in group["rows"]:
                limit = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
                limit.set_name("usageLimit")
                state = str(data["state"])
                if state != "current":
                    limit.get_style_context().add_class(state)

                line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5)
                limit.pack_start(line, False, False, 0)

                window = str(data["window"])
                if window:
                    window_label = Gtk.Label(label=window)
                    window_label.set_name("usageWindow")
                    window_label.set_xalign(0)
                    line.pack_start(window_label, False, False, 0)

                percent = Gtk.Label(label=str(data["percent_text"]))
                percent.set_name("usagePercent")
                percent.set_xalign(1)
                line.pack_end(percent, False, False, 0)

                if state != "unavailable":
                    progress = Gtk.ProgressBar()
                    progress.set_name("usageProgress")
                    progress.set_fraction(float(data["fraction"]))
                    color_class = str(data["color_class"])
                    if color_class:
                        progress.get_style_context().add_class(color_class)
                    limit.pack_start(progress, False, False, 0)

                    reset_text = str(data["reset_text"])
                    if state == "stale":
                        reset_text = f"{reset_text} · stale"
                    if reset_text:
                        reset = Gtk.Label(label=reset_text)
                        reset.set_name("usageReset")
                        reset.set_xalign(1)
                        limit.pack_start(reset, False, False, 0)

                limit_stack.pack_start(limit, False, False, 0)

            self.usage_rows.pack_start(block, False, False, 0)

        self.usage_rows.show_all()
        self.resize_to_content()

    def apply_demo_usage_state(self, index: int) -> None:
        state = self.demo_usage_scenarios[index % len(self.demo_usage_scenarios)]
        refreshing = bool(state["refreshing"])
        if not refreshing:
            self.stop_usage_animation()
        self.usage_snapshot = state["snapshot"]
        self.usage_refreshing = refreshing
        self.usage_refreshing_providers = set(self.agents) if self.usage_refreshing else set()
        self.render_usage_limits()
        if refreshing:
            self.start_usage_animation()

    def start_usage_refresh(self, provider_key: str | None = None, *_args: object) -> bool:
        if self.usage_refreshing:
            return False
        if provider_key is None:
            provider_keys = self.agents
        elif provider_key in self.agents:
            provider_keys = (provider_key,)
        else:
            return False
        self.usage_refreshing = True
        self.usage_refreshing_providers = set(provider_keys)
        self.render_usage_limits()
        self.start_usage_animation()

        if self.demo:
            GLib.timeout_add(600, self.finish_demo_usage_refresh)
            return False

        def worker() -> None:
            try:
                snapshot = usage_limits.refresh_usage(
                    USAGE_CACHE_FILE,
                    provider_keys=provider_keys,
                )
            except Exception:
                snapshot = {
                    "providers": usage_limits.load_usage_cache(USAGE_CACHE_FILE),
                    "errors": {provider: "unavailable" for provider in provider_keys},
                }
            GLib.idle_add(self.on_usage_result, snapshot)

        threading.Thread(target=worker, daemon=True).start()
        return False

    def usage_refresh_tick(self) -> bool:
        self.start_usage_refresh()
        return True

    def on_usage_result(self, snapshot: usage_limits.UsageSnapshot) -> bool:
        self.usage_snapshot = snapshot
        self.note_usage_limits(snapshot, trigger=True)
        self.stop_usage_animation()
        self.usage_refreshing = False
        self.usage_refreshing_providers = set()
        self.render_usage_limits()
        unavailable = sorted(snapshot.get("errors", {}))
        if unavailable:
            log(f"usage unavailable for: {', '.join(unavailable)}")
        return False

    def finish_demo_usage_refresh(self) -> bool:
        self.usage_snapshot = self.demo_usage_scenarios[0]["snapshot"]
        self.stop_usage_animation()
        self.usage_refreshing = False
        self.usage_refreshing_providers = set()
        self.render_usage_limits()
        return False

    def start_usage_animation(self) -> None:
        if self.usage_animation_source_id is not None:
            return
        self.usage_animation_angle = 0.0
        self.usage_animation_source_id = GLib.timeout_add(
            USAGE_ANIMATION_INTERVAL_MS,
            self.tick_usage_animation,
        )

    def stop_usage_animation(self) -> None:
        source_id = self.usage_animation_source_id
        self.usage_animation_source_id = None
        if source_id is not None:
            GLib.source_remove(source_id)
        self.usage_animation_angle = 0.0
        for provider_key in self.usage_refreshing_providers:
            logo = self.usage_logo_widgets.get(provider_key)
            if logo is not None:
                logo.angle = 0.0
                logo.queue_draw()

    def tick_usage_animation(self) -> bool:
        if not self.usage_refreshing or not self.usage_refreshing_providers:
            self.usage_animation_source_id = None
            return False
        self.usage_animation_angle = (
            self.usage_animation_angle + USAGE_ROTATION_RADIANS_PER_TICK
        ) % (2 * math.pi)
        for provider_key in self.usage_refreshing_providers:
            logo = self.usage_logo_widgets.get(provider_key)
            if logo is not None:
                logo.angle = self.usage_animation_angle
                logo.queue_draw()
        return True

    def set_waiting_style(self, enabled: bool) -> None:
        context = self.card.get_style_context()
        if enabled:
            context.add_class("waiting")
        else:
            context.remove_class("waiting")
            context.remove_class("waitingPulse")

    def tick_animation(self) -> bool:
        self.anim_frame += 1

        # trailing "..." for in-progress rows, cycling every ~400ms
        count = (self.anim_frame // 2) % 4
        for label in self.anim_dot_labels:
            color = getattr(label, "base_color", STATE_COLORS["neutral"])
            label.set_markup(self.markup("." * count, color))

        # expanding ring on waiting dots
        if self.waiting_dots:
            phase = (self.anim_frame % 8) / 8.0
            for dot in self.waiting_dots:
                dot.phase = phase
                dot.queue_draw()

        # red border pulse when waiting
        context = self.card.get_style_context()
        if context.has_class("waiting"):
            if self.anim_frame % 8 < 4:
                context.add_class("waitingPulse")
            else:
                context.remove_class("waitingPulse")

        # the same animations inside every session window
        for card in self.session_cards.values():
            for label in card.dot_labels:
                color = getattr(label, "base_color", STATE_COLORS["neutral"])
                label.set_markup(self.markup("." * count, color))
            if card.waiting_dots:
                phase = (self.anim_frame % 8) / 8.0
                for dot in card.waiting_dots:
                    dot.phase = phase
                    dot.queue_draw()
            card_context = card.card.get_style_context()
            if card_context.has_class("waiting"):
                if self.anim_frame % 8 < 4:
                    card_context.add_class("waitingPulse")
                else:
                    card_context.remove_class("waitingPulse")

        # rotating sweep on the lockup logo (startup intro + idle state)
        if self.spinning:
            angle = (self.anim_frame * 0.12) % (2 * math.pi)
            for logo in self.spinning:
                logo.angle = angle
                logo.queue_draw()

        # subtle LIVE badge pulse
        if "live" in self.badge.get_style_context().list_classes():
            alpha = "#4ADE80" if self.anim_frame % 8 < 4 else "#2f9c5a"
            self.badge.set_markup(self.markup("● LIVE", alpha))
        return True

    # ----------------------------- sound -----------------------------
    def play_notification_sound(self) -> None:
        if not NOTIFICATION_SOUND.exists():
            log(f"notification sound missing: {NOTIFICATION_SOUND}")
            return
        commands = [
            ("mpv", ["mpv", "--no-video", "--really-quiet", str(NOTIFICATION_SOUND)]),
            ("ffplay", ["ffplay", "-nodisp", "-autoexit", "-loglevel", "quiet", str(NOTIFICATION_SOUND)]),
            ("mpg123", ["mpg123", "-q", str(NOTIFICATION_SOUND)]),
            ("gst-play-1.0", ["gst-play-1.0", "-q", str(NOTIFICATION_SOUND)]),
            ("paplay", ["paplay", str(NOTIFICATION_SOUND)]),
        ]
        for binary, command in commands:
            if shutil.which(binary):
                try:
                    subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    log(f"notification sound played with {binary}")
                    return
                except OSError as error:
                    log(f"failed to play notification with {binary}: {error}")
        log("no supported audio player found for notification.mp3")

    # ----------------------------- window plumbing -----------------------------
    def on_button_press(self, _widget: Gtk.Widget, event: Gdk.EventButton) -> bool:
        if event.type == Gdk.EventType.BUTTON_PRESS and event.button == 1:
            self.begin_move_drag(event.button, int(event.x_root), int(event.y_root), event.time)
            return True
        if event.type == Gdk.EventType.BUTTON_PRESS and event.button == 3:
            self.show_menu(event)
            return True
        return False

    def on_key_press(self, _widget: Gtk.Widget, event: Gdk.EventKey) -> bool:
        if event.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter, Gdk.KEY_ISO_Enter, Gdk.KEY_Escape):
            return True
        return False

    def show_menu(self, event: Gdk.EventButton) -> None:
        menu = Gtk.Menu()
        reload_item = Gtk.MenuItem(label="Reload")
        logs_item = Gtk.MenuItem(label="Open logs folder")
        if self.update_available:
            update_item = Gtk.MenuItem(label=f"Update to {self.update_available}")
        else:
            update_item = Gtk.MenuItem(label="Check for updates")
        quit_item = Gtk.MenuItem(label="Quit")
        settings_item = Gtk.MenuItem(label="Settings…")
        settings_item.connect("activate", lambda _item: self.open_settings())
        agents_item = Gtk.MenuItem(label="Show agents")
        agents_item.set_submenu(self.build_agents_menu())
        dock_item = Gtk.MenuItem(label="Dock all session windows")
        dock_item.set_sensitive(any(card.floating for card in self.session_cards.values()))
        dock_item.connect("activate", lambda _item: self.dock_all_cards())
        klipy_item = Gtk.MenuItem(label="Get GIFs from KLIPY (free key)…")
        klipy_item.connect("activate", lambda _item: self.open_klipy_guide())
        serious_item = Gtk.CheckMenuItem(label="Serious mode (no stickers)")
        serious_item.set_active(self.serious_mode)
        serious_item.connect("toggled", lambda item: self.set_serious_mode(item.get_active()))
        reload_item.connect("activate", lambda _item: self.refresh_status())
        logs_item.connect("activate", lambda _item: self.open_logs_folder())
        if self.update_available:
            update_item.connect("activate", self.run_update)
        else:
            update_item.connect("activate", lambda _item: self.start_update_check())
        quit_item.connect("activate", self.quit)
        menu_items = [settings_item, agents_item, serious_item, dock_item]
        if not self.klipy_api_key:
            menu_items.append(klipy_item)
        for item in (*menu_items, reload_item, logs_item, update_item, quit_item):
            menu.append(item)
        menu.show_all()
        menu.popup_at_pointer(event)

    # ----------------------------- session windows -----------------------------
    def load_card_positions(self) -> dict[str, dict[str, float]]:
        try:
            loaded = json.loads(SESSION_WINDOWS_FILE.read_text(encoding="utf-8"))
        except (FileNotFoundError, OSError, json.JSONDecodeError):
            return {}
        if not isinstance(loaded, dict):
            return {}
        cutoff = time.time() - SESSION_WINDOW_POSITION_TTL_SECONDS
        positions: dict[str, dict[str, float]] = {}
        for session_id, value in loaded.items():
            if not isinstance(value, dict):
                continue
            x, y, saved = value.get("x"), value.get("y"), value.get("t", 0)
            if all(isinstance(item, (int, float)) and not isinstance(item, bool) for item in (x, y, saved)) and saved >= cutoff:
                positions[str(session_id)] = {"x": int(x), "y": int(y), "t": float(saved)}
        return positions

    def write_card_positions(self) -> None:
        cutoff = time.time() - SESSION_WINDOW_POSITION_TTL_SECONDS
        self.card_positions = {key: value for key, value in self.card_positions.items() if value["t"] >= cutoff}
        try:
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            SESSION_WINDOWS_FILE.write_text(json.dumps(self.card_positions, indent=2) + "\n", encoding="utf-8")
        except OSError as error:
            log(f"failed to save session window positions: {error}")

    def save_card_position(self, session_id: str, x: int, y: int) -> None:
        self.card_positions[session_id] = {"x": int(x), "y": int(y), "t": time.time()}
        self.write_card_positions()

    def sync_session_cards(self, sessions: list[dict[str, object]]) -> None:
        """One window per visible session: create new ones, update, close finished ones."""
        wanted = {str(session["id"]) for session in sessions}
        for session_id in [key for key in self.session_cards if key not in wanted]:
            self.session_cards.pop(session_id).close()
            self.card_order.remove(session_id)
        for session in sessions:
            session_id = str(session["id"])
            card = self.session_cards.get(session_id)
            if card is None:
                card = SessionCard(self, session_id)
                self.session_cards[session_id] = card
                self.card_order.append(session_id)
                card.update(session)
                saved = self.card_positions.get(session_id)
                if saved is not None:
                    card.floating = True
                    card.move(*self.clamp_to_visible(int(saved["x"]), int(saved["y"])))
                card.show_all()
            else:
                card.update(session)
        self.layout_cards()

    def layout_cards(self) -> None:
        """Stack docked session windows under the widget, oldest first (stable order)."""
        if not self.session_cards:
            return
        x, y = self.get_position()
        _width, height = self.get_size()
        # Window y + height - 8 px margin is the card's bottom edge; each session window
        # also has an 8 px margin, so its window top is (visual top - 8).
        next_y = y + height - 16 + SESSION_CARD_GAP
        for session_id in self.card_order:
            card = self.session_cards[session_id]
            if card.floating:
                continue
            card.dock_at(x, next_y)
            _card_width, card_height = card.get_size()
            next_y += card_height - 16 + SESSION_CARD_GAP

    def layout_cards_once(self) -> bool:
        self.layout_cards()
        return False

    def dock_card(self, session_id: str) -> None:
        card = self.session_cards.get(session_id)
        if card is not None:
            card.floating = False
        if self.card_positions.pop(session_id, None) is not None:
            self.write_card_positions()
        self.layout_cards()

    def dock_all_cards(self) -> None:
        for card in self.session_cards.values():
            card.floating = False
        if self.card_positions:
            self.card_positions = {}
            self.write_card_positions()
        self.layout_cards()

    def close_session_cards(self) -> None:
        for card in self.session_cards.values():
            card.close()
        self.session_cards = {}
        self.card_order = []

    # ----------------------------- GIF stickers -----------------------------
    def build_sticker_source(self) -> stickers.StickerSource:
        bubbles, queries = stickers.load_sticker_texts(STICKER_TEXTS_FILE)
        klipy = None
        if self.klipy_api_key:
            klipy = stickers.KlipyClient(
                self.klipy_api_key,
                stickers.load_customer_id(KLIPY_CUSTOMER_ID_FILE),
            )
        source = stickers.StickerSource(GIFS_DIR, bubbles, queries, klipy, log=log)
        source.activity_templates = stickers.load_activity_templates(STICKER_TEXTS_FILE)
        return source

    def update_stickers(self, sessions: list[dict[str, object]]) -> None:
        """Pop a sticker for the session whose sticker status changed (waiting rows first)."""
        current: dict[str, str] = {}
        activities: dict[str, object] = {}
        for session in sessions:
            key = stickers.sticker_for_kind(session["kind"])
            if key is not None:
                current[str(session["id"])] = key
                activities[str(session["id"])] = session.get("activity")
        changed = [session_id for session_id, key in current.items() if self.sticker_kinds.get(session_id) != key]
        self.sticker_kinds = current
        if not self.sticker_primed:
            # Do not greet every already-running session with a sticker on startup.
            self.sticker_primed = True
            return
        overlay = self.sticker_overlay
        owner = self.sticker_owner
        if (
            overlay is not None and overlay.visible and overlay.sticky and owner is not None
            and overlay.choice is not None and current.get(owner) != overlay.choice.key
        ):
            overlay.tuck()
            self.sticker_owner = None
        if changed:
            activity = activities.get(changed[0])
            self.request_sticker(current[changed[0]], changed[0],
                                 activity=activity if isinstance(activity, dict) else None)

    def note_usage_limits(self, snapshot: object, *, trigger: bool) -> None:
        providers = snapshot.get("providers") if isinstance(snapshot, dict) else None
        if not isinstance(providers, dict):
            return
        for provider, limits in providers.items():
            if provider not in self.agents or not isinstance(limits, list):
                continue
            for limit in limits:
                if not isinstance(limit, dict):
                    continue
                used = limit.get("used_percent")
                if not isinstance(used, (int, float)) or used < stickers.LIMIT_THRESHOLD_PERCENT:
                    continue
                token = (str(provider), str(limit.get("window")), str(limit.get("resets_at")))
                if token in self.limits_seen:
                    continue
                self.limits_seen.add(token)
                if trigger:
                    self.request_sticker("limit", f"limit:{provider}")

    def request_sticker(
        self,
        key: str,
        session_id: str,
        *,
        sticky: bool | None = None,
        debounce_ms: int = STICKER_DEBOUNCE_MS,
        activity: dict[str, str] | None = None,
    ) -> None:
        """Debounced: rapid status changes collapse into one sticker for the latest change."""
        if self.serious_mode or self.sticker_overlay is None:
            return
        if self.sticker_debounce is not None:
            GLib.source_remove(self.sticker_debounce)
        self.sticker_request += 1
        request = self.sticker_request
        is_sticky = key in stickers.STICKY_KEYS if sticky is None else sticky

        def pick_in_background() -> bool:
            self.sticker_debounce = None
            source = self.sticker_source

            def worker() -> None:
                try:
                    choice = source.pick(key, activity, topic=stickers.sticker_topic(key, activity))
                except Exception as error:  # never let a sticker take the widget down
                    log(f"sticker: pick failed: {error}")
                    choice = stickers.StickerChoice(key, None, "", "placeholder")
                GLib.idle_add(self.show_sticker, request, session_id, choice, is_sticky)

            threading.Thread(target=worker, daemon=True).start()
            return False

        self.sticker_debounce = GLib.timeout_add(max(1, debounce_ms), pick_in_background)

    def show_sticker(self, request: int, session_id: str, choice: stickers.StickerChoice, sticky: bool) -> bool:
        overlay = self.sticker_overlay
        if overlay is None or request != self.sticker_request or self.serious_mode:
            return False
        self.last_stickers[session_id] = choice
        self.sticker_owner = session_id
        log(f"sticker: {choice.key} from {choice.source} ({choice.label})")
        self.sticker_hovered = None
        self.position_sticker_overlay()
        overlay.present_sticker(choice, sticky)
        return False

    def position_sticker_overlay(self) -> None:
        if self.sticker_overlay is None:
            return
        x, y = self.get_position()
        width, _height = self.get_size()
        # The card sits inside an 8 px transparent margin of the widget window.
        self.sticker_overlay.place_for_card(x + width - 8, y + 8)

    def on_row_enter(self, _widget: Gtk.Widget, event: Gdk.EventCrossing, session_id: str) -> bool:
        overlay = self.sticker_overlay
        if overlay is None or self.serious_mode or event.detail == Gdk.NotifyType.INFERIOR:
            return False
        choice = self.last_stickers.get(session_id)
        if choice is None:
            return False
        if overlay.phase in ("in", "shown") and self.sticker_owner == session_id:
            self.sticker_hovered = session_id  # already showing this row's sticker: keep it
            return False
        self.sticker_hovered = session_id
        self.sticker_owner = session_id
        self.position_sticker_overlay()
        overlay.present_sticker(choice, sticky=False, hold_ms=None)
        return False

    def on_row_leave(self, widget: Gtk.Widget, event: Gdk.EventCrossing, session_id: str) -> bool:
        if event.detail == Gdk.NotifyType.INFERIOR:
            return False
        if self.sticker_hovered != session_id:
            return False
        if self.pointer_inside(widget):
            return False  # a spurious crossing (e.g. a window mapped above): still hovering
        self.sticker_hovered = None
        if self.sticker_overlay is not None:
            self.sticker_overlay.tuck()
        return False

    def pointer_inside(self, widget: Gtk.Widget) -> bool:
        window = self.get_window()
        display = self.get_display()
        seat = display.get_default_seat() if display is not None else None
        pointer = seat.get_pointer() if seat is not None else None
        if window is None or pointer is None or not widget.get_mapped():
            return False
        _window, x, y, _mask = window.get_device_position(pointer)
        origin = widget.translate_coordinates(self, 0, 0)
        if origin is None:
            return False
        allocation = widget.get_allocation()
        left, top = origin
        return left <= x < left + allocation.width and top <= y < top + allocation.height

    def verify_hover(self) -> bool:
        session_id = self.sticker_hovered
        if session_id is None:
            return False
        box = self.row_hover_boxes.get(session_id)
        if box is None or not self.pointer_inside(box):
            self.sticker_hovered = None
            if self.sticker_overlay is not None:
                self.sticker_overlay.tuck()
        return False

    def show_test_sticker(self, key: str | None = None) -> None:
        """Debug / Settings helper: show one sticker now, cycling through every status."""
        if key is None:
            key = stickers.STICKER_KEYS[self.test_sticker_index % len(stickers.STICKER_KEYS)]
            self.test_sticker_index += 1
        self.request_sticker(key, f"test:{key}", sticky=False, debounce_ms=1)

    def set_serious_mode(self, enabled: bool) -> None:
        self.update_setting("AI_STATUS_SERIOUS_MODE", "true" if enabled else "false")
        window = self.settings_window
        if window is not None and window.serious_switch.get_active() != enabled:
            window.serious_switch.set_active(enabled)

    def open_klipy_guide(self, parent: Gtk.Window | None = None) -> None:
        if self.klipy_guide is None:
            self.klipy_guide = KlipyKeyGuide(self, parent or self.settings_window)
            self.klipy_guide.connect("destroy", lambda _window: setattr(self, "klipy_guide", None))
            self.klipy_guide.show_all()
        self.klipy_guide.present()

    def open_settings(self) -> None:
        if self.settings_window is None:
            self.settings_window = SettingsWindow(self)
            self.settings_window.connect("destroy", self.on_settings_closed)
            self.settings_window.show_all()
            self.place_beside(self.settings_window)
        self.settings_window.present()

    def place_beside(self, window: Gtk.Window, gap: int = 12) -> None:
        """Open a dialog next to the widget (right if it fits, else left) so changes stay visible."""
        x, y = self.get_position()
        width, _height = self.get_size()
        dialog_width, dialog_height = window.get_size()
        monitor = self.get_display().get_monitor_at_point(x, y) if self.get_display() else None
        if monitor is None:
            return
        area = monitor.get_workarea()
        target_x = x + width + gap
        if target_x + dialog_width > area.x + area.width:
            target_x = x - dialog_width - gap
        target_x = max(area.x, min(target_x, area.x + area.width - dialog_width))
        target_y = max(area.y, min(y, area.y + area.height - dialog_height))
        window.move(target_x, target_y)

    def on_settings_closed(self, _window: Gtk.Window) -> None:
        self.settings_window = None

    def sync_settings_window(self) -> None:
        """Keep the open Settings window in step when agents change from the menu."""
        window = self.settings_window
        if window is None:
            return
        for agent, check in window.agent_checks.items():
            if check.get_active() != (agent in self.agents):
                check.set_active(agent in self.agents)

    def update_setting(self, key: str, value: str) -> None:
        """Apply one setting to the running widget and save it to the runtime .env."""
        if key == "AI_STATUS_SOUND_ENABLED":
            self.config["sound_enabled"] = value == "true"
        elif key == "AI_STATUS_SERIOUS_MODE":
            self.serious_mode = value == "true"
            if self.serious_mode:
                if self.sticker_debounce is not None:
                    GLib.source_remove(self.sticker_debounce)
                    self.sticker_debounce = None
                self.sticker_request += 1
                if self.sticker_overlay is not None:
                    self.sticker_overlay.hide_now()
            for card in self.session_cards.values():
                if self.serious_mode:
                    card.clear_sticker()
                else:
                    card.refresh_sticker()
        elif key == "AI_STATUS_STICKER_ROTATE_SECONDS":
            self.sticker_rotate_seconds = max(0, int(value))
            for card in self.session_cards.values():
                if card.sticker_key is not None:
                    card.schedule_rotation()  # restarts (or stops, for 0) the timer
        elif key == "AI_STATUS_SESSION_WINDOWS":
            self.session_windows = value == "true"
            if not self.session_windows:
                self.close_session_cards()
        elif key == "AI_STATUS_KLIPY_API_KEY":
            self.klipy_api_key = value
            self.sticker_source = self.build_sticker_source()
        elif key == "AI_STATUS_MAX_ROWS":
            self.max_rows = max(1, int(value))
        else:
            for env_key, config_key, _label, _hint in TIMING_SETTINGS:
                if env_key == key:
                    self.config[config_key] = max(0, int(value))
        shown = "(hidden)" if key == "AI_STATUS_KLIPY_API_KEY" and value else value
        log(f"setting {key}={shown}")
        try:
            write_env_value(SETTINGS.env_file, key, value)
        except OSError as error:
            log(f"failed to save {key} to {SETTINGS.env_file}: {error}")
        if key in os.environ:
            log(f"{key} is set in the environment and will override the saved value on restart")
        self.signature = None
        if not self.intro:
            self.refresh_status()

    def build_agents_menu(self) -> Gtk.Menu:
        submenu = Gtk.Menu()
        group: Gtk.RadioMenuItem | None = None
        for label, agents in AGENT_FILTER_CHOICES:
            item = Gtk.RadioMenuItem.new_with_label_from_widget(group, label)
            group = group or item
            item.set_active(agents == self.agents)
            item.connect("toggled", lambda menu_item, choice=agents: menu_item.get_active() and self.set_agents(choice))
            submenu.append(item)
        return submenu

    def set_agents(self, agents: tuple[str, ...]) -> None:
        if agents == self.agents:
            return
        newly_shown = set(agents) - set(self.agents)
        self.agents = agents
        self.update_setting("AI_STATUS_AGENTS", format_agents(agents))
        self.render_usage_limits()
        self.sync_settings_window()
        missing = [
            agent for agent in newly_shown
            if not self.usage_snapshot.get("providers", {}).get(agent)
        ]
        if missing and not self.demo:
            self.start_usage_refresh(missing[0] if len(missing) == 1 else None)

    def start_update_check(self) -> bool:
        """Kick off a one-shot background version check against GitHub.

        Runs in a daemon thread so the (networked, possibly slow) request never
        blocks the GTK main loop; the result is delivered back via idle_add.
        """
        def worker() -> None:
            version = updates.check_for_update()
            if version:
                GLib.idle_add(self.on_update_result, version)

        threading.Thread(target=worker, daemon=True).start()
        return False  # one-shot timeout

    def on_update_result(self, version: str) -> bool:
        self.update_available = version
        self.update_button.set_label(f"update {version} ↑")
        self.update_button.set_visible(True)
        log(f"update available: {version}")
        return False

    def run_update(self, *_args) -> None:
        if self.updating:
            return
        if not UPDATE_SCRIPT.exists():
            log(f"update script not found: {UPDATE_SCRIPT}")
            return
        self.updating = True
        self.update_button.set_label("updating…")
        self.update_button.set_sensitive(False)
        log("starting self-update")
        try:
            # Detach into its own session so the updater (which stops and restarts
            # this widget via install.sh) outlives the process it is replacing.
            with open(LOG_FILE, "a", encoding="utf-8") as logfile:
                subprocess.Popen(
                    [str(UPDATE_SCRIPT)],
                    stdout=logfile,
                    stderr=logfile,
                    start_new_session=True,
                )
        except OSError as error:
            self.updating = False
            self.update_button.set_sensitive(True)
            log(f"failed to start update: {error}")

    def open_logs_folder(self) -> None:
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        opener = shutil.which("xdg-open")
        if opener:
            subprocess.Popen([opener, str(CACHE_DIR)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            log("xdg-open is not available")

    def monitor_workareas(self) -> list[Gdk.Rectangle]:
        """Work areas of the connected monitors, in virtual-screen coordinates."""
        display = self.get_display()
        if display is None:
            return []
        areas = []
        for index in range(display.get_n_monitors()):
            monitor = display.get_monitor(index)
            if monitor is not None:
                areas.append(monitor.get_workarea())
        return areas

    def clamp_to_visible(self, x: int, y: int) -> tuple[int, int]:
        """Pull a saved position back onto a monitor that still exists.

        X11 packs every monitor into a single virtual screen, so a layout that is not
        one plain rectangle leaves dead zones: coordinates the server accepts but no
        physical panel ever draws. A position saved under an earlier monitor
        arrangement can end up in such a zone, which leaves the widget running and
        mapped yet completely invisible. Fall back to the nearest monitor instead.
        """
        areas = self.monitor_workareas()
        if not areas:
            return x, y
        for area in areas:
            if area.x <= x < area.x + area.width and area.y <= y < area.y + area.height:
                return x, y

        def squared_distance(area: Gdk.Rectangle) -> int:
            dx = max(area.x - x, 0, x - (area.x + area.width - 1))
            dy = max(area.y - y, 0, y - (area.y + area.height - 1))
            return dx * dx + dy * dy

        target = min(areas, key=squared_distance)
        max_x = max(target.x, target.x + target.width - CARD_WIDTH - OFFSCREEN_MARGIN)
        max_y = max(target.y, target.y + target.height - MIN_VISIBLE_HEIGHT)
        clamped_x = min(max(x, target.x + OFFSCREEN_MARGIN), max_x)
        clamped_y = min(max(y, target.y + OFFSCREEN_MARGIN), max_y)
        log(f"saved position {x},{y} is off-screen, moved to {clamped_x},{clamped_y}")
        return clamped_x, clamped_y

    def restore_position(self) -> None:
        try:
            data = json.loads(WIDGET_CONFIG.read_text(encoding="utf-8"))
            x = int(data.get("x", 40))
            y = int(data.get("y", 80))
        except Exception:
            x, y = 40, 80
        self.move(*self.clamp_to_visible(x, y))

    def save_position(self) -> None:
        try:
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            x, y = self.get_position()
            self.write_config({"x": x, "y": y})
        except OSError as error:
            log(f"failed to save position: {error}")

    def on_configure(self, _widget: Gtk.Widget, _event: Gdk.EventConfigure) -> bool:
        self.save_position()
        if self.sticker_overlay is not None and self.sticker_overlay.visible:
            self.position_sticker_overlay()
        self.layout_cards()
        return False

    def on_delete(self, *_args: object) -> bool:
        self.save_position()
        self.close_session_cards()
        Gtk.main_quit()
        return True

    def quit(self, *_args: object) -> None:
        self.save_position()
        if self.sticker_overlay is not None:
            self.sticker_overlay.hide_now()
        self.close_session_cards()
        Gtk.main_quit()

    def switch_to_session(self, project: str, cwd: str, client_pids: list[int]) -> None:
        """Raise the terminal window of a session.

        PID match narrows to the windows owned by this session's process tree. When one
        emulator process owns several windows (e.g. gnome-terminal), the window title is
        used to disambiguate. Falls back to a title-only match when no PID matches.
        """
        wmctrl = shutil.which("wmctrl")
        if not wmctrl:
            log("switch_to_session: wmctrl is not available")
            return
        windows = self.list_windows(wmctrl)
        if not windows:
            log("switch_to_session: no windows reported by wmctrl -lp")
            return

        target = (project or (Path(cwd).name if cwd else "")).lower()
        pidset = set(client_pids)
        candidates = [w for w in windows if w["pid"] in pidset]

        chosen = None
        if len(candidates) == 1:
            chosen = candidates[0]
        elif len(candidates) > 1:
            titled = [w for w in candidates if target and target in str(w["title"]).lower()]
            if titled:
                chosen = titled[0]
            else:
                chosen = candidates[0]
                log(f"switch_to_session: {len(candidates)} windows share the emulator PID and none "
                    f"match title '{target}'; raising first (one-process-per-window terminal needed "
                    f"for exact targeting)")
        if chosen is None and target:
            titled = [w for w in windows if target in str(w["title"]).lower()]
            if titled:
                chosen = titled[0]

        if chosen is None:
            log(f"switch_to_session: no window matched pids {client_pids} or title '{target}'")
            return
        self.activate_window(wmctrl, str(chosen["id"]))

    def list_windows(self, wmctrl: str) -> list[dict[str, object]]:
        """Parse `wmctrl -lp` into [{id, pid, title}]."""
        try:
            listing = subprocess.run(
                [wmctrl, "-lp"],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                check=False,
            ).stdout
        except OSError as error:
            log(f"wmctrl -lp failed: {error}")
            return []
        windows: list[dict[str, object]] = []
        for line in listing.splitlines():
            parts = line.split(None, 4)  # winid, desktop, pid, host, title
            if len(parts) < 4:
                continue
            try:
                pid = int(parts[2])
            except ValueError:
                continue
            windows.append({"id": parts[0], "pid": pid, "title": parts[4] if len(parts) >= 5 else ""})
        return windows

    def activate_window(self, wmctrl: str, window_id: str) -> None:
        try:
            subprocess.run(
                [wmctrl, "-i", "-a", window_id],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
        except OSError as error:
            log(f"wmctrl activate {window_id} failed: {error}")

    def own_window_id(self) -> str | None:
        """This widget's X11 window id as wmctrl expects it (hex), or None off X11."""
        return window_id_of(self)

    def apply_wmctrl_hints(self) -> bool:
        # GTK-level hints first; cheap no-ops when the state already holds.
        self.stick()
        self.set_keep_above(True)
        wmctrl = shutil.which("wmctrl")
        if not wmctrl:
            return False  # nothing to reinforce (e.g. pure Wayland); stop the timer
        # Target our own window by id. Matching by title (`wmctrl -r TITLE`) hits the first
        # window whose title merely *contains* it, e.g. a terminal whose title mentions
        # "AI Agents Status", which then becomes sticky instead of the widget.
        window_id = self.own_window_id()
        targets = [["-i", "-r", window_id] if window_id else ["-r", TITLE]]
        for card in self.session_cards.values():
            card.stick()
            card.set_keep_above(True)
            card_id = window_id_of(card)
            if card_id:
                targets.append(["-i", "-r", card_id])
        for target in targets:
            try:
                subprocess.run(
                    [wmctrl, *target, "-b", "add,above,sticky,skip_taskbar"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    check=False,
                )
            except OSError as error:
                log(f"wmctrl failed: {error}")
                return False
        return True  # repeat: re-assert above/sticky/skip_taskbar as Mutter drops them


def window_id_of(widget: Gtk.Window) -> str | None:
    """A window's X11 id as wmctrl expects it (hex), or None off X11 / before realize."""
    window = widget.get_window()
    get_xid = getattr(window, "get_xid", None)
    if get_xid is None:
        return None
    try:
        return hex(get_xid())
    except Exception:
        return None


def main() -> int:
    parser = argparse.ArgumentParser(description="Floating GTK widget for ai-cli-status-monitor.")
    parser.add_argument("--demo", action="store_true", help="cycle through demo states")
    parser.add_argument("--version", action="store_true", help="print the installed version and exit")
    parser.add_argument(
        "--sticker",
        choices=(*stickers.STICKER_KEYS, "all"),
        help="debug: show this GIF sticker after the intro ('all' cycles through every status)",
    )
    args = parser.parse_args()

    if args.version:
        print(updates.installed_version())
        return 0

    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    if LEGACY_STICKER_CACHE_DIR.is_dir():
        shutil.rmtree(LEGACY_STICKER_CACHE_DIR, ignore_errors=True)
        log("removed the old on-disk KLIPY GIF cache (KLIPY media is now loaded directly)")
    for warning in CONFIG_WARNINGS:
        log(f"configuration: {warning}")
    PID_FILE.write_text(f"{os.getpid()}\n", encoding="utf-8")
    widget = StatusWidget(demo=args.demo)
    widget.show_all()
    if args.sticker:
        def show_debug_sticker() -> bool:
            if args.sticker == "all":
                widget.show_test_sticker()
                return True  # keep cycling, one status every 5 s
            widget.show_test_sticker(args.sticker)
            return False

        def start_debug_stickers() -> bool:
            if show_debug_sticker():
                GLib.timeout_add(5000, show_debug_sticker)
            return False

        GLib.timeout_add(3500, start_debug_stickers)
    log("widget started" + (" in demo mode" if args.demo else ""))
    Gtk.main()
    log("widget stopped")
    try:
        PID_FILE.unlink()
    except OSError:
        pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
