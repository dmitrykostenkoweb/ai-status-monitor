#!/usr/bin/env python3
from __future__ import annotations

import json
import shutil
import subprocess
import sys
from datetime import datetime, timedelta
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from ai_agent_status_lib import platform_support  # noqa: E402
from ai_agent_status_lib import process_control  # noqa: E402
from ai_agent_status_lib import updates  # noqa: E402
from ai_agent_status_lib.env_config import format_agents  # noqa: E402
from ai_agent_status_lib.env_config import load_settings  # noqa: E402

CONFIG_WARNINGS: list[str] = []
SETTINGS = load_settings(diagnostic=CONFIG_WARNINGS.append)
PLATFORM = platform_support.PLATFORM
HOME = platform_support.home_dir()
BIN = platform_support.default_bin_dir(HOME)
CACHE_DIR = SETTINGS.cache_dir
CLAUDE_SETTINGS = HOME / ".claude" / "settings.json"
CODEX_HOOKS = HOME / ".codex" / "hooks.json"
CODEX_STATUS = CACHE_DIR / "codex.json"
STATUS_DIR = CACHE_DIR / "statuses"
HOOK_CLAUDE = process_control.hook_command(BIN, "claude")
HOOK_CODEX = process_control.hook_command(BIN, "codex")
STALE_AFTER = timedelta(seconds=SETTINGS.stale_after_seconds)


def ok(label: str) -> None:
    print(f"✅ {label}")


def warn(label: str) -> None:
    print(f"⚠️ {label}")


def has_hook(path: Path, command: str, events: tuple[str, ...]) -> bool:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return False
    hooks = data.get("hooks") if isinstance(data, dict) else None
    if not isinstance(hooks, dict):
        return False
    for event in events:
        groups = hooks.get(event)
        if not isinstance(groups, list):
            return False
        found = False
        for group in groups:
            if not isinstance(group, dict):
                continue
            handlers = group.get("hooks")
            if not isinstance(handlers, list):
                continue
            if any(isinstance(handler, dict) and handler.get("command") == command for handler in handlers):
                found = True
                break
        if not found:
            return False
    return True


def widget_toolkit() -> tuple[bool, str]:
    """Whether the recorded widget interpreter can import PySide6 (Qt)."""
    python = process_control.widget_interpreter(SETTINGS.data_dir)
    try:
        result = subprocess.run(
            [python, "-c", "import PySide6.QtWidgets, PySide6; print(PySide6.__version__)"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=60,
            check=False,
            **platform_support.hidden_window_flags(),
        )
    except (OSError, subprocess.SubprocessError):
        return False, python
    if result.returncode != 0:
        return False, python
    return True, f"{result.stdout.strip()} ({python})"


def test_mode_writes_status() -> bool:
    hook = BIN / "ai-agent-status-hook"
    if not hook.exists():
        return False
    result = subprocess.run(
        process_control.script_argv(hook, "--agent", "codex", "--test"),
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        **platform_support.hidden_window_flags(),
    )
    return result.returncode == 0 and (CACHE_DIR / "combined.txt").exists()


def autostart_installed() -> tuple[bool, str]:
    if PLATFORM == platform_support.WINDOWS:
        try:
            import winreg

            with winreg.OpenKey(winreg.HKEY_CURRENT_USER, r"Software\Microsoft\Windows\CurrentVersion\Run") as key:
                winreg.QueryValueEx(key, "ai-cli-status-monitor")
            return True, "Autostart installed (HKCU Run key)"
        except OSError:
            return False, "Autostart Run key missing"
    if PLATFORM == platform_support.MACOS:
        plist = HOME / "Library" / "LaunchAgents" / "com.github.ai-cli-status-monitor.widget.plist"
        return plist.exists(), "Autostart installed (LaunchAgent)" if plist.exists() else "Autostart LaunchAgent missing"
    desktop = HOME / ".config" / "autostart" / "ai-cli-status-widget.desktop"
    return desktop.exists(), "Autostart installed" if desktop.exists() else "Autostart desktop file missing"


def status_age(path: Path) -> timedelta | None:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        timestamp_iso = data.get("timestamp_iso") if isinstance(data, dict) else None
        if not isinstance(timestamp_iso, str):
            return None
        return datetime.now() - datetime.fromisoformat(timestamp_iso)
    except Exception:
        return None


def latest_status_age(agent: str) -> timedelta | None:
    candidates = list(STATUS_DIR.glob(f"{agent}-*.json")) if STATUS_DIR.exists() else []
    candidates.append(CACHE_DIR / f"{agent}.json")
    ages = [age for age in (status_age(path) for path in candidates) if age is not None]
    return min(ages) if ages else None


def main() -> int:
    if SETTINGS.env_file.exists():
        ok(f"Environment config: {SETTINGS.env_file}")
    else:
        warn(f"Environment config missing, using legacy/defaults: {SETTINGS.env_file}")
    ok(f"Resolved cache dir: {CACHE_DIR}")
    ok(f"Resolved config dir: {SETTINGS.config_dir}")
    ok(f"Resolved data dir: {SETTINGS.data_dir}")
    ok(f"Shown agents: {format_agents(SETTINGS.agents)}")
    for message in CONFIG_WARNINGS:
        warn(f"Configuration: {message}")

    if (BIN / "ai-agent-status-hook").exists():
        ok("Hook script installed")
    else:
        warn("Hook script missing")

    if (BIN / "ai-agent-status-widget").exists():
        ok("Widget script installed")
    else:
        warn("Widget script missing")

    if PLATFORM == platform_support.WINDOWS:
        pass  # no executable bit; the .cmd shims and hooks call the interpreter explicitly
    elif (BIN / "ai-agent-status-widget").is_file() and (BIN / "ai-agent-status-widget").stat().st_mode & 0o111:
        ok("Widget executable")
    else:
        warn("Widget is not executable")

    ok(f"Installed version: {updates.installed_version()}")
    if (BIN / "ai-agent-status-update").exists():
        ok("Update script installed")
        newer = updates.check_for_update()
        if newer:
            warn(f"Update available: {newer} (run ai-agent-status-update)")
        else:
            ok("Up to date (or update check unavailable)")
    else:
        warn("Update script missing")

    if CACHE_DIR.exists():
        ok("Cache dir exists")
    else:
        warn("Cache dir missing")

    installed, label = autostart_installed()
    (ok if installed else warn)(label)

    claude_events = ("UserPromptSubmit", "PreToolUse", "PostToolUse", "Notification", "Stop", "StopFailure")
    if CLAUDE_SETTINGS.exists() and has_hook(CLAUDE_SETTINGS, HOOK_CLAUDE, claude_events):
        ok("Claude hooks installed")
    elif CLAUDE_SETTINGS.exists():
        warn("Claude settings found, but monitor hooks are incomplete")
    else:
        warn("Claude settings file not found")

    codex_events = ("UserPromptSubmit", "PreToolUse", "PermissionRequest", "PostToolUse", "SubagentStop", "Stop")
    if CODEX_HOOKS.exists() and has_hook(CODEX_HOOKS, HOOK_CODEX, codex_events):
        ok("Codex hooks installed")
    elif CODEX_HOOKS.exists():
        warn("Codex hooks file found, but monitor hooks are incomplete")
    else:
        warn("Codex hooks file not found")

    if PLATFORM == platform_support.LINUX:
        missing = platform_support.missing_linux_qt_packages()
        if missing:
            warn(f"Qt X11 libraries missing: sudo apt install {' '.join(missing)}")
        if shutil.which("wmctrl"):
            ok("wmctrl available")
        else:
            warn("wmctrl missing (always-on-top on every workspace and the → window switch need it)")

    available, detail = widget_toolkit()
    if available:
        ok(f"PySide6 available: {detail}")
    else:
        warn(f"PySide6 missing for {detail}: re-run the installer (it sets up a private venv)")
        if PLATFORM == platform_support.LINUX:
            warn("Linux packages the installer and Qt need: sudo apt install python3-venv libxcb-cursor0 wmctrl")

    age = latest_status_age("codex")
    if age is None:
        warn("Codex live status timestamp unavailable")
    elif age > STALE_AFTER:
        warn("Codex live status is stale: open /hooks in Codex and trust hooks, then restart Codex if needed")
    else:
        ok("Codex live status is fresh")

    if test_mode_writes_status():
        ok("Test mode writes status")
    else:
        warn("Test mode failed")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
