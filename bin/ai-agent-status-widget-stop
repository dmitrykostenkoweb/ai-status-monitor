#!/usr/bin/env python3
"""Stop the background widget started by ai-agent-status-widget-start."""
from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from ai_agent_status_lib.env_config import load_settings  # noqa: E402
from ai_agent_status_lib.process_control import stop_widget  # noqa: E402


def main() -> int:
    _stopped, message = stop_widget(load_settings().cache_dir)
    print(message)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
