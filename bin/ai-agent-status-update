#!/usr/bin/env python3
"""Self-update: pull the latest source from GitHub and re-run the installer.

The installer records where it ran from in "<data dir>/install_source". We pull that
clone when it is a git repo; otherwise we fall back to a managed clone in
"<data dir>/src" (cloning it fresh the first time). install.py is idempotent and
restarts the widget at the end, so a single command fully refreshes the install.
"""
from __future__ import annotations

import argparse
import shutil
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from ai_agent_status_lib import updates  # noqa: E402
from ai_agent_status_lib.env_config import load_settings  # noqa: E402


def is_git_repo(path: Path) -> bool:
    if not (path / ".git").exists():
        return False
    result = subprocess.run(
        ["git", "-C", str(path), "rev-parse", "--git-dir"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False,
    )
    return result.returncode == 0


def git(*args: str) -> None:
    subprocess.run(["git", *args], check=True)


def main() -> int:
    parser = argparse.ArgumentParser(description="Update ai-cli-status-monitor from GitHub.")
    parser.add_argument("--check", action="store_true", help="only report whether an update is available")
    args = parser.parse_args()

    if args.check:
        local = updates.installed_version()
        remote = updates.check_for_update()
        print(f"Update available: {local} -> {remote}" if remote else f"Up to date (version {local}).")
        return 0

    if shutil.which("git") is None:
        print("git is required to update. Install git and try again.", file=sys.stderr)
        return 1

    data_dir = load_settings().data_dir
    managed_src = data_dir / "src"
    branch = updates.repo_branch()
    repo_url = f"https://github.com/{updates.repo_slug()}.git"

    src: Path | None = None
    try:
        candidate = Path((data_dir / "install_source").read_text(encoding="utf-8").strip())
        if candidate.parts and is_git_repo(candidate):
            src = candidate
    except OSError:
        pass
    if src is None and is_git_repo(managed_src):
        src = managed_src

    try:
        if src is None:
            print(f"No local source clone found; cloning {repo_url} ...")
            shutil.rmtree(managed_src, ignore_errors=True)
            managed_src.parent.mkdir(parents=True, exist_ok=True)
            git("clone", "--branch", branch, "--depth", "1", repo_url, str(managed_src))
            src = managed_src
        else:
            print(f"Updating source in {src} ...")
            git("-C", str(src), "fetch", "--depth", "1", "origin", branch)
            git("-C", str(src), "checkout", branch)
            git("-C", str(src), "reset", "--hard", f"origin/{branch}")
    except subprocess.CalledProcessError as error:
        print(f"git failed: {error}", file=sys.stderr)
        return 1

    print(f"Running installer from {src} ...")
    return subprocess.run([sys.executable, str(src / "install.py")], check=False).returncode


if __name__ == "__main__":
    raise SystemExit(main())
